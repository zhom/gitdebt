---
type JsonLd = Record<string, unknown>;
type CanonicalValue = string | URL;

interface Props {
  title: string;
  description: string;
  canonicalPath: CanonicalValue;
  ogImage: CanonicalValue;
  ogType?: "website" | "article";
  noindex?: boolean;
  robots?: string;
  imageAlt?: string;
  imageType?: "image/png";
  imageWidth?: number;
  imageHeight?: number;
  jsonLd?: JsonLd | JsonLd[];
}

const {
  title,
  description,
  canonicalPath,
  ogImage,
  ogType = "website",
  noindex = false,
  robots: robotsOverride,
  imageAlt,
  imageType = "image/png",
  imageWidth = 1200,
  imageHeight = 630,
  jsonLd,
} = Astro.props;

const site = Astro.site ?? new URL("https://gitdebt.com");

function httpUrl(value: CanonicalValue, base: URL, label: string): URL {
  const url = new URL(value.toString(), base);
  if (url.protocol !== "http:" && url.protocol !== "https:") {
    throw new Error(`${label} must use http or https`);
  }
  return url;
}

const canonicalUrl = httpUrl(canonicalPath, site, "canonicalPath");
if (canonicalUrl.origin !== site.origin) {
  throw new Error("canonicalPath must use the configured site origin");
}
if (canonicalUrl.hash) {
  throw new Error("canonicalPath cannot contain a fragment");
}
if (canonicalUrl.pathname !== "/" && canonicalUrl.pathname.endsWith("/")) {
  throw new Error("canonicalPath must not have a trailing slash");
}

const socialImageUrl = httpUrl(ogImage, site, "ogImage");
if (!Number.isInteger(imageWidth) || imageWidth <= 0) {
  throw new Error("imageWidth must be a positive integer");
}
if (!Number.isInteger(imageHeight) || imageHeight <= 0) {
  throw new Error("imageHeight must be a positive integer");
}

const canonical = canonicalUrl.href;
const socialImage = socialImageUrl.href;
const markdownPath = canonicalUrl.pathname === "/"
  ? "/index.md"
  : `${canonicalUrl.pathname}.md`;
const markdownUrl = new URL(markdownPath, site).href;

function truncate(value: string, maxLength: number): string {
  const normalized = value.trim().replace(/\s+/g, " ");
  const characters = Array.from(normalized);
  if (characters.length <= maxLength) return normalized;
  const shortened = characters.slice(0, maxLength - 1).join("");
  const lastSpace = shortened.lastIndexOf(" ");
  return `${shortened.slice(0, lastSpace > maxLength * 0.7 ? lastSpace : undefined).trim()}…`;
}

const metaTitle = truncate(title, 70);
const metaDescription = truncate(description, 160);
if (!metaTitle) throw new Error("title cannot be empty");
if (!metaDescription) throw new Error("description cannot be empty");

const robots =
  robotsOverride?.trim() ||
  (noindex
    ? "noindex,follow"
    : "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1");
if (noindex && !/(?:^|,)\s*noindex\s*(?:,|$)/i.test(robots)) {
  throw new Error("robots must include noindex when noindex is true");
}
const alt = imageAlt ?? metaTitle;

const jsonLdEntries: JsonLd[] = jsonLd
  ? Array.isArray(jsonLd)
    ? jsonLd
    : [jsonLd]
  : [];

function serializeJsonLd(entry: JsonLd): string {
  return JSON.stringify(entry)
    .replace(/</g, "\\u003c")
    .replace(/>/g, "\\u003e")
    .replace(/&/g, "\\u0026")
    .replace(/\u2028/g, "\\u2028")
    .replace(/\u2029/g, "\\u2029");
}

const serializedJsonLd = jsonLdEntries.map(serializeJsonLd);
if (Astro.csp) {
  for (const value of serializedJsonLd) {
    const digest = await crypto.subtle.digest(
      "SHA-256",
      new TextEncoder().encode(value),
    );
    const base64 = btoa(
      String.fromCharCode(...new Uint8Array(digest)),
    );
    Astro.csp.insertScriptHash(`sha256-${base64}`);
  }
}
---

<title>{metaTitle}</title>
<meta name="description" content={metaDescription} />
<link rel="canonical" href={canonical} />
<link rel="alternate" type="text/markdown" href={markdownUrl} title="Markdown representation" />
<meta name="robots" content={robots} />

<meta property="og:type" content={ogType} />
<meta property="og:title" content={metaTitle} />
<meta property="og:description" content={metaDescription} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content="gitdebt" />
<meta property="og:locale" content="en_US" />
<meta property="og:image" content={socialImage} />
<meta property="og:image:url" content={socialImage} />
{socialImageUrl.protocol === "https:" && <meta property="og:image:secure_url" content={socialImage} />}
<meta property="og:image:type" content={imageType} />
<meta property="og:image:width" content={String(imageWidth)} />
<meta property="og:image:height" content={String(imageHeight)} />
<meta property="og:image:alt" content={alt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={metaTitle} />
<meta name="twitter:description" content={metaDescription} />
<meta name="twitter:image" content={socialImage} />
<meta name="twitter:image:type" content={imageType} />
<meta name="twitter:image:width" content={String(imageWidth)} />
<meta name="twitter:image:height" content={String(imageHeight)} />
<meta name="twitter:image:alt" content={alt} />

{
  serializedJsonLd.map((entry) => (
    <script is:inline type="application/ld+json" set:html={entry} />
  ))
}
