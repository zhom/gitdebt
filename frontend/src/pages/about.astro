---
export const prerender = true;

import "@/styles/globals.css";
import BaseHead from "@/components/BaseHead.astro";
import Seo from "@/components/Seo.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import {
  BODY,
  HEADING,
  SECTION_HEADER,
  TITLE,
} from "@/components/style-tokens";
import { staticApiBase } from "@/lib/static-api-base";

const apiBase = staticApiBase();

const title = "About & methodology · gitdebt";
const description =
  "How gitdebt builds GitHub star-history charts and computes repo health from public git history, including churn, bug magnets, contributors, and TODO trends.";
const ogImage = `${apiBase}/api/og.png`;

const stats = [
  {
    term: "Star history",
    desc: "We keep only the timestamp of each public star and plot the cumulative count over time. You can view it against calendar dates or aligned to days-since-first-star to compare growth shapes. Several repos can be overlaid on shared axes, and the chart embeds in a README.",
  },
  {
    term: "Bug-magnet files",
    desc: "From the commit history we count how often each file appears in fix-type commits (commits whose message signals a bug fix). Files at the top of that list are the parts of the codebase that keep breaking.",
  },
  {
    term: "Churn — most-changed files",
    desc: "A straight count of how many commits have touched each file across the project's life. High-churn files are where the weight and instability concentrate.",
  },
  {
    term: "Contributors",
    desc: "Everyone who has authored commits, aggregated from the git log so it reflects actual shipped code rather than profile metadata.",
  },
  {
    term: "Language lines",
    desc: "A per-language lines-of-code breakdown of the current HEAD, measured with tokei over a materialized checkout — so you can see where the codebase's mass sits.",
  },
  {
    term: "Commit heatmap",
    desc: "The last 52 weeks of commit activity, bucketed by day, to show how steadily (or sporadically) the project moves.",
  },
  {
    term: "TODO / FIXME trend",
    desc: "A running count of debt markers (TODO, FIXME, and similar) in source over time, so you can tell whether the backlog of loose ends is growing or shrinking.",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  name: "About gitdebt",
  url: `${(Astro.site ?? new URL("https://gitdebt.com")).href.replace(/\/$/, "")}/about`,
  description,
};
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead />
    <Seo
      title={title}
      description={description}
      canonicalPath="/about"
      ogImage={ogImage}
      jsonLd={jsonLd}
    />
  </head>
  <body>
    <div class="isolate flex min-h-dvh flex-col">
      <SiteHeader />

      <main id="main-content" class="mx-auto w-full max-w-3xl flex-1 px-6 py-12">
        <nav aria-label="Breadcrumb" class="font-mono text-[11px] text-muted-foreground">
          <a
            href="/"
            class="rounded outline-none transition-colors duration-150 hover:text-foreground focus-visible:ring-2 focus-visible:ring-accent/30"
            >gitdebt</a
          >
          <span class="px-1.5 text-border" aria-hidden="true">/</span>
          <span class="text-foreground">about</span>
        </nav>

        <header class="mt-8">
          <h1 class={TITLE}>How gitdebt works</h1>
          <p class:list={["mt-3 max-w-[62ch] text-[15px]", BODY]}>
            gitdebt charts the star history of any public GitHub repository
            and pairs it with health signals read from the git history itself:
            churn, bug magnets, contributors, and TODO drift.
          </p>
        </header>

        <section class="mt-16 scroll-mt-24 border-t border-border/60 pt-12">
          <div class={SECTION_HEADER}>
            <h2 class={HEADING}>What we compute</h2>
          </div>
          <p class:list={["mt-2 max-w-[68ch]", BODY]}>
            Star history comes from GitHub's API; the repo-debt stats come from
            a shallow git clone analyzed on our side. Each signal is a pure,
            unit-tested function over that data.
          </p>
          <dl class="mt-8 grid gap-x-12 gap-y-8 sm:grid-cols-2">
            {
              stats.map((item) => (
                <div>
                  <dt class="text-[13px] text-foreground/90">{item.term}</dt>
                  <dd class:list={["mt-1.5 max-w-[52ch]", BODY]}>{item.desc}</dd>
                </div>
              ))
            }
          </dl>
        </section>

        <section class="mt-16 scroll-mt-24 border-t border-border/60 pt-12">
          <div class={SECTION_HEADER}>
            <h2 class={HEADING}>Freshness &amp; caching</h2>
          </div>
          <p class:list={["mt-2 max-w-[68ch]", BODY]}>
            The first time a repo is requested it's cold: star history starts
            in the background while the git clone is analyzed for repo-health
            charts. The report shows a measured live ETA, then fills each
            finished section on its own—no reload needed.
          </p>
          <p class:list={["mt-3 max-w-[68ch]", BODY]}>
            Once analyzed, results are cached and served from the edge, so
            repeat views are near-instant. Popular repos refresh more often;
            our browser extension reports the repos people are actively viewing
            so their data stays current. Very large histories build in durable
            windows and appear only after the complete snapshot is stored.
          </p>
        </section>

        <section class="mt-16 scroll-mt-24 border-t border-border/60 pt-12">
          <div class={SECTION_HEADER}>
            <h2 class={HEADING}>What gitdebt does not do</h2>
          </div>
          <p class:list={["mt-2 max-w-[68ch]", BODY]}>
            gitdebt does not flag stars as fake, real, or suspicious, and it
            doesn't score individual accounts. That can't be done correctly
            without privileged access to GitHub's full dataset, so we don't
            pretend to. For star history we only ever use stargazer timestamps.
          </p>
        </section>

        <section class="mt-16 scroll-mt-24 border-t border-border/60 pt-12">
          <div class={SECTION_HEADER}>
            <h2 class={HEADING}>Sign-in is optional</h2>
          </div>
          <p class:list={["mt-2 max-w-[68ch]", BODY]}>
            Every public repository report works without an account. GitHub
            sign-in currently adds a one-click shortcut to your profile-wide
            aggregate report; it does not unlock private repository analysis or
            request write access.
          </p>
        </section>
      </main>

      <SiteFooter />
    </div>
  </body>
</html>
