---
import Sheet from "@/layouts/Sheet.astro";
import { staticComparisonPaths } from "@/lib/build-catalog";
import { staticApiBase } from "@/lib/static-api-base";
import { loadBuildRepoSnapshot } from "@/lib/build-repo-snapshot";
import { LiveVsComparison } from "@/components/LiveVsComparison";
import { Terminator } from "@/components/ui/marks";
import {
  BODY,
  CAPTION,
  FIELD,
  HEADING,
  MEASURE,
} from "@/components/style-tokens";
import {
  coverageLabel,
  historyFreshness,
  sourceLabel,
  stateLabel,
  type HistorySnapshot,
} from "@/lib/history-freshness";

export function getStaticPaths() {
  return staticComparisonPaths();
}

const {
  owner1: rawOwner1,
  repo1: rawRepo1,
  owner2: rawOwner2,
  repo2: rawRepo2,
} = Astro.params;

const validSlug = /^[A-Za-z0-9._-]+$/;
if (
  !rawOwner1 ||
  !rawRepo1 ||
  !rawOwner2 ||
  !rawRepo2 ||
  !validSlug.test(rawOwner1) ||
  !validSlug.test(rawRepo1) ||
  !validSlug.test(rawOwner2) ||
  !validSlug.test(rawRepo2)
) {
  return new Response("Not found", { status: 404 });
}

const lower1 = rawOwner1.toLowerCase();
const lowerR1 = rawRepo1.toLowerCase();
const lower2 = rawOwner2.toLowerCase();
const lowerR2 = rawRepo2.toLowerCase();
const slugA = `${lower1}/${lowerR1}`;
const slugB = `${lower2}/${lowerR2}`;
const [first, second] = slugA <= slugB
  ? [[lower1, lowerR1], [lower2, lowerR2]]
  : [[lower2, lowerR2], [lower1, lowerR1]];
const canonicalPathname = `/vs/${first[0]}/${first[1]}/${second[0]}/${second[1]}`;
const rawPathname = `/vs/${rawOwner1}/${rawRepo1}/${rawOwner2}/${rawRepo2}`;
if (rawPathname !== canonicalPathname) {
  return new Response("Not found", { status: 404 });
}

const owner1 = first[0];
const repo1 = first[1];
const owner2 = second[0];
const repo2 = second[1];

const apiBase = staticApiBase();

const [left, right] = await Promise.all([
  loadBuildRepoSnapshot(`${owner1}/${repo1}`),
  loadBuildRepoSnapshot(`${owner2}/${repo2}`),
]);

const slug1 = `${owner1}/${repo1}`;
const slug2 = `${owner2}/${repo2}`;
const bothLoaded = left.data !== null && right.data !== null;
const fetchError = left.error ?? right.error;
const ready =
  bothLoaded &&
  left.data!.history.length > 0 &&
  right.data!.history.length > 0;

const reposParam = encodeURIComponent(`${slug1},${slug2}`);
const overlayPath = `/api/chart.svg?repos=${reposParam}`;

const title = `${repo1} vs ${repo2}: stars, code, and maintenance · gitdebt`;

/**
 * Two unbounded slugs eat most of the 160-character budget before a single
 * descriptive word is written, so the enumeration is the part that gives way.
 * All 278 of these pages used to truncate mid-clause.
 */
function fitDescription(head: string, tails: string[], limit = 160): string {
  for (const tail of tails) {
    const composed = `${head} ${tail}`;
    if (composed.length <= limit) return composed;
  }
  return head;
}

const description = fitDescription(`${slug1} vs ${slug2}.`, [
  "Star growth, forks, dominant language, codebase size, commit cadence, bus factor, and change pressure compared.",
  "Star growth, language, codebase size, commit cadence, and bus factor compared.",
  "Star growth, commit cadence, and contributor concentration compared.",
  "Star growth and repository health compared.",
]);
const site = (Astro.site ?? new URL("https://gitdebt.com")).href.replace(/\/$/, "");
const canonicalPath = `/vs/${slug1}/${slug2}`;
const canonical = `${site}${canonicalPath}`;

const ogImage = `${apiBase}/api/og.png?repos=${reposParam}`;

const noindex = !ready || fetchError !== null;

/**
 * The schedule: how each series was read, one column per repository.
 *
 * A head-to-head is exactly where two series with different sources and
 * different coverage ends get read as directly comparable, so the two readings
 * are set as a schedule with a shared row for every field. Identity is the
 * slug at the head of the column and nothing else — a colour swatch here would
 * have to claim a hue the overlay chart assigns, and a swatch that disagrees
 * with the line it names is worse than no swatch at all.
 *
 * Every string comes from `history-freshness.ts`: source, coverage date, state,
 * and never a count, a share, or anything implying how much is missing.
 */
const readingRows: { field: string; values: string[] }[] = [];
if (bothLoaded) {
  const readings = [left.data, right.data].map((snapshot) =>
    historyFreshness(snapshot),
  );
  readingRows.push(
    { field: "Source", values: readings.map(sourceLabel) },
    { field: "Coverage", values: readings.map(coverageLabel) },
    { field: "State", values: readings.map(stateLabel) },
  );
}

const faqs: { q: string; a: string }[] = [];
if (left.data && right.data) {
  const ranked = [
    { slug: slug1, stars: left.data.total_stars },
    { slug: slug2, stars: right.data.total_stars },
  ].sort((a, b) => b.stars - a.stars);
  faqs.push({
    q: `Which has more GitHub stars, ${slug1} or ${slug2}?`,
    a: `GitHub reports ${ranked[0].stars.toLocaleString()} stars for ${ranked[0].slug} and ${ranked[1].stars.toLocaleString()} for ${ranked[1].slug}.`,
  });

  // Source, date, state — per repository, and never a gap, a share or a score.
  // An archive series counts re-stars and can exceed a repository's own total,
  // so "how much is missing" is wrong exactly where it looks precise.
  const readAs = (slug: string, snapshot: HistorySnapshot) => {
    const freshness = historyFreshness(snapshot);
    return `${slug} — ${sourceLabel(freshness)} · ${coverageLabel(freshness)} · ${stateLabel(freshness)}`;
  };
  faqs.push({
    q: "Do both star histories cover the same period?",
    a: `Not necessarily, and each chart names its own. ${readAs(slug1, left.data)}. ${readAs(slug2, right.data)}. Since July 2026 GitHub serves a repository's stargazer list only to its own admins and collaborators, so one series can stop on a fixed date while the other keeps flowing from public archive events.`,
  });
  faqs.push({
    q: "How is this comparison computed?",
    a: "Star totals come from public repository metadata. The two curves are each repository's stored star series drawn on shared axes, from whichever source is named above. Repository-health figures are computed independently from each project's commit history.",
  });
}

const jsonLd: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: `${slug1} vs ${slug2}`,
    url: canonical,
    description,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "gitdebt", item: `${site}/` },
      { "@type": "ListItem", position: 2, name: "Compare", item: `${site}/compare` },
      { "@type": "ListItem", position: 3, name: `${slug1} vs ${slug2}`, item: canonical },
    ],
  },
];
// The star total is GitHub's own figure and the hero prints it; asserting it
// says nothing about how the series behind the chart was read.
if (left.data && right.data) {
  for (const entry of [
    { slug: slug1, stars: left.data.total_stars },
    { slug: slug2, stars: right.data.total_stars },
  ]) {
    jsonLd.push({
      "@context": "https://schema.org",
      "@type": "SoftwareSourceCode",
      name: entry.slug,
      codeRepository: `https://github.com/${entry.slug}`,
      url: `${site}/${entry.slug}`,
      interactionStatistic: {
        "@type": "InteractionCounter",
        interactionType: { "@type": "LikeAction" },
        userInteractionCount: entry.stars,
      },
    });
  }
}
// Mirrors the visible block below, and is never emitted without it.
if (faqs.length > 0) {
  jsonLd.push({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  });
}
---

<Sheet
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  ogImage={ogImage}
  imageAlt={`Star history comparison card for ${slug1} versus ${slug2}`}
  noindex={noindex}
  jsonLd={jsonLd}
>
  {/* ── The sheet: two objects on one set of axes ────────────────────────── */}
  <section class="registered border-b border-rule bg-paper">
    <div class="mx-auto max-w-6xl px-6 pt-8 pb-16">
      <nav aria-label="Breadcrumb" class="font-mono text-[0.75rem] text-ink-3">
        <a
          href="/"
          class="outline-none transition-colors duration-[--duration-ui] hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-signal"
          >gitdebt</a
        >
        <span class="px-1.5 text-rule-strong" aria-hidden="true">/</span>
        <a
          href="/compare"
          class="outline-none transition-colors duration-[--duration-ui] hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-signal"
          >vs</a
        >
        <span class="px-1.5 text-rule-strong" aria-hidden="true">/</span>
        <span class="text-ink">{slug1} · {slug2}</span>
      </nav>

      <div class="min-w-0">
        <LiveVsComparison
          client:load
          apiBase={apiBase}
          canonical={canonical}
          initialLeft={left.data}
          initialRight={right.data}
          overlayPath={overlayPath}
          slug1={slug1}
          slug2={slug2}
        />
      </div>
    </div>
  </section>

  {/* ── The schedule ──────────────────────────────────────────────────────
      Dense, and the densest thing on the page: three fields read across two
      columns, every row on one line. */}
  {readingRows.length > 0 && (
    <section class="border-b border-rule bg-table">
      <div class="mx-auto max-w-6xl px-6 py-16">
        <h2 class={HEADING}>One axis, two sources</h2>
        <p class:list={["mt-3", BODY, MEASURE]}>
          The overlay puts both repositories on one axis. It does not put them
          on one source: since July 2026 a stargazer-list series stops on a
          fixed date, while a series rebuilt from public archive events keeps
          receiving points. Each column below states its own reading.
        </p>

        <div class="mt-8 overflow-x-auto border border-rule-strong bg-paper">
          <table class="w-full min-w-[36rem] border-collapse text-left">
            <caption class="sr-only">
              How the star series for {slug1} and {slug2} were read
            </caption>
            <thead>
              <tr class="border-b border-rule-strong">
                {/* A schedule's corner cell carries no lettering; the column
                    it heads is the field names themselves. */}
                <th scope="col" class="w-[9rem] px-4 py-3">
                  <span class="sr-only">Field</span>
                </th>
                {[slug1, slug2].map((slug) => (
                  <th
                    scope="col"
                    class="px-4 py-3 font-mono text-[0.8125rem] font-normal text-ink"
                  >
                    {slug}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {readingRows.map((row) => (
                <tr class="border-b border-rule last:border-0">
                  <th scope="row" class="px-4 py-3 align-top">
                    <span class={FIELD}>{row.field}</span>
                  </th>
                  {row.values.map((value) => (
                    <td class="px-4 py-3 align-top text-[0.8125rem] leading-[1.5] text-ink-2">
                      {value}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <p class:list={["mt-4", CAPTION, MEASURE]}>
          No row states how much of a history is missing. An archive series
          records star actions and not unstars, so it can exceed a repository's
          own star total, and a figure for the difference would be wrong exactly
          where it looks most precise.
        </p>
      </div>
    </section>
  )}

  {/* ── Notes ─────────────────────────────────────────────────────────────
      The quiet passage after the schedule: long answers, folded away, opened
      by a native disclosure that works with no script at all. */}
  {faqs.length > 0 && (
    <section class="bg-paper">
      <div class="mx-auto max-w-6xl px-6 py-16">
        <h2 class={HEADING}>Notes on this comparison</h2>
        <ul role="list" class="mt-6 max-w-[72ch] border-t border-rule">
          {faqs.map((f) => (
            <li class="border-b border-rule">
              <details class="group">
                <summary
                  class="flex min-h-14 cursor-pointer list-none items-center gap-5 py-3 text-[0.9375rem] leading-[1.45] text-ink-2 outline-none transition-colors duration-[--duration-ui] hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-signal [&::-webkit-details-marker]:hidden"
                >
                  <span class="min-w-0 flex-1">{f.q}</span>
                  <span
                    aria-hidden="true"
                    class="shrink-0 text-ink-3 transition-transform duration-[--duration-ui] group-open:rotate-90 motion-reduce:transition-none"
                  >
                    <Terminator size={14} />
                  </span>
                </summary>
                <p class:list={["pb-5", BODY]}>{f.a}</p>
              </details>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</Sheet>
