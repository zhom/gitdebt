---
export const prerender = true;

import "@/styles/globals.css";
import BaseHead from "@/components/BaseHead.astro";
import { ButtonLink } from "@/components/ButtonLink";
import Seo from "@/components/Seo.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { BadgeStudio } from "@/components/BadgeStudio";
import { CopyButton } from "@/components/CopyButton";
import { TOKEN_CLASS, tokenize } from "@/components/CodeBlock";
import {
  BODY,
  CAPTION,
  EYEBROW,
  HEADING,
  PANEL,
  TILE_DESC,
  TILE_TITLE,
  SECTION_HEADER,
  TITLE,
} from "@/components/style-tokens";
import { MEDIA_RENDER_REVISION } from "@/lib/media";
import { staticApiBase } from "@/lib/static-api-base";

const apiBase = staticApiBase();

const site = (Astro.site ?? new URL("https://gitdebt.com")).href.replace(/\/$/, "");

const exampleOwner = "facebook";
const exampleRepo = "react";
const exampleSlug = `${exampleOwner}/${exampleRepo}`;
const exampleLogin = "facebook";

const repoLink = `https://gitdebt.com/${exampleSlug}?ref=readme`;
const profileLink = `https://gitdebt.com/${exampleLogin}?ref=readme`;

type Embed = {
  id: string;
  name: string;
  desc: string;
  /** Asset path under the API origin, without a query string. */
  path: string;
  link: string;
  alt: string;
  /** Only SVG assets have a light/dark pair worth previewing. */
  themed?: boolean;
  wide?: boolean;
};

/** URL a README would carry: no cache-busting, no attribution parameters. */
function embedUrl(path: string, theme?: "light" | "dark"): string {
  if (!theme) return `${apiBase}${path}`;
  const separator = path.includes("?") ? "&" : "?";
  return `${apiBase}${path}${separator}theme=${theme}`;
}

/** Same asset, plus the revision the site uses to stay off stale edge objects. */
function previewUrl(path: string, theme?: "light" | "dark"): string {
  const [pathname, query = ""] = path.split("?", 2);
  const params = new URLSearchParams(query);
  if (theme) params.set("theme", theme);
  params.set("render", MEDIA_RENDER_REVISION);
  return `${apiBase}${pathname}?${params.toString()}`;
}

function markdown(embed: Embed): string {
  const url = embedUrl(embed.path, embed.themed ? "dark" : undefined);
  return `[![${embed.alt}](${url})](${embed.link})`;
}

const media: Embed[] = [
  {
    id: "contributor-ready",
    name: "Contributor readiness",
    desc: "A factual checklist badge for project guides, contribution policy, tests, CI, templates, and security documentation. It is a signal, not an achievement.",
    path: `/api/repos/${exampleSlug}/badge.svg?signal=contributor-ready`,
    link: repoLink,
    alt: `${exampleSlug} contributor readiness`,
    themed: true,
  },
  {
    id: "chart",
    name: "Star history",
    desc: "The full star curve, served from Postgres. Add from/to for a window or rebase=1 to start every series at zero.",
    path: `/api/repos/${exampleSlug}/chart.svg`,
    link: repoLink,
    alt: `${exampleSlug} star history`,
    themed: true,
    wide: true,
  },
  {
    id: "gif",
    name: "Looping GIF",
    desc: "The same curve as an animated GIF, for READMEs and sites that strip SVG motion.",
    path: `/api/repos/${exampleSlug}/chart.gif`,
    link: repoLink,
    alt: `${exampleSlug} star history animation`,
    wide: true,
  },
  {
    id: "repo-card",
    name: "Repository card",
    desc: "Stars, forks, contributors, languages, and a 90-day sparkline in one compact panel.",
    path: `/api/repos/${exampleSlug}/card.svg`,
    link: repoLink,
    alt: `${exampleSlug} repository statistics`,
    themed: true,
  },
  {
    id: "profile-card",
    name: "Maintainer profile card",
    desc: "Aggregate public-repository totals for an account, for a profile README.",
    path: `/api/users/${exampleLogin}/card.svg`,
    link: profileLink,
    alt: `${exampleLogin} maintainer statistics`,
    themed: true,
  },
  {
    id: "og",
    name: "Social preview",
    desc: "A 1200x630 PNG for link unfurls on social platforms and chat apps.",
    path: `/api/repos/${exampleSlug}/og.png`,
    link: repoLink,
    alt: `${exampleSlug} on gitdebt`,
    wide: true,
  },
];

const health: Embed[] = [
  {
    id: "heatmap",
    name: "Commit calendar",
    desc: "Daily commit density across the last year.",
    path: `/api/repos/${exampleSlug}/stats/heatmap.svg`,
    link: repoLink,
    alt: `${exampleSlug} commit calendar`,
    themed: true,
    wide: true,
  },
  {
    id: "contributors",
    name: "Contributors",
    desc: "Who is actually landing commits, ranked.",
    path: `/api/repos/${exampleSlug}/stats/contributors.svg`,
    link: repoLink,
    alt: `${exampleSlug} contributors`,
    themed: true,
  },
  {
    id: "bus-factor",
    name: "Bus factor",
    desc: "How concentrated the commit history is in a few hands.",
    path: `/api/repos/${exampleSlug}/stats/bus-factor.svg`,
    link: repoLink,
    alt: `${exampleSlug} bus factor`,
    themed: true,
  },
  {
    id: "commit-trend",
    name: "Commit trend",
    desc: "Commit volume over time, so a slowdown is visible.",
    path: `/api/repos/${exampleSlug}/stats/commit-trend.svg`,
    link: repoLink,
    alt: `${exampleSlug} commit trend`,
    themed: true,
  },
  {
    id: "lines",
    name: "Language activity",
    desc: "Lines added and removed per language.",
    path: `/api/repos/${exampleSlug}/stats/lines.svg`,
    link: repoLink,
    alt: `${exampleSlug} language activity`,
    themed: true,
  },
  {
    id: "top-files",
    name: "File change frequency",
    desc: "Files touched by the most analyzed commits.",
    path: `/api/repos/${exampleSlug}/stats/top-files.svg`,
    link: repoLink,
    alt: `${exampleSlug} file change frequency`,
    themed: true,
  },
  {
    id: "bug-magnets",
    name: "Fix-labelled changes",
    desc: "Files most often touched by commits whose message matches the fix heuristic.",
    path: `/api/repos/${exampleSlug}/stats/bug-magnets.svg`,
    link: repoLink,
    alt: `${exampleSlug} fix-labelled changes`,
    themed: true,
  },
  {
    id: "todo-trend",
    name: "Recent TODO/FIXME movement",
    desc: "Recent marker movement inside the analyzed commit window.",
    path: `/api/repos/${exampleSlug}/stats/todo-trend.svg`,
    link: repoLink,
    alt: `${exampleSlug} recent TODO/FIXME movement`,
    themed: true,
  },
];

const title = "GitHub README badges and embeds · gitdebt";
const description =
  "Embed live GitHub data in a README: a stars, forks, and downloads badge, the star-history chart and GIF, repository and profile cards, a social preview, and eight repository-health charts.";
const ogImage = `${apiBase}/api/og.png`;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "@id": `${site}/badges#page`,
    name: "GitHub README badges and embeds",
    url: `${site}/badges`,
    description,
    isPartOf: {
      "@type": "WebSite",
      "@id": `${site}/#website`,
      name: "gitdebt",
      url: site,
    },
    mainEntity: {
      "@type": "WebApplication",
      name: "gitdebt README badge builder",
      applicationCategory: "DeveloperApplication",
      operatingSystem: "Web",
      url: `${site}/badges`,
      isAccessibleForFree: true,
      offers: {
        "@type": "Offer",
        price: 0,
        priceCurrency: "USD",
      },
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "gitdebt",
        item: site,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "README badges",
        item: `${site}/badges`,
      },
    ],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead />
    <Seo
      title={title}
      description={description}
      canonicalPath="/badges"
      ogImage={ogImage}
      imageAlt="gitdebt GitHub README badge builder"
      imageType="image/png"
      imageWidth={1200}
      imageHeight={630}
      jsonLd={jsonLd}
    />
  </head>
  <body>
    <div class="isolate flex min-h-dvh flex-col">
      <SiteHeader />

      <main id="main-content" class="mx-auto w-full max-w-5xl flex-1 px-6 py-12">
        <nav aria-label="Breadcrumb" class="font-mono text-[11px] text-muted-foreground">
          <a
            href="/"
            class="rounded outline-none transition-colors duration-150 hover:text-foreground focus-visible:ring-2 focus-visible:ring-accent/30"
            >gitdebt</a
          >
          <span class="px-1.5 text-border" aria-hidden="true">/</span>
          <span class="text-foreground">badges</span>
        </nav>

        <header class="mt-8 max-w-3xl">
          <h1 class={TITLE}>Everything you can embed in a README</h1>
          <p class:list={["mt-3 max-w-[62ch] text-[15px]", BODY]}>
            One metrics badge, the star-history chart as SVG or GIF, repository
            and maintainer cards, a social preview, and eight
            repository-health charts. Every asset is a plain image URL served
            from gitdebt's own database.
          </p>
          <p class:list={["mt-3 font-mono", CAPTION]}>
            Free · open source · no account required · static README output
          </p>
        </header>

        <section aria-labelledby="studio-title" class="mt-12">
          <div class={SECTION_HEADER}>
            <h2 id="studio-title" class={HEADING}>Metrics badge</h2>
            <p class={CAPTION}>interactive</p>
          </div>
          <p class:list={["mt-2 max-w-[68ch]", BODY]}>
            Stars, forks, and package downloads in one compact chip. Pick the
            metrics and the theme, then copy Markdown or theme-aware HTML.
            The example below is ready immediately; a repository report opens
            the same controls with its own owner and name.
          </p>

          <div class="mt-6">
            <BadgeStudio
              client:load
              owner={exampleOwner}
              repo={exampleRepo}
              apiBase={apiBase}
            />
          </div>
          <noscript>
            <p class:list={["mt-4", BODY]}>
              Enable JavaScript to configure and copy a badge. Published
              badges remain static assets and do not require JavaScript.
            </p>
          </noscript>
        </section>

        <section
          aria-labelledby="media-title"
          class="mt-16 scroll-mt-24 border-t border-border/60 pt-12"
        >
          <div class={SECTION_HEADER}>
            <h2 id="media-title" class={HEADING}>Charts, cards, and previews</h2>
            <p class={CAPTION}>{exampleSlug}</p>
          </div>
          <p class:list={["mt-2 max-w-[68ch]", BODY]}>
            Live assets for {exampleSlug}. Each snippet is Markdown for the
            dark asset; swap <code class="font-mono text-foreground"
              >theme=light</code
            > for the light one, or use the HTML <code
              class="font-mono text-foreground">&lt;picture&gt;</code
            > form to publish both.
          </p>

          <div class="mt-8 grid gap-6 sm:grid-cols-2">
            {
              media.map((embed) => (
                <figure
                  class:list={[
                    PANEL,
                    "flex flex-col overflow-hidden",
                    embed.wide && "sm:col-span-2",
                  ]}
                >
                  <figcaption class="border-b border-border/40 px-4 py-3">
                    <p class="text-[13px] text-foreground">{embed.name}</p>
                    <p class:list={[CAPTION, "mt-1 max-w-[62ch]"]}>
                      {embed.desc}
                    </p>
                  </figcaption>

                  <div class="flex flex-1 items-center justify-center bg-card/40 px-4 py-6">
                    {embed.themed ? (
                      <picture>
                        <source
                          media="(prefers-color-scheme: dark)"
                          srcset={previewUrl(embed.path, "dark")}
                        />
                        <img
                          src={previewUrl(embed.path, "light")}
                          alt={embed.alt}
                          loading="lazy"
                          decoding="async"
                          class="block h-auto max-w-full"
                        />
                      </picture>
                    ) : (
                      <img
                        src={previewUrl(embed.path)}
                        alt={embed.alt}
                        loading="lazy"
                        decoding="async"
                        class="block h-auto max-w-full"
                      />
                    )}
                  </div>

                  <div class="relative border-t border-border/40">
                    <pre class="overflow-x-auto px-4 py-4 pr-24 font-mono text-[12px] leading-relaxed"><code>{tokenize(markdown(embed), "markdown").map((token) => (<span class={TOKEN_CLASS[token.kind]}>{token.text}</span>))}</code></pre>
                    <CopyButton
                      client:visible
                      value={markdown(embed)}
                      ariaLabel={`Copy the ${embed.name} embed snippet`}
                      className="absolute top-3 right-3 backdrop-blur"
                    />
                  </div>
                </figure>
              ))
            }
          </div>
        </section>

        <section
          aria-labelledby="health-title"
          class="mt-16 scroll-mt-24 border-t border-border/60 pt-12"
        >
          <div class={SECTION_HEADER}>
            <h2 id="health-title" class={HEADING}>Repository-health charts</h2>
            <p class={CAPTION}>eight assets</p>
          </div>
          <p class:list={["mt-2 max-w-[68ch]", BODY]}>
            Calculated from the public Git history, cached, and served as
            images. A repository that has never been analyzed renders a
            placeholder and queues the work instead of blocking the request.
          </p>

          <div class="mt-8 grid gap-6 sm:grid-cols-2">
            {
              health.map((embed) => (
                <figure
                  class:list={[
                    PANEL,
                    "flex flex-col overflow-hidden",
                    embed.wide && "sm:col-span-2",
                  ]}
                >
                  <figcaption class="border-b border-border/40 px-4 py-3">
                    <p class="text-[13px] text-foreground">{embed.name}</p>
                    <p class:list={[CAPTION, "mt-1 max-w-[62ch]"]}>
                      {embed.desc}
                    </p>
                  </figcaption>

                  <div class="flex flex-1 items-center justify-center bg-card/40 px-4 py-6">
                    <picture>
                      <source
                        media="(prefers-color-scheme: dark)"
                        srcset={previewUrl(embed.path, "dark")}
                      />
                      <img
                        src={previewUrl(embed.path, "light")}
                        alt={embed.alt}
                        loading="lazy"
                        decoding="async"
                        class="block h-auto max-w-full"
                      />
                    </picture>
                  </div>

                  <div class="relative border-t border-border/40">
                    <pre class="overflow-x-auto px-4 py-4 pr-24 font-mono text-[12px] leading-relaxed"><code>{tokenize(markdown(embed), "markdown").map((token) => (<span class={TOKEN_CLASS[token.kind]}>{token.text}</span>))}</code></pre>
                    <CopyButton
                      client:visible
                      value={markdown(embed)}
                      ariaLabel={`Copy the ${embed.name} embed snippet`}
                      className="absolute top-3 right-3 backdrop-blur"
                    />
                  </div>
                </figure>
              ))
            }
          </div>
        </section>

        <section
          aria-labelledby="badge-workflow-title"
          class="mt-16 scroll-mt-24 border-t border-border/60 pt-12"
        >
          <div class={SECTION_HEADER}>
            <h2 id="badge-workflow-title" class={HEADING}>
              How the embeds work
            </h2>
          </div>
          <div class="mt-8 grid gap-x-12 gap-y-10 sm:grid-cols-3">
            {
              [
                {
                  step: "01",
                  title: "Point at a repository",
                  body: "Swap the owner and name in any URL above. Nothing else needs to change, and no account or token is involved.",
                },
                {
                  step: "02",
                  title: "Pick a theme",
                  body: "Colors are baked per asset because GitHub renders README images against your OS preference, not the page. Publish both with a picture element.",
                },
                {
                  step: "03",
                  title: "Paste the snippet",
                  body: "The image URL stays plain and cacheable; only the surrounding link carries README attribution.",
                },
              ].map(({ step, title, body }) => (
                <article>
                  <p class={EYEBROW}>{step}</p>
                  <h3 class={TILE_TITLE}>{title}</h3>
                  <p class={TILE_DESC}>{body}</p>
                </article>
              ))
            }
          </div>
        </section>

        <section class="mt-16 scroll-mt-24 border-t border-border/60 pt-12">
          <div class={SECTION_HEADER}>
            <h2 class={HEADING}>Build these for your repository</h2>
          </div>
          <p class:list={["mt-2 max-w-[64ch]", BODY]}>
            Open a repository report to get every asset above wired to that
            project, with the badge studio and embed menus already pointed at
            it.
          </p>
          <div class="mt-6">
            <ButtonLink
              client:visible
              href={`/${exampleSlug}`}
              variant="outline"
              size="lg"
              pulse
            >
              View {exampleSlug}
            </ButtonLink>
          </div>
        </section>
      </main>

      <SiteFooter />
    </div>
  </body>
</html>
