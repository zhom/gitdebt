---
export const prerender = true;

import "@/styles/globals.css";
import BaseHead from "@/components/BaseHead.astro";
import Seo from "@/components/Seo.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { BadgeStudio } from "@/components/BadgeStudio";
import {
  BODY,
  CAPTION,
  EYEBROW,
  HEADING,
  TILE_DESC,
  TILE_TITLE,
  SECTION_HEADER,
  TITLE,
} from "@/components/style-tokens";
import { buttonVariants } from "@/components/ui/button";
import { staticApiBase } from "@/lib/static-api-base";

const apiBase = staticApiBase();

const site = (Astro.site ?? new URL("https://gitdebt.com")).href.replace(/\/$/, "");

const exampleOwner = "facebook";
const exampleRepo = "react";

const title = "GitHub README badges · gitdebt";
const description =
  "Build a theme-aware GitHub README badge for repository stars, forks, and package downloads, then copy accessible Markdown or HTML.";
const ogImage = `${apiBase}/api/og.png`;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "@id": `${site}/badges#page`,
    name: "GitHub README badge builder",
    url: `${site}/badges`,
    description,
    isPartOf: {
      "@type": "WebSite",
      "@id": `${site}/#website`,
      name: "gitdebt",
      url: site,
    },
    mainEntity: {
      "@type": "WebApplication",
      name: "gitdebt README badge builder",
      applicationCategory: "DeveloperApplication",
      operatingSystem: "Web",
      url: `${site}/badges`,
      isAccessibleForFree: true,
      offers: {
        "@type": "Offer",
        price: 0,
        priceCurrency: "USD",
      },
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "gitdebt",
        item: site,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "README badges",
        item: `${site}/badges`,
      },
    ],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead />
    <Seo
      title={title}
      description={description}
      canonicalPath="/badges"
      ogImage={ogImage}
      imageAlt="gitdebt GitHub README badge builder"
      imageType="image/png"
      imageWidth={1200}
      imageHeight={630}
      jsonLd={jsonLd}
    />
  </head>
  <body>
    <div class="isolate flex min-h-dvh flex-col">
      <SiteHeader />

      <main id="main-content" class="mx-auto w-full max-w-5xl flex-1 px-6 py-12">
        <nav aria-label="Breadcrumb" class="font-mono text-[11px] text-muted-foreground">
          <a
            href="/"
            class="rounded outline-none transition-colors duration-150 hover:text-foreground focus-visible:ring-2 focus-visible:ring-accent/30"
            >gitdebt</a
          >
          <span class="px-1.5 text-border" aria-hidden="true">/</span>
          <span class="text-foreground">badges</span>
        </nav>

        <header class="mt-8 max-w-3xl">
          <h1 class={TITLE}>Build a README badge from live repository data</h1>
          <p class:list={["mt-3 max-w-[62ch] text-[15px]", BODY]}>
            Put stars, forks, and package downloads in one compact,
            accessible badge. Preview every style, choose a light or dark
            treatment, and copy production-ready Markdown or HTML.
          </p>
          <p class:list={["mt-3 font-mono", CAPTION]}>
            Free · open source · no account required · static README output
          </p>
        </header>

        <section aria-labelledby="studio-title" class="mt-12">
          <div class={SECTION_HEADER}>
            <h2 id="studio-title" class={HEADING}>
              Preview {exampleOwner}/{exampleRepo}
            </h2>
            <p class={CAPTION}>interactive studio</p>
          </div>
          <p class:list={["mt-2 max-w-[68ch]", BODY]}>
            The public example is ready immediately. A repository report opens
            the same controls with its own owner and name.
          </p>

          <div class="mt-6">
            <BadgeStudio
              client:load
              owner={exampleOwner}
              repo={exampleRepo}
              apiBase={apiBase}
            />
          </div>
          <noscript>
            <p class:list={["mt-4", BODY]}>
              Enable JavaScript to configure and copy a badge. Published
              badges remain static assets and do not require JavaScript.
            </p>
          </noscript>
        </section>

        <section
          aria-labelledby="badge-workflow-title"
          class="mt-16 scroll-mt-24 border-t border-border/60 pt-12"
        >
          <div class={SECTION_HEADER}>
            <h2 id="badge-workflow-title" class={HEADING}>
              How README badges work
            </h2>
          </div>
          <div class="mt-8 grid gap-x-12 gap-y-10 sm:grid-cols-3">
            {
              [
                {
                  step: "01",
                  title: "Choose metrics",
                  body: "Show stars, forks, downloads, or a focused subset. Missing package data is omitted instead of reported as zero.",
                },
                {
                  step: "02",
                  title: "Choose presentation",
                  body: "Compare four restrained styles and preview explicit light and dark assets before publishing.",
                },
                {
                  step: "03",
                  title: "Copy the embed",
                  body: "Use Markdown for one theme or HTML picture sources for automatic GitHub light and dark mode.",
                },
              ].map(({ step, title, body }) => (
                <article>
                  <p class={EYEBROW}>{step}</p>
                  <h3 class={TILE_TITLE}>{title}</h3>
                  <p class={TILE_DESC}>{body}</p>
                </article>
              ))
            }
          </div>
        </section>

        <section class="mt-16 scroll-mt-24 border-t border-border/60 pt-12">
          <div class={SECTION_HEADER}>
            <h2 class={HEADING}>Build one for your repository</h2>
          </div>
          <p class:list={["mt-2 max-w-[64ch]", BODY]}>
            Open a repository report and use the badge studio already wired to
            that project. The copied image URL stays cacheable; only its
            surrounding link carries README attribution.
          </p>
          <div class="mt-6">
            <a
              href={`/${exampleOwner}/${exampleRepo}`}
              class={buttonVariants({ variant: "outline", size: "lg" })}
            >
              View {exampleOwner}/{exampleRepo}
            </a>
          </div>
        </section>
      </main>

      <SiteFooter />
    </div>
  </body>
</html>
