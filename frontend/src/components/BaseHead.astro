---
import "@fontsource-variable/geist-mono/wght.css";
import geistMonoLatin from "@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url";
import formatDraft from "@/fonts/format-1452.woff2?url";
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="color-scheme" content="light" />
<meta name="referrer" content="strict-origin-when-cross-origin" />
<meta name="format-detection" content="telephone=no" />
<meta name="generator" content={Astro.generator} />

{/*
  Two faces load, and only two. Prose is set in the platform's own UI face,
  which costs nothing and is the one genuinely neutral choice; the drawing's
  hand (Format 1452, 11.7 KB) and the data face are the only bytes on the wire.
  Inter used to load here and no longer does: it carried the old identity, and
  nothing in the new system asks for it.
*/}
<link rel="preload" href={formatDraft} as="font" type="font/woff2" crossorigin />
<link rel="preload" href={geistMonoLatin} as="font" type="font/woff2" crossorigin />

<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=4" />
<link rel="icon" type="image/png" href="/favicon-32.png?v=4" sizes="32x32" />
<link rel="icon" type="image/png" href="/favicon-16.png?v=4" sizes="16x16" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png?v=4" sizes="180x180" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
<link rel="alternate" type="text/plain" href="/llms.txt" title="LLM guidance" />
<meta name="application-name" content="gitdebt" />
<meta name="apple-mobile-web-app-title" content="gitdebt" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="default" />

<meta name="theme-color" content="#ffffff" />
