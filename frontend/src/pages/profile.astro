---
export const prerender = true;

import "@/styles/globals.css";
import BaseHead from "@/components/BaseHead.astro";
import Seo from "@/components/Seo.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import { staticApiBase } from "@/lib/static-api-base";

const apiBase = staticApiBase();
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead />
    <Seo
      title="Your GitHub profile report · gitdebt"
      description="Open a live aggregate report for your public GitHub repositories: star history, commit activity, language footprint and embeddable README assets."
      canonicalPath="/profile"
      ogImage={`${apiBase}/api/og.png`}
      noindex={true}
    />
  </head>
  <body>
    <div class="isolate flex min-h-dvh flex-col">
      <SiteHeader />
      <main id="main-content" class="mx-auto w-full max-w-6xl flex-1 px-6 py-12">
        <h1 class="text-3xl font-semibold tracking-[-0.035em] text-foreground">
          Opening your profile report
        </h1>
        <p data-profile-status class="mt-3 max-w-[65ch] text-[15px] leading-7 text-muted-foreground">
          Reading your signed-in GitHub account.
        </p>
      </main>
      <SiteFooter />
    </div>
    <script is:inline define:vars={{ apiBase }}>
      const status = document.querySelector("[data-profile-status]");
      fetch(`${apiBase}/api/me`, {
        credentials: "include",
        headers: { accept: "application/json" },
      })
        .then(async (response) =>
          response.ok ? await response.json() : null,
        )
        .then((user) => {
          const login =
            typeof user?.login === "string" &&
            /^[a-z0-9](?:[a-z0-9-]{0,37}[a-z0-9])?$/.test(user.login.toLowerCase())
              ? user.login.toLowerCase()
              : null;
          if (login) {
            location.replace(`/${encodeURIComponent(login)}`);
            return;
          }
          if (status) status.textContent = "Sign in with GitHub to open your profile report.";
        })
        .catch(() => {
          if (status) status.textContent = "Your session could not be read. Try signing in again.";
        });
    </script>
  </body>
</html>
