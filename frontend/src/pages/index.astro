---
export const prerender = true;

import "@/styles/globals.css";
import {
  AppWindow,
  ArrowRight,
  ChartNoAxesCombined,
  Code2,
  GitCompareArrows,
  Globe,
} from "lucide-react";

import BaseHead from "@/components/BaseHead.astro";
import Seo from "@/components/Seo.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { ComparisonModeGraphic } from "@/components/ComparisonModeGraphic";
import { LandingRepoLookup } from "@/components/LandingRepoLookup";
import { PlatformPulse } from "@/components/PlatformPulse";
import { SignalFlowGraphic } from "@/components/SignalFlowGraphic";
import { ThemeEmbedPreview } from "@/components/ThemeEmbedPreview";
import { WarmRepos } from "@/components/WarmRepos";
import { CATEGORIES } from "@/data/categories";
import {
  EXTENSION_CHROME_URL,
  EXTENSION_FIREFOX_URL,
} from "@/lib/extension-links";
import { staticApiBase } from "@/lib/static-api-base";

const apiBase = staticApiBase();
const site = (Astro.site ?? new URL("https://gitdebt.com")).href.replace(/\/$/, "");

const title = "gitdebt — GitHub star history & repository health";
const description =
  "Chart any GitHub repository's star history, compare growth on one timeline, and inspect churn, contributors, bug magnets, and maintenance debt. Free, open source, and README-ready.";
const ogImage = `${apiBase}/api/og.png`;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "gitdebt",
    url: `${site}/`,
    description,
    applicationCategory: "DeveloperApplication",
    operatingSystem: "Any",
    browserRequirements: "Requires JavaScript for live report updates",
    isAccessibleForFree: true,
    license: "https://opensource.org/license/mit",
    codeRepository: "https://github.com/zhom/gitdebt",
    author: {
      "@type": "Organization",
      name: "Internet Technology Services LLC",
    },
    offers: {
      "@type": "Offer",
      price: 0,
      priceCurrency: "USD",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "gitdebt",
    url: `${site}/`,
    description,
  },
];

const reportLayers = [
  {
    number: "01",
    title: "See attention accumulate",
    desc: "Read cumulative GitHub star history by calendar date or days since the first star. Window the series, export the raw data, or overlay up to eight repositories.",
    link: "/compare",
    linkLabel: "Open the comparison tool",
  },
  {
    number: "02",
    title: "Find the maintenance pressure",
    desc: "Inspect churn, bug-magnet files, contributor concentration, commit activity, TODO/FIXME trends, language weight, and bus factor from the repository's history.",
    link: "/report?repo=facebook/react",
    linkLabel: "Open an example report",
  },
  {
    number: "03",
    title: "Keep the evidence portable",
    desc: "Publish static or animated charts, README stat cards, badges, and raster assets. Theme-aware snippets use separate light and dark files for dependable embeds.",
    link: "/badges",
    linkLabel: "Build a README asset",
  },
];

const popularPairs = [
  ["facebook/react", "vuejs/vue"],
  ["denoland/deno", "oven-sh/bun"],
  ["django/django", "fastapi/fastapi"],
  ["gatsbyjs/gatsby", "vercel/next.js"],
].map((repos) => ({
  repos: [...repos].sort(),
  label: repos.map((repo) => repo.split("/")[1]).join(" vs "),
}));

const featuredCategorySlugs = [
  "frontend-frameworks",
  "build-tools",
  "ai-coding-tools",
  "sql-databases",
];
const featuredCategories = featuredCategorySlugs.flatMap((slug) => {
  const category = CATEGORIES.find((candidate) => candidate.slug === slug);
  return category ? [category] : [];
});
const landingWarmRepos = Array.from(
  new Set([
    ...popularPairs.flatMap((pair) => pair.repos),
    ...featuredCategories.flatMap((category) => category.repos),
  ]),
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead />
    <Seo
      title={title}
      description={description}
      canonicalPath="/"
      ogImage={ogImage}
      jsonLd={jsonLd}
    />
  </head>
  <body>
    <div class="isolate flex min-h-dvh flex-col">
      <SiteHeader />

      <main id="main-content" class="flex-1 bg-white text-zinc-950">
        <section id="top" class="border-b border-zinc-300">
          <div class="mx-auto max-w-6xl px-6 py-16 sm:py-24 lg:py-28">
            <div class="grid gap-14 lg:grid-cols-[minmax(0,1.08fr)_minmax(24rem,0.92fr)] lg:items-center">
              <div class="min-w-0">
                <p class="font-mono text-xs tracking-[0.12em] text-zinc-600 uppercase">
                  Open-source repository intelligence
                </p>
                <h1 class="mt-5 max-w-[16ch] text-4xl font-semibold tracking-[-0.04em] text-balance sm:text-6xl lg:text-7xl">
                  Growth is visible. Maintenance cost usually isn’t.
                </h1>
                <p class="mt-6 max-w-[56ch] text-lg/8 text-pretty text-zinc-600">
                  gitdebt puts GitHub star history, repository health, and
                  package adoption in one public report—then makes every signal
                  easy to compare, export, and embed.
                </p>

                <div id="lookup" class="mt-9 scroll-mt-24">
                  <LandingRepoLookup client:load />
                </div>

                <dl class="mt-8 grid grid-cols-3 border-t border-zinc-300 pt-4">
                  <div class="min-w-0">
                    <dt class="font-mono text-xs text-zinc-500 uppercase">Access</dt>
                    <dd class="mt-1 text-sm font-medium">No login</dd>
                  </div>
                  <div class="min-w-0 border-l border-zinc-200 pl-4">
                    <dt class="font-mono text-xs text-zinc-500 uppercase">Output</dt>
                    <dd class="mt-1 text-sm font-medium">README-ready</dd>
                  </div>
                  <div class="min-w-0 border-l border-zinc-200 pl-4">
                    <dt class="font-mono text-xs text-zinc-500 uppercase">License</dt>
                    <dd class="mt-1 text-sm font-medium">Open source</dd>
                  </div>
                </dl>
              </div>

              <SignalFlowGraphic client:load />
            </div>
          </div>
        </section>

        <section id="live" class="scroll-mt-20 border-b border-zinc-300">
          <div class="mx-auto max-w-6xl px-6 py-20 sm:py-28">
            <header class="grid gap-6 lg:grid-cols-[0.75fr_1.25fr] lg:items-end">
              <p class="font-mono text-xs tracking-[0.12em] text-zinc-500 uppercase">
                Live on gitdebt
              </p>
              <div>
                <h2 class="max-w-[22ch] text-3xl font-semibold tracking-[-0.035em] text-balance sm:text-5xl">
                  Real repositories. Real queue state. No canned showcase.
                </h2>
                <p class="mt-5 max-w-[62ch] text-base/7 text-pretty text-zinc-600">
                  These are repositories people recently opened on the platform.
                  Move through the list to inspect stored stars and whether each
                  history and health report is ready or actively being built.
                </p>
              </div>
            </header>
            <div class="mt-12">
              <PlatformPulse client:load apiBase={apiBase} />
            </div>
          </div>
        </section>

        <section id="how-it-works" class="scroll-mt-20 border-b border-zinc-300">
          <div class="mx-auto max-w-6xl px-6 py-20 sm:py-28">
            <header class="grid gap-6 lg:grid-cols-[0.75fr_1.25fr] lg:items-end">
              <p class="font-mono text-xs tracking-[0.12em] text-zinc-500 uppercase">
                One repository, read in layers
              </p>
              <div>
                <h2 class="max-w-[24ch] text-3xl font-semibold tracking-[-0.035em] text-balance sm:text-5xl">
                  A star count tells you what is popular. The history tells you why it matters.
                </h2>
                <p class="mt-5 max-w-[64ch] text-base/7 text-pretty text-zinc-600">
                  Popularity, adoption, and maintenance are different signals.
                  gitdebt keeps them separate so a dependency review, project
                  comparison, or launch retrospective starts with evidence.
                </p>
              </div>
            </header>

            <ol id="features" role="list" class="mt-14 scroll-mt-24 border-y border-black">
              {reportLayers.map((layer) => (
                <li class="grid gap-5 border-b border-zinc-300 py-8 last:border-b-0 md:grid-cols-[4rem_0.8fr_1.2fr_auto] md:items-start">
                  <p class="font-mono text-xs text-zinc-500">{layer.number}</p>
                  <h3 class="max-w-[18ch] text-xl font-medium tracking-tight">
                    {layer.title}
                  </h3>
                  <p class="max-w-[62ch] text-base/7 text-pretty text-zinc-600 sm:text-sm/6">
                    {layer.desc}
                  </p>
                  <a
                    href={layer.link}
                    class="group inline-flex min-h-11 items-center gap-2 self-start border-b border-zinc-300 font-mono text-sm outline-none hover:border-black focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-black sm:min-h-0"
                  >
                    {layer.linkLabel}
                    <ArrowRight
                      className="size-4 transition-transform duration-150 group-hover:translate-x-0.5 motion-reduce:transition-none"
                      strokeWidth={1.75}
                      aria-hidden="true"
                    />
                  </a>
                </li>
              ))}
            </ol>
          </div>
        </section>

        <section id="compare" class="scroll-mt-20 border-b border-zinc-300">
          <div class="mx-auto max-w-6xl px-6 py-20 sm:py-28">
            <div class="grid gap-12 lg:grid-cols-[0.82fr_1.18fr] lg:items-start">
              <header class="lg:sticky lg:top-24">
                <GitCompareArrows className="size-7 text-black" strokeWidth={1.5} aria-hidden="true" />
                <p class="mt-6 font-mono text-xs tracking-[0.12em] text-zinc-500 uppercase">
                  Compare without flattening
                </p>
                <h2 class="mt-4 max-w-[18ch] text-3xl font-semibold tracking-[-0.035em] text-balance sm:text-5xl">
                  Totals reward age. Trajectories reveal momentum.
                </h2>
                <p class="mt-5 max-w-[48ch] text-base/7 text-pretty text-zinc-600">
                  Switch between real calendar time and an equal-start view.
                  The same star timestamps answer two different questions:
                  who grew when, and who grew fastest after launch.
                </p>
                <a
                  href="/compare"
                  class="group mt-7 inline-flex min-h-12 items-center gap-2 bg-black px-5 text-sm font-medium text-white outline-none hover:bg-zinc-800 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-black"
                >
                  Build a comparison
                  <ArrowRight
                    className="size-4 transition-transform duration-150 group-hover:translate-x-0.5 motion-reduce:transition-none"
                    strokeWidth={1.75}
                    aria-hidden="true"
                  />
                </a>
              </header>

              <div>
                <ComparisonModeGraphic client:idle />

                <div class="mt-10 grid gap-10 sm:grid-cols-2">
                  <section>
                    <h3 class="font-mono text-xs tracking-wide text-zinc-500 uppercase">
                      Head to head
                    </h3>
                    <ul role="list" class="mt-4 border-y border-black">
                      {popularPairs.map((pair) => (
                        <li class="border-b border-zinc-200 last:border-b-0">
                          <a
                            href={`/vs/${pair.repos[0]}/${pair.repos[1]}`}
                            data-warm-repos={pair.repos.join(",")}
                            class="group flex min-h-14 items-center justify-between gap-4 py-3 font-mono text-sm outline-none focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-black"
                          >
                            <span>{pair.label}</span>
                            <ArrowRight
                              className="size-4 shrink-0 text-zinc-400 transition-transform duration-150 group-hover:translate-x-0.5 group-hover:text-black motion-reduce:transition-none"
                              strokeWidth={1.75}
                              aria-hidden="true"
                            />
                          </a>
                        </li>
                      ))}
                    </ul>
                  </section>

                  <section>
                    <h3 class="font-mono text-xs tracking-wide text-zinc-500 uppercase">
                      Curated fields
                    </h3>
                    <ul role="list" class="mt-4 border-y border-black">
                      {featuredCategories.map((category) => (
                        <li class="border-b border-zinc-200 last:border-b-0">
                          <a
                            href={`/compare/${category.slug}`}
                            data-warm-repos={category.repos.join(",")}
                            class="group flex min-h-14 items-center justify-between gap-4 py-3 outline-none focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-black"
                          >
                            <div class="text-sm">
                              <span class="font-medium">{category.name}</span>
                              <div class="mt-0.5 text-zinc-500">
                                {category.repos.length} repositories
                              </div>
                            </div>
                            <ArrowRight
                              className="size-4 shrink-0 text-zinc-400 transition-transform duration-150 group-hover:translate-x-0.5 group-hover:text-black motion-reduce:transition-none"
                              strokeWidth={1.75}
                              aria-hidden="true"
                            />
                          </a>
                        </li>
                      ))}
                    </ul>
                  </section>
                </div>
              </div>
            </div>
          </div>
        </section>

        <section id="share" class="scroll-mt-20 border-b border-zinc-300">
          <div class="mx-auto max-w-6xl px-6 py-20 sm:py-28">
            <div class="grid gap-12 lg:grid-cols-[1.08fr_0.92fr] lg:items-start">
              <ThemeEmbedPreview client:idle />

              <div>
                <Code2 className="size-7 text-black" strokeWidth={1.5} aria-hidden="true" />
                <p class="mt-6 font-mono text-xs tracking-[0.12em] text-zinc-500 uppercase">
                  Share the evidence
                </p>
                <h2 class="mt-4 max-w-[18ch] text-3xl font-semibold tracking-[-0.035em] text-balance sm:text-5xl">
                  A report is more useful when it travels.
                </h2>
                <p class="mt-5 max-w-[50ch] text-base/7 text-pretty text-zinc-600">
                  Every chart, stat card, and badge has stable light and dark
                  assets. Copy a GitHub-ready <code class="font-mono text-black"
                    >&lt;picture&gt;</code
                  > snippet or choose GIF when an animated raster is the better fit.
                </p>
                <a
                  href="/badges"
                  class="group mt-7 inline-flex min-h-11 items-center gap-2 border-b border-zinc-300 font-mono text-sm outline-none hover:border-black focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-black sm:min-h-0"
                >
                  Open the badge studio
                  <ArrowRight
                    className="size-4 transition-transform duration-150 group-hover:translate-x-0.5 motion-reduce:transition-none"
                    strokeWidth={1.75}
                    aria-hidden="true"
                  />
                </a>
              </div>
            </div>

            <section id="extension" class="mt-16 scroll-mt-20 border-y border-black">
              <div class="grid gap-6 py-8 md:grid-cols-[3rem_0.8fr_1.2fr_auto] md:items-start">
                <AppWindow className="size-6 text-black" strokeWidth={1.5} aria-hidden="true" />
                <h3 class="text-xl font-medium tracking-tight">
                  Read gitdebt without leaving GitHub
                </h3>
                <p class="max-w-[62ch] text-base/7 text-pretty text-zinc-600 sm:text-sm/6">
                  The browser extension places star history and repository
                  health on the GitHub pages you already use. It follows
                  GitHub’s light or dark appearance and requires no gitdebt account.
                </p>
                <div class="flex flex-wrap gap-x-5 gap-y-3">
                  <a
                    href={EXTENSION_CHROME_URL}
                    rel="noopener"
                    class="inline-flex min-h-11 items-center gap-2 border-b border-zinc-300 font-mono text-sm outline-none hover:border-black focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-black sm:min-h-0"
                  >
                    Chrome
                    <AppWindow className="size-4" strokeWidth={1.5} aria-hidden="true" />
                  </a>
                  <a
                    href={EXTENSION_FIREFOX_URL}
                    rel="noopener"
                    class="inline-flex min-h-11 items-center gap-2 border-b border-zinc-300 font-mono text-sm outline-none hover:border-black focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-black sm:min-h-0"
                  >
                    Firefox
                    <Globe className="size-4" strokeWidth={1.5} aria-hidden="true" />
                  </a>
                </div>
              </div>
            </section>
          </div>
        </section>

        <section class="bg-black text-white">
          <div class="mx-auto grid max-w-6xl gap-8 px-6 py-16 sm:py-20 md:grid-cols-[1fr_auto] md:items-end">
            <div>
              <ChartNoAxesCombined className="size-7 text-white" strokeWidth={1.5} aria-hidden="true" />
              <h2 class="mt-6 max-w-[18ch] text-3xl font-semibold tracking-[-0.035em] text-balance sm:text-5xl">
                Start with a repository you already know.
              </h2>
              <p class="mt-4 max-w-[52ch] text-base/7 text-zinc-400">
                The public report is free to view, compare, export, and share.
              </p>
            </div>
            <a
              href="#lookup"
              class="group inline-flex min-h-12 items-center justify-center gap-2 border border-white px-5 text-sm font-medium text-white outline-none hover:bg-white hover:text-black focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
            >
              Analyze a repository
              <ArrowRight
                className="size-4 transition-transform duration-150 group-hover:translate-x-0.5 motion-reduce:transition-none"
                strokeWidth={1.75}
                aria-hidden="true"
              />
            </a>
          </div>
        </section>

        <WarmRepos client:load apiBase={apiBase} repos={landingWarmRepos} />
      </main>

      <SiteFooter />
    </div>
  </body>
</html>
