---
import Sheet from "@/layouts/Sheet.astro";
import { catalogReposFor, staticLoginPaths } from "@/lib/build-catalog";
import { loadBuildProfileSnapshot } from "@/lib/build-profile-snapshot";
import { staticApiBase } from "@/lib/static-api-base";
import {
  LiveUserProfile,
  type UserAnalyze,
  type UserStats,
} from "@/components/LiveUserProfile";
import { CAPTION, MEASURE } from "@/components/style-tokens";
import { profileLogin } from "@/lib/static-routing.mjs";
import { firstStarYear } from "@/lib/star-insights";

export async function getStaticPaths() {
  return staticLoginPaths();
}

const login = profileLogin(Astro.params.login ?? "");
if (!login) {
  return new Response("Not found", { status: 404 });
}

const apiBase = staticApiBase();
const site = (Astro.site ?? new URL("https://gitdebt.com")).href.replace(/\/$/, "");
const canonicalPath = `/${login}`;
const canonical = `${site}${canonicalPath}`;

// Shared with the Markdown representation of this same profile, so the two
// routes cost the build one snapshot between them rather than one each.
const snapshot = await loadBuildProfileSnapshot(login);
if (snapshot.notFound) {
  return new Response("User not found", { status: 404 });
}
const data: UserAnalyze | null = snapshot.analyze;
const stats: UserStats | null = snapshot.stats;
const fetchError = snapshot.error;

// The build catalog is already loaded and memoized for `getStaticPaths`, so
// linking a maintainer's tracked repos costs no extra request.
const ownedRepos = data ? await catalogReposFor(login) : [];

const hasData = data !== null && data.repos_included > 0 && data.history.length > 0;
const firstYear = stats?.since_year ?? (data ? firstStarYear(data.history) : null);

const title = `${login} — GitHub star history and repo health · gitdebt`;

/**
 * A login can be 39 characters, so the enumeration is the part that gives way
 * rather than Seo's truncation cutting the tail mid-clause.
 */
function fitDescription(head: string, tails: string[], limit = 160): string {
  for (const tail of tails) {
    const composed = `${head} ${tail}`;
    if (composed.length <= limit) return composed;
  }
  return head;
}

const description = hasData
  ? fitDescription(
      `${login}: ${data!.total_stars.toLocaleString()} GitHub stars across ${data!.repos_included} public repos${
        firstYear ? ` since ${firstYear}` : ""
      }.`,
      [
        "Aggregate star history, commit activity, language footprint, and embeddable README assets.",
        "Aggregate star history, commit activity, and embeddable README assets.",
        "Aggregate star history and commit activity.",
      ],
    )
  : `Aggregate GitHub star history for ${login}'s public repos, with commit activity and embeddable README assets.`;

const ogImage = `${apiBase}/api/users/${login}/og.png`;

const noindex = !hasData || fetchError !== null;

const jsonLd: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: `${login} — star history and repo health`,
    url: canonical,
    description,
    about: {
      "@type": "Thing",
      name: login,
      sameAs: `https://github.com/${login}`,
    },
    ...(hasData && {
      mainEntity: {
        "@type": "ItemList",
        // `numberOfItems` is the size of the list this page actually provides.
        // `repos_included` is how many repositories the aggregate covered, and
        // the elements are hard-capped at 24, so asserting it here claimed a
        // list the markup does not carry for any maintainer above the cap.
        name: `${login}'s tracked GitHub repositories`,
        numberOfItems: ownedRepos.length,
        itemListElement: ownedRepos.map((slug, index) => ({
          "@type": "ListItem",
          position: index + 1,
          name: slug,
          url: `${site}/${slug}`,
        })),
      },
    }),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "gitdebt", item: `${site}/` },
      { "@type": "ListItem", position: 2, name: login, item: canonical },
    ],
  },
];
---

<Sheet
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  ogImage={ogImage}
  noindex={noindex}
  jsonLd={jsonLd}
>
  <section class="registered bg-paper">
    <div class="mx-auto w-full max-w-6xl px-6 pt-8 pb-16">
      <nav aria-label="Breadcrumb" class="font-mono text-[0.75rem] text-ink-3">
        <a
          href="/"
          class="outline-none transition-colors duration-[--duration-ui] hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-signal"
          >gitdebt</a
        >
        <span class="px-1.5 text-rule-strong" aria-hidden="true">/</span>
        <span class="text-ink">{login}</span>
      </nav>

      <div class="mt-6">
        <LiveUserProfile
          client:load
          apiBase={apiBase}
          login={login}
          siteOrigin={site}
          analyze={data}
          stats={stats}
          repos={ownedRepos}
        />
      </div>

      {/* No source marker here, deliberately. This curve sums many
          repositories whose series were read differently, and the aggregate
          payload carries no per-repository source, so a single mark over it
          would be a claim gitdebt cannot make. */}
      {hasData && (
        <p class:list={["mt-8", CAPTION, MEASURE]}>
          This aggregate sums star series whose source differs per repository.
          Each repository's own sheet names its source and coverage date.
        </p>
      )}
    </div>
  </section>
</Sheet>
