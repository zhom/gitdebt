---
export const prerender = true;

import "@/styles/globals.css";
import BaseHead from "@/components/BaseHead.astro";
import Seo from "@/components/Seo.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import { LiveUserProfile } from "@/components/LiveUserProfile";
import { staticApiBase } from "@/lib/static-api-base";

const apiBase = staticApiBase();
const site = (Astro.site ?? new URL("https://gitdebt.com")).href.replace(/\/$/, "");
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead />
    <Seo
      title="Your GitHub profile report · gitdebt"
      description="Open a live aggregate report for your public GitHub repositories: star history, commit activity, language footprint and embeddable README assets."
      canonicalPath="/profile"
      ogImage={`${apiBase}/api/og.png`}
      noindex={true}
    />
  </head>
  <body>
    <div class="isolate flex min-h-dvh flex-col">
      <SiteHeader />
      <main id="main-content" class="mx-auto w-full max-w-6xl flex-1 px-6 py-12">
        {/*
          The signed-in login is only known to the browser, so this route renders
          the same report body as `/{login}` against the session instead of a
          build-time snapshot. One component, so the two surfaces cannot drift.
        */}
        <LiveUserProfile client:only="react" apiBase={apiBase} session siteOrigin={site} />
      </main>
      <SiteFooter />
    </div>
  </body>
</html>
