---
interface Props {
  markClass?: string;
  wordmarkClass?: string;
}

const {
  markClass = "size-8",
  wordmarkClass = "text-[0.9375rem] font-semibold tracking-[-0.02em]",
} = Astro.props;
---

<span class="inline-flex min-w-0 items-center gap-2">
  <span
    class:list={[
      markClass,
      "inline-block shrink-0 bg-current [mask-image:url('/logo.svg?v=3')] [mask-position:center] [mask-repeat:no-repeat] [mask-size:contain]",
    ]}
    aria-hidden="true"
  ></span>
  <span class={wordmarkClass}>gitdebt</span>
</span>
