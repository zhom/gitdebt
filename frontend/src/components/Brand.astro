---
interface Props {
  markClass?: string;
  wordmarkClass?: string;
}

const {
  markClass = "size-8",
  wordmarkClass = "text-[0.9375rem] font-semibold tracking-[-0.02em]",
} = Astro.props;
---

<span class="inline-flex min-w-0 items-center gap-2">
  <img
    src="/logo.svg"
    alt=""
    width="32"
    height="32"
    class={markClass}
    decoding="async"
  />
  <span class={wordmarkClass}>gitdebt</span>
</span>
