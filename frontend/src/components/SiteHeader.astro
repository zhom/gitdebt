---
import { Menu, X } from "lucide-react";
import Brand from "@/components/Brand.astro";
import { GitHubLoginButton } from "@/components/GitHubLoginButton";
import { NavStarCount } from "@/components/NavStarCount";
import {
  GITDEBT_REPO,
  GITDEBT_REPO_URL,
  navStarSeed,
} from "@/lib/nav-star-seed";
import { staticApiBase } from "@/lib/static-api-base";

const navLinks = [
  { label: "Analyze", href: "/#lookup" },
  { label: "Compare", href: "/compare" },
  { label: "Leaderboard", href: "/leaderboard" },
];

// gitdebt's own star count, seeded from gitdebt's own API at build time and
// refreshed live on the client. See `navStarSeed` for why it is a seed rather
// than the source of truth.
const gitdebtStars = await navStarSeed();

const apiBase = staticApiBase();
const returnTo = `${Astro.url.pathname}${Astro.url.search}`;
const loginHref = `${apiBase}/auth/github/start?return_to=${encodeURIComponent(returnTo)}`;
const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";

function isCurrent(href: string): boolean {
  const path = href.split("#")[0].replace(/\/+$/, "") || "/";
  return path !== "/" && currentPath === path;
}
---

<a
  href="#main-content"
  class="fixed top-3 left-3 z-999 inline-flex min-h-10 -translate-y-20 items-center rounded-md bg-foreground px-4 font-mono text-xs text-background focus:translate-y-0 focus-visible:ring-2 focus-visible:ring-accent/30"
>
  Skip to content
</a>

<header class="site-header chrome sticky top-0 z-50">
  <div
    class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-3 px-4 sm:px-6 lg:grid lg:grid-cols-[1fr_auto_1fr]"
  >
    <a
      href="/"
      aria-label="gitdebt homepage"
      class="inline-flex min-h-10 min-w-0 shrink-0 items-center rounded-md outline-none focus-visible:ring-2 focus-visible:ring-accent/30 focus-visible:ring-offset-4 focus-visible:ring-offset-background"
    >
      <Brand />
    </a>

    <nav class="hidden items-center gap-1 lg:flex">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            aria-current={isCurrent(link.href) ? "page" : undefined}
            class="group relative inline-flex min-h-10 items-center gap-2.5 rounded-md px-2.5 font-mono text-[12px] text-muted-foreground outline-none transition-colors duration-150 hover:bg-card/60 hover:text-foreground focus-visible:ring-2 focus-visible:ring-accent/30 aria-[current=page]:bg-card aria-[current=page]:text-foreground"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex shrink-0 items-center gap-1 justify-self-end sm:gap-2">
      <div class="hidden sm:block">
        <NavStarCount
          client:load
          stars={gitdebtStars}
          href={GITDEBT_REPO_URL}
          apiBase={apiBase}
          repo={GITDEBT_REPO}
        />
      </div>
      <div data-auth-slot>
        <div data-auth-control data-api-base={apiBase}>
          <GitHubLoginButton client:load href={loginHref} />
        </div>
      </div>
      <details class="relative lg:hidden" data-mobile-menu data-state="closed">
        <summary
          class="grid size-10 cursor-pointer list-none place-items-center rounded-md text-foreground outline-none transition-colors duration-150 hover:bg-card/60 focus-visible:ring-2 focus-visible:ring-accent/30 [&::-webkit-details-marker]:hidden"
          aria-label="Open navigation"
          aria-controls="mobile-navigation"
          aria-expanded="false"
        >
          <Menu
            className="mobile-nav-icon mobile-nav-icon-menu size-5"
            strokeWidth={1.75}
            aria-hidden="true"
          />
          <X
            className="mobile-nav-icon mobile-nav-icon-close size-5"
            strokeWidth={1.75}
            aria-hidden="true"
          />
        </summary>
        <div
          class="mobile-nav-panel absolute right-0 mt-2 w-[min(18rem,calc(100vw-2rem))] origin-top-right rounded-lg border border-border/80 bg-card p-2 text-popover-foreground shadow-[0_8px_24px_rgba(0,0,0,0.32)]"
          data-mobile-menu-panel
          aria-hidden="true"
          inert
        >
          <nav id="mobile-navigation" class="flex flex-col">
            {
              navLinks.map((link) => (
                <a
                  href={link.href}
                  aria-current={isCurrent(link.href) ? "page" : undefined}
                  class="relative flex min-h-10 items-center gap-2.5 rounded-md px-2.5 font-mono text-[12px] text-muted-foreground outline-none transition-colors duration-150 hover:bg-card/60 hover:text-foreground focus-visible:ring-2 focus-visible:ring-accent/30 aria-[current=page]:bg-card aria-[current=page]:text-foreground"
                >
                  {link.label}
                </a>
              ))
            }
          </nav>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  const CLOSE_MS = 140;

  function installMobileMenu(details: HTMLDetailsElement) {
    const summary = details.querySelector("summary");
    const panel = details.querySelector<HTMLElement>("[data-mobile-menu-panel]");
    if (!summary || !panel) return;
    const trigger = summary;
    const menuPanel = panel;

    let closeTimer: ReturnType<typeof setTimeout> | null = null;
    let openFrame: number | null = null;
    let settleFrame: number | null = null;

    function cancelOpenFrames() {
      if (openFrame !== null) cancelAnimationFrame(openFrame);
      if (settleFrame !== null) cancelAnimationFrame(settleFrame);
      openFrame = null;
      settleFrame = null;
    }

    function setPanelInteractive(interactive: boolean) {
      menuPanel.setAttribute("aria-hidden", String(!interactive));
      if (interactive) menuPanel.removeAttribute("inert");
      else menuPanel.setAttribute("inert", "");
    }

    function openMenu() {
      if (closeTimer) clearTimeout(closeTimer);
      closeTimer = null;
      cancelOpenFrames();
      details.open = true;
      details.dataset.state = "closed";
      trigger.setAttribute("aria-expanded", "true");
      trigger.setAttribute("aria-label", "Close navigation");
      setPanelInteractive(true);
      openFrame = requestAnimationFrame(() => {
        openFrame = null;
        settleFrame = requestAnimationFrame(() => {
          settleFrame = null;
          if (trigger.getAttribute("aria-expanded") === "true") {
            details.dataset.state = "open";
          }
        });
      });
    }

    function closeMenu(returnFocus = false) {
      if (!details.open) return;
      if (closeTimer) clearTimeout(closeTimer);
      cancelOpenFrames();
      details.dataset.state = "closed";
      trigger.setAttribute("aria-expanded", "false");
      trigger.setAttribute("aria-label", "Open navigation");
      setPanelInteractive(false);
      closeTimer = setTimeout(() => {
        details.open = false;
        closeTimer = null;
        if (returnFocus) trigger.focus();
      }, CLOSE_MS);
    }

    trigger.addEventListener("click", (event) => {
      event.preventDefault();
      if (trigger.getAttribute("aria-expanded") === "true") closeMenu();
      else openMenu();
    });

    document.addEventListener("pointerdown", (event) => {
      if (!details.contains(event.target as Node)) closeMenu();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && details.open) {
        event.preventDefault();
        closeMenu(true);
      }
    });

    menuPanel.addEventListener("click", (event) => {
      if ((event.target as Element).closest("a")) closeMenu();
    });
  }

  document
    .querySelectorAll<HTMLDetailsElement>("[data-mobile-menu]")
    .forEach(installMobileMenu);
</script>

<script>
  type SessionUser = {
    login?: string;
    name?: string | null;
    avatar_url?: string | null;
  };

  const ACCOUNT_TRIGGER =
    "relative isolate inline-flex min-h-10 cursor-pointer list-none items-center justify-center gap-2 overflow-hidden rounded-md border border-border/60 px-3 py-2 font-mono text-xs whitespace-nowrap text-foreground outline-none transition-[opacity,scale] active:scale-[0.96] motion-reduce:transition-none focus-visible:ring-2 focus-visible:ring-accent/30 focus-visible:ring-offset-2 focus-visible:ring-offset-background [&::-webkit-details-marker]:hidden";
  const ACCOUNT_MENU =
    "absolute right-0 z-50 mt-2 w-72 rounded-lg border border-border/80 bg-card p-2 text-popover-foreground shadow-[0_8px_24px_rgba(0,0,0,0.32)]";
  const ACCOUNT_ITEM =
    "flex min-h-9 w-full items-center rounded-md px-2.5 text-left font-mono text-[12px] text-muted-foreground outline-none hover:bg-card/60 hover:text-foreground focus-visible:ring-2 focus-visible:ring-accent/30";

  function element<K extends keyof HTMLElementTagNameMap>(
    tag: K,
    className?: string,
  ): HTMLElementTagNameMap[K] {
    const node = document.createElement(tag);
    if (className) node.className = className;
    return node;
  }

  function accountMenu(user: SessionUser, apiBase: string) {
    const login = user.login!.toLowerCase();
    const details = element("details", "group relative");
    const trigger = element("summary", ACCOUNT_TRIGGER);
    trigger.setAttribute("aria-label", `Open account menu for ${login}`);

    if (user.avatar_url) {
      const avatar = element("img", "size-6 rounded-full [image-rendering:auto]");
      avatar.src = user.avatar_url;
      avatar.alt = "";
      avatar.width = 24;
      avatar.height = 24;
      trigger.append(avatar);
    }

    const loginText = element("span", "hidden max-w-28 truncate sm:inline");
    loginText.textContent = login;
    trigger.append(loginText);

    const caret = element(
      "span",
      "hidden text-muted-foreground transition-transform duration-150 group-open:rotate-180 sm:inline",
    );
    caret.textContent = "⌄";
    caret.setAttribute("aria-hidden", "true");
    trigger.append(caret);

    const menu = element("div", ACCOUNT_MENU);
    const identity = element("div", "px-2.5 py-2");
    const name = element("p", "truncate text-[13px]");
    name.textContent = user.name || login;
    const handle = element(
      "p",
      "truncate font-mono text-[11px] text-muted-foreground",
    );
    handle.textContent = `@${login}`;
    identity.append(name, handle);

    const divider = element("div", "my-1.5 h-px bg-border/40");
    divider.setAttribute("aria-hidden", "true");

    const profile = element("a", ACCOUNT_ITEM);
    profile.href = `/${encodeURIComponent(login)}`;
    profile.textContent = "Your profile report";

    const signOut = element("button", ACCOUNT_ITEM);
    signOut.type = "button";
    signOut.textContent = "Sign out";
    signOut.addEventListener("click", async () => {
      try {
        await fetch(`${apiBase}/auth/logout`, {
          method: "POST",
          credentials: "include",
          redirect: "manual",
        });
      } finally {
        location.reload();
      }
    });

    menu.append(identity, divider, profile, signOut);
    details.append(trigger, menu);
    return details;
  }

  for (const root of document.querySelectorAll<HTMLElement>("[data-auth-control]")) {
    const apiBase = root.dataset.apiBase ?? "";
    const controller = new AbortController();
    fetch(`${apiBase}/api/me`, {
      credentials: "include",
      headers: { accept: "application/json" },
      signal: controller.signal,
    })
      .then(async (response) =>
        response.ok ? ((await response.json()) as SessionUser) : null,
      )
      .then((user) => {
        if (user?.login) root.replaceChildren(accountMenu(user, apiBase));
      })
      .catch(() => undefined);
  }
</script>
