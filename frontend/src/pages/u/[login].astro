---
import "@/styles/globals.css";
import { staticLoginPaths } from "@/lib/build-catalog";
import { staticApiBase } from "@/lib/static-api-base";
import BaseHead from "@/components/BaseHead.astro";
import Seo from "@/components/Seo.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { ChartViewer } from "@/components/ChartViewer";
import { EmbedSnippet } from "@/components/EmbedSnippet";
import { StatCard } from "@/components/StatCard";
import { ProfileCardPreview } from "@/components/ProfileCardPreview";
import { LiveUserProfile } from "@/components/LiveUserProfile";
import { EYEBROW } from "@/components/style-tokens";
import {
  firstStarYear,
  formatCompact,
  gainedInTrailingDays,
  growthTrend,
} from "@/lib/star-insights";

export async function getStaticPaths() {
  return staticLoginPaths();
}

const { login: rawLogin } = Astro.params;

const validLogin = /^[A-Za-z0-9._-]{1,39}$/;
if (!rawLogin || !validLogin.test(rawLogin) || rawLogin === "." || rawLogin === "..") {
  return new Response("Not found", { status: 404 });
}
const login = rawLogin.toLowerCase();

const apiBase = staticApiBase();
const site = (Astro.site ?? new URL("https://gitdebt.com")).href.replace(/\/$/, "");
const canonicalPath = `/u/${login}`;
const canonical = `${site}${canonicalPath}`;

type UserAnalyze = {
  login: string;
  repos_included: number;
  repos_pending: number;
  total_stars: number;
  history: { date: string; stars: number }[];
};

/** Mirrors the backend `GET /api/users/:login/stats.json` contract. */
type UserRepoRow = {
  repo: string;
  stars: number;
  forks: number;
  commits: number;
  commits_recent: number;
  spark: number[];
};
type UserStats = {
  login: string;
  ready: boolean;
  repos_tracked: number;
  repos_analyzed: number;
  total_stars: number;
  total_forks: number;
  authored_commits: number;
  contributed_repos: number;
  analyzed_commits: number;
  since_year: number | null;
  solo_maintained: number;
  shared_maintained: number;
  languages: { language: string; files: number; code: number; blank: number; comment: number }[];
  top_repos: UserRepoRow[];
  active_repos: UserRepoRow[];
  commit_days: { date: string; value: number }[];
};

async function fetchJson<T>(path: string): Promise<T | null> {
  try {
    const res = await fetch(`${apiBase}${path}`, {
      headers: { accept: "application/json" },
      signal: AbortSignal.timeout(5_000),
    });
    if (!res.ok) return null;
    return (await res.json()) as T;
  } catch {
    return null;
  }
}

let data: UserAnalyze | null = null;
let fetchError: string | null = null;
try {
  const res = await fetch(`${apiBase}/api/users/${login}/analyze?enqueue=0`, {
    headers: { accept: "application/json" },
    signal: AbortSignal.timeout(5_000),
  });
  if (res.ok) {
    data = (await res.json()) as UserAnalyze;
  } else if (res.status === 404) {
    return new Response("User not found", { status: 404 });
  } else {
    fetchError = `backend returned ${res.status}`;
  }
} catch (err) {
  fetchError = err instanceof Error ? err.message : String(err);
}

// Code signals come from the Postgres-only profile aggregate. A miss is
// never fatal: the star report still renders without it.
const stats = data ? await fetchJson<UserStats>(`/api/users/${login}/stats.json`) : null;

// The sitemap feed is a best-effort source for linking tracked repos.
let ownedRepos: string[] = [];
if (data) {
  const feed = await fetchJson<{ repos?: { slug: string }[] }>(
    "/api/sitemap/repos?page=0&per=20000",
  );
  ownedRepos = (feed?.repos ?? [])
    .map((r) => r.slug)
    .filter((slug) => slug.startsWith(`${login}/`))
    .slice(0, 24);
}

const hasData = data !== null && data.repos_included > 0 && data.history.length > 0;
const sinceYear = data ? firstStarYear(data.history) : null;
const gained30 = data ? gainedInTrailingDays(data.history, 30) : null;
const gained90 = data ? gainedInTrailingDays(data.history, 90) : null;
const trend = data ? growthTrend(data.history) : null;
const firstYear = stats?.since_year ?? sinceYear;

const nf = new Intl.NumberFormat("en-US");
const num = (value: number | null | undefined) =>
  value === null || value === undefined ? "—" : nf.format(value);
const signed = (value: number | null | undefined) =>
  value === null || value === undefined ? "—" : `+${nf.format(value)}`;

/**
 * Deterministic sparkline path over a cumulative series. Returns null when
 * there is not enough history to draw an honest shape.
 */
function sparkPath(values: number[], w = 132, h = 30): string | null {
  if (!Array.isArray(values) || values.length < 3) return null;
  const min = Math.min(...values);
  const max = Math.max(...values);
  const span = max - min || 1;
  const step = w / (values.length - 1);
  return values
    .map((value, i) => {
      const x = (i * step).toFixed(1);
      const y = (h - ((value - min) / span) * h).toFixed(1);
      return `${i === 0 ? "M" : "L"}${x} ${y}`;
    })
    .join(" ");
}

const topRepos = (stats?.top_repos ?? []).filter((row) => row.stars > 0 || row.commits > 0);
const activeRepos = stats?.active_repos ?? [];
const activeMax = Math.max(1, ...activeRepos.map((row) => row.commits_recent));
const topLanguages = (stats?.languages ?? []).slice(0, 6);
const languageTotal = topLanguages.reduce(
  (sum, row) => sum + row.code + row.blank + row.comment,
  0,
);
const scoredRepos = (stats?.solo_maintained ?? 0) + (stats?.shared_maintained ?? 0);
const commitDaysTotal = (stats?.commit_days ?? []).reduce((sum, day) => sum + day.value, 0);
const hasCodeSignals = Boolean(stats?.ready);

const kpis: { label: string; value: string; note: string }[] = [
  {
    label: "Stars",
    value: hasData ? formatCompact(data!.total_stars) : "—",
    note: `across ${num(data?.repos_included ?? null)} tracked repos`,
  },
  {
    label: "Last 30 days",
    value: gained30 === null ? "—" : signed(gained30),
    note: "new stars",
  },
  {
    label: "Last 90 days",
    value: gained90 === null ? "—" : signed(gained90),
    note: trend ? `${trend} vs lifetime pace` : "new stars",
  },
  {
    label: "Commits authored",
    value: stats && stats.authored_commits > 0 ? formatCompact(stats.authored_commits) : "—",
    note:
      stats && stats.contributed_repos > 0
        ? `in ${num(stats.contributed_repos)} repos`
        : "awaiting analysis",
  },
  {
    label: "Forks",
    value: stats && stats.total_forks > 0 ? formatCompact(stats.total_forks) : "—",
    note: "across owned repos",
  },
  {
    label: "First commit",
    value: firstYear ? String(firstYear) : "—",
    note: firstYear ? "earliest tracked year" : "not observed yet",
  },
];

const signalCharts = [
  {
    name: "commit-activity",
    label: "Commit activity",
    blurb: "Every commit landed in the last 52 weeks, summed across owned repos.",
  },
  {
    name: "commit-trend",
    label: "Maintenance pulse",
    blurb: "Monthly commit volume — the shape of sustained upkeep, not a one-off push.",
  },
  {
    name: "languages",
    label: "Language footprint",
    blurb: "Lines of code by language across every analyzed repo you own.",
  },
] as const;

const title = `${login} — GitHub star history and repo health · gitdebt`;
const description = hasData
  ? `${login}'s public repos have earned ${data!.total_stars.toLocaleString()} GitHub stars${
      firstYear ? ` since ${firstYear}` : ""
    }${
      gained90 !== null && gained90 > 0 ? `, ${gained90.toLocaleString()} in the last 90 days` : ""
    }. Aggregate star history across ${data!.repos_included} repos, plus commit activity, language footprint and embeddable README assets.`
  : `Aggregate GitHub star history for ${login}'s public repos, with commit activity, language footprint and embeddable README assets.`;

const ogImage = `${apiBase}/api/users/${login}/og.png`;

const noindex = !hasData || fetchError !== null;

const jsonLd: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: `${login} — star history and repo health`,
    url: canonical,
    description,
    about: {
      "@type": "Thing",
      name: login,
      sameAs: `https://github.com/${login}`,
    },
    ...(hasData && {
      mainEntity: {
        "@type": "ItemList",
        name: `${login}'s tracked GitHub repositories`,
        numberOfItems: data!.repos_included,
        itemListElement: ownedRepos.map((slug, index) => ({
          "@type": "ListItem",
          position: index + 1,
          name: slug,
          url: `${site}/${slug}`,
        })),
      },
    }),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "gitdebt", item: `${site}/` },
      { "@type": "ListItem", position: 2, name: login, item: canonical },
    ],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead />
    <Seo
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      ogImage={ogImage}
      noindex={noindex}
      jsonLd={jsonLd}
    />
  </head>
  <body>
    <div class="isolate flex min-h-dvh flex-col">
      <SiteHeader />

      <main id="main-content" class="mx-auto w-full max-w-6xl flex-1 px-6 py-12">
        <nav aria-label="Breadcrumb" class="font-mono text-[11px] text-muted-foreground">
          <a
            href="/"
            class="rounded outline-none transition-colors duration-150 hover:text-foreground focus-visible:ring-2 focus-visible:ring-accent/30"
            >gitdebt</a
          >
          <span class="px-1.5 text-border" aria-hidden="true">/</span>
          <span class="text-foreground">u/{login}</span>
        </nav>

        {data ? (
          <header class="mt-8">
            <h1 class="text-3xl tracking-tight text-balance sm:text-4xl">{login}</h1>
            <p class="mt-3 max-w-[68ch] text-[15px] leading-relaxed text-pretty text-muted-foreground">
              {hasData ? (
                <>
                  {login}'s public repos have earned{" "}
                  <span class="text-foreground tabular-nums">
                    {data.total_stars.toLocaleString()}
                  </span>{" "}
                  GitHub stars{firstYear ? ` since ${firstYear}` : ""}
                  {gained90 !== null && gained90 > 0
                    ? `, ${gained90.toLocaleString()} of them in the last 90 days`
                    : ""}
                  , across {data.repos_included} tracked{" "}
                  {data.repos_included === 1 ? "repo" : "repos"}.
                </>
              ) : (
                <>
                  Star history for {login}'s public repos is being fetched in the
                  background. Totals appear as each repo's history completes.
                </>
              )}
            </p>
            <div class="mt-5 flex flex-wrap items-center gap-2">
              <a
                href={`https://github.com/${login}`}
                rel="noopener"
                class="dither-chip min-h-9 rounded-md px-2.5 text-[11px] normal-case outline-none transition-colors duration-150 hover:bg-card/60 hover:text-foreground focus-visible:ring-2 focus-visible:ring-accent/30"
              >
                github.com/{login}
              </a>
              <a
                href="#readme-assets"
                class="dither-chip min-h-9 rounded-md px-2.5 text-[11px] normal-case outline-none transition-colors duration-150 hover:bg-card/60 hover:text-foreground focus-visible:ring-2 focus-visible:ring-accent/30"
              >
                README assets
              </a>
            </div>
          </header>
        ) : (
          <div class="mt-8">
            <LiveUserProfile client:load apiBase={apiBase} login={login} />
          </div>
        )}

        {data && (
          <section class="mt-12" aria-label="Profile summary">
            <dl class="grid grid-cols-2 divide-border/40 rounded-lg border border-border/60 bg-background/40 p-3.5 sm:grid-cols-3 sm:divide-x lg:grid-cols-6">
              {kpis.map((kpi) => (
                <div class="px-3.5 py-2">
                  <dt class={EYEBROW}>{kpi.label}</dt>
                  <dd class="mt-2 text-[19px] leading-none tracking-tight tabular-nums text-foreground">
                    {kpi.value}
                  </dd>
                  <p class="mt-2 text-[11px] leading-relaxed text-muted-foreground">{kpi.note}</p>
                </div>
              ))}
            </dl>
          </section>
        )}

        {data && (
          <section class="mt-16 scroll-mt-24" id="star-history">
            <div class="flex items-baseline justify-between gap-4">
              <h2 class="text-lg tracking-tight">Star history</h2>
              <p class="font-mono text-[11px] text-muted-foreground">
                summed across {num(data.repos_included)} repos
              </p>
            </div>
            <div class="mt-6">
              <ChartViewer
                client:load
                apiBase={apiBase}
                path={`/api/users/${login}/chart.svg`}
                alt={`Aggregate star history across ${login}'s public repos`}
                caption="Aggregate star history"
                embedLink={canonical}
                label={login}
                points={data.history}
              />
            </div>
          </section>
        )}

        {topRepos.length > 0 && (
          <section class="mt-16 scroll-mt-24" id="top-repositories">
            <div class="flex items-baseline justify-between gap-4">
              <h2 class="text-lg tracking-tight">Top repositories</h2>
              <a
                href="/leaderboard"
                class="rounded font-mono text-[11px] text-muted-foreground outline-none transition-colors duration-150 hover:text-foreground focus-visible:ring-2 focus-visible:ring-accent/30"
              >
                leaderboard →
              </a>
            </div>
            <ul class="mt-6">
              {topRepos.map((row) => {
                const path = sparkPath(row.spark);
                return (
                  <li class="border-b border-border/40 last:border-0">
                    <a
                      href={`/${row.repo}`}
                      class="group flex items-center gap-4 rounded-md px-2.5 py-3 outline-none transition-colors duration-150 hover:bg-card/60 focus-visible:ring-2 focus-visible:ring-accent/30"
                    >
                      <span class="min-w-0 flex-1">
                        <span class="block truncate font-mono text-[12px] text-muted-foreground transition-colors group-hover:text-foreground">
                          {row.repo}
                        </span>
                        <span class="mt-1 block font-mono text-[11px] text-muted-foreground/80 tabular-nums">
                          {num(row.stars)} stars
                          {row.forks > 0 ? ` · ${num(row.forks)} forks` : ""}
                          {row.commits > 0 ? ` · ${num(row.commits)} commits` : ""}
                        </span>
                      </span>
                      {path ? (
                        <svg
                          class="h-[30px] w-[132px] shrink-0 text-foreground/45 transition-colors duration-150 group-hover:text-foreground/80"
                          viewBox="0 0 132 30"
                          fill="none"
                          aria-hidden="true"
                          preserveAspectRatio="none"
                        >
                          <path
                            d={path}
                            stroke="currentColor"
                            stroke-width="1.25"
                            stroke-linejoin="round"
                            vector-effect="non-scaling-stroke"
                          />
                        </svg>
                      ) : (
                        <span class="hidden w-[132px] shrink-0 text-right font-mono text-[10px] tracking-[0.08em] text-muted-foreground/70 uppercase sm:block">
                          history pending
                        </span>
                      )}
                    </a>
                  </li>
                );
              })}
            </ul>
            <p class="mt-3 text-[13px] leading-relaxed text-pretty text-muted-foreground">
              Sparklines plot cumulative stars by month, and only render once a
              repository's full star history is cached — a partial series would
              draw a shape that isn't real.
            </p>
          </section>
        )}

        {hasCodeSignals && (
          <section class="mt-16 scroll-mt-24" id="code-signals">
            <div class="flex items-baseline justify-between gap-4">
              <h2 class="text-lg tracking-tight">Code signals</h2>
              <p class="font-mono text-[11px] text-muted-foreground">
                {num(stats!.repos_analyzed)} of {num(stats!.repos_tracked)} repos analyzed
              </p>
            </div>
            <p class="mt-2 max-w-[70ch] text-[13px] leading-relaxed text-pretty text-muted-foreground">
              Aggregated from cached git history across every repo {login} owns.
              Each chart is embeddable — use its “Add to README”.
            </p>
            <div class="mt-6 grid gap-8 sm:grid-cols-2">
              {signalCharts.map((chart, index) => (
                <div class={index === 0 ? "sm:col-span-2" : ""}>
                  <StatCard
                    client:visible
                    src={`${apiBase}/api/users/${login}/stats/${chart.name}.svg`}
                    alt={`${chart.label} for ${login}`}
                    caption={chart.label}
                    apiBase={apiBase}
                    embedLink={canonical}
                  />
                  <p class="mt-2.5 px-1 text-[11px] leading-relaxed text-pretty text-muted-foreground">
                    {chart.blurb}
                  </p>
                </div>
              ))}
            </div>
          </section>
        )}

        {hasCodeSignals && (
          <section class="mt-16 scroll-mt-24" id="maintenance">
            <div class="flex items-baseline justify-between gap-4">
              <h2 class="text-lg tracking-tight">Maintenance footprint</h2>
              <p class="font-mono text-[11px] text-muted-foreground">bots excluded</p>
            </div>
            <dl class="mt-6 grid grid-cols-2 divide-border/40 rounded-lg border border-border/60 bg-background/40 p-3.5 sm:grid-cols-4 sm:divide-x">
              <div class="px-3.5 py-2">
                <dt class={EYEBROW}>Solo-carried</dt>
                <dd class="mt-2 text-[19px] leading-none tracking-tight tabular-nums text-foreground">
                  {num(stats!.solo_maintained)}
                </dd>
                <p class="mt-2 text-[11px] leading-relaxed text-muted-foreground">
                  {scoredRepos > 0
                    ? `of ${num(scoredRepos)} scored repos, one person holds over half the commits`
                    : "not scored yet"}
                </p>
              </div>
              <div class="px-3.5 py-2">
                <dt class={EYEBROW}>Shared</dt>
                <dd class="mt-2 text-[19px] leading-none tracking-tight tabular-nums text-foreground">
                  {num(stats!.shared_maintained)}
                </dd>
                <p class="mt-2 text-[11px] leading-relaxed text-muted-foreground">
                  more than one author needed to reach half the commits
                </p>
              </div>
              <div class="px-3.5 py-2">
                <dt class={EYEBROW}>Commits (52w)</dt>
                <dd class="mt-2 text-[19px] leading-none tracking-tight tabular-nums text-foreground">
                  {commitDaysTotal > 0 ? formatCompact(commitDaysTotal) : "—"}
                </dd>
                <p class="mt-2 text-[11px] leading-relaxed text-muted-foreground">
                  landed across owned repos in the last 52 weeks
                </p>
              </div>
              <div class="px-3.5 py-2">
                <dt class={EYEBROW}>Analyzed commits</dt>
                <dd class="mt-2 text-[19px] leading-none tracking-tight tabular-nums text-foreground">
                  {stats!.analyzed_commits > 0 ? formatCompact(stats!.analyzed_commits) : "—"}
                </dd>
                <p class="mt-2 text-[11px] leading-relaxed text-muted-foreground">
                  total commit history gitdebt has read
                </p>
              </div>
            </dl>

            {activeRepos.length > 0 && (
              <div class="mt-8">
                <h3 class={EYEBROW}>Most active · last 90 days</h3>
                <ul class="mt-3">
                  {activeRepos.map((row) => (
                    <li class="border-b border-border/40 last:border-0">
                      <a
                        href={`/${row.repo}`}
                        class="group flex h-10 items-center gap-3 rounded-md px-2.5 font-mono text-[12px] text-muted-foreground outline-none transition-colors duration-150 hover:bg-card/60 hover:text-foreground focus-visible:ring-2 focus-visible:ring-accent/30"
                      >
                        <span class="min-w-0 flex-1 truncate">{row.repo}</span>
                        <span
                          class="hidden h-1.5 shrink-0 rounded-[1px] bg-foreground/30 transition-colors duration-150 group-hover:bg-foreground/60 sm:block"
                          style={`width: ${Math.max(6, Math.round((row.commits_recent / activeMax) * 120))}px`}
                          aria-hidden="true"
                        ></span>
                        <span class="shrink-0 rounded border border-border/60 px-1 text-[10px] tabular-nums">
                          {num(row.commits_recent)}
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {topLanguages.length > 0 && (
              <div class="mt-8">
                <h3 class={EYEBROW}>Languages across owned repos</h3>
                <div class="mt-3 flex flex-wrap gap-2">
                  {topLanguages.map((row) => {
                    const total = row.code + row.blank + row.comment;
                    const share =
                      languageTotal > 0 ? Math.round((total / languageTotal) * 100) : 0;
                    return (
                      <span class="dither-chip">
                        {row.language}
                        <span class="text-foreground/70">{share > 0 ? `${share}%` : "—"}</span>
                      </span>
                    );
                  })}
                </div>
              </div>
            )}
          </section>
        )}

        {data && (
          <section class="mt-16 scroll-mt-24" id="readme-assets">
            <div class="flex items-baseline justify-between gap-4">
              <h2 class="text-lg tracking-tight">Add to your README</h2>
              <p class="font-mono text-[11px] text-muted-foreground">svg · png · webp</p>
            </div>
            <p class="mt-2 max-w-[70ch] text-[13px] leading-relaxed text-pretty text-muted-foreground">
              Every profile asset ships light and dark variants behind a
              <code class="font-mono text-[12px] text-foreground">&lt;picture&gt;</code> element, so
              they follow the reader's GitHub theme. Copy a snippet and paste it
              into your profile README.
            </p>

            <div class="mt-6 rounded-lg border border-border/60 bg-background/40 p-3.5">
              <div class="flex flex-wrap items-baseline justify-between gap-3 px-1">
                <h3 class={EYEBROW}>Profile card</h3>
                <EmbedSnippet
                  client:visible
                  apiBase={apiBase}
                  chartPath={`/api/users/${login}/card.svg`}
                  linkHref={canonical}
                  label={`${login}'s profile card`}
                  altText={`gitdebt profile statistics for ${login}`}
                  variant="menu"
                />
              </div>
              <div class="mt-5 flex justify-center">
                <ProfileCardPreview
                  client:visible
                  apiBase={apiBase}
                  login={login}
                  initialRevision={`${data.total_stars}-${data.repos_included}-${data.repos_pending}`}
                />
              </div>
            </div>

            <ul class="mt-8">
              <li class="border-b border-border/40">
                <div class="flex h-12 items-center gap-3 px-2.5">
                  <span class="min-w-0 flex-1 truncate font-mono text-[12px] text-muted-foreground">
                    Aggregate star history
                  </span>
                  <EmbedSnippet
                    client:visible
                    apiBase={apiBase}
                    chartPath={`/api/users/${login}/chart.svg`}
                    linkHref={canonical}
                    label={`${login}'s aggregate star history`}
                    altText={`Aggregate star history across ${login}'s public repos`}
                    variant="menu"
                  />
                </div>
              </li>
              {signalCharts.map((chart) => (
                <li class="border-b border-border/40 last:border-0">
                  <div class="flex h-12 items-center gap-3 px-2.5">
                    <span class="min-w-0 flex-1 truncate font-mono text-[12px] text-muted-foreground">
                      {chart.label}
                    </span>
                    <EmbedSnippet
                      client:visible
                      apiBase={apiBase}
                      chartPath={`/api/users/${login}/stats/${chart.name}.svg`}
                      linkHref={canonical}
                      label={`${chart.label} for ${login}`}
                      altText={`${chart.label} for ${login}`}
                      variant="menu"
                    />
                  </div>
                </li>
              ))}
            </ul>
          </section>
        )}

        {ownedRepos.length > 0 && (
          <section class="mt-16 scroll-mt-24" id="tracked-repos">
            <div class="flex items-baseline justify-between gap-4">
              <h2 class="text-lg tracking-tight">Tracked repos</h2>
              <a
                href="/compare"
                class="rounded font-mono text-[11px] text-muted-foreground outline-none transition-colors duration-150 hover:text-foreground focus-visible:ring-2 focus-visible:ring-accent/30"
              >
                compare →
              </a>
            </div>
            <div class="mt-6 flex flex-wrap gap-2">
              {ownedRepos.map((slug) => (
                <a
                  href={`/${slug}`}
                  class="dither-chip min-h-9 rounded-md px-2.5 text-[11px] normal-case outline-none transition-colors duration-150 hover:bg-card/60 hover:text-foreground focus-visible:ring-2 focus-visible:ring-accent/30"
                >
                  {slug}
                </a>
              ))}
            </div>
            <p class="mt-3 text-[13px] leading-relaxed text-pretty text-muted-foreground">
              Each repository page carries the full star-history chart plus
              code-health signals — churn, bug magnets, bus factor and more.
            </p>
          </section>
        )}

        <section class="mt-16 scroll-mt-24 border-t border-border/60 pt-8">
          <h2 class="text-lg tracking-tight">How this report is built</h2>
          <p class="mt-3 max-w-[70ch] text-[13px] leading-relaxed text-pretty text-muted-foreground">
            gitdebt sums the cumulative star history of {login}'s top public repos
            (up to 50, by stars) from cached public star timestamps, and derives the
            code signals from cached git history — commits, commit days, language
            line counts and author concentration. Everything on this page is read
            from gitdebt's own database; nothing here queries GitHub while you wait.
            Repos without cached history are fetched in the background and join the
            totals as they complete. Explore more on the{" "}
            <a
              href="/leaderboard"
              class="rounded underline decoration-border underline-offset-4 outline-none transition-colors duration-150 hover:decoration-foreground/60 focus-visible:ring-2 focus-visible:ring-accent/30"
            >
              repo leaderboard
            </a>{" "}
            or{" "}
            <a
              href="/compare"
              class="rounded underline decoration-border underline-offset-4 outline-none transition-colors duration-150 hover:decoration-foreground/60 focus-visible:ring-2 focus-visible:ring-accent/30"
            >
              compare star history
            </a>{" "}
            across repos.
          </p>
        </section>
      </main>

      <SiteFooter />
    </div>
  </body>
</html>
