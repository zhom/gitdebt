---
import Brand from "@/components/Brand.astro";

/**
 * The footer is the sheet's title block.
 *
 * A technical drawing states, in a ruled block at the foot of the sheet, who
 * drew it, what it is of, and when. That is exactly what a footer is for, so
 * this one is drawn as one: a grid whose cells are divided by real rules,
 * because each rule separates two real fields.
 *
 * What this replaces was the standard footer — wordmark, tagline, three columns
 * of link lists under tracked-out mono labels, a divider, a copyright row — sat
 * on two blurred gradient blobs and an animated character-field mark. The blobs
 * and the mark are gone. So are the seven category links: they are one click
 * away on /compare, and a footer that lists every category is a sitemap
 * wearing a footer's clothes.
 */

const year = new Date().getFullYear();

const explore = [
  { label: "Compare repositories", href: "/compare" },
  { label: "Leaderboard", href: "/leaderboard" },
  { label: "README badges", href: "/badges" },
  { label: "How it works", href: "/#how-it-works" },
];

const legal = [
  { label: "About", href: "/about" },
  { label: "Privacy", href: "/privacy" },
  { label: "Terms", href: "/terms" },
];
---

<footer class="mt-24 bg-table">
  <div class="mx-auto max-w-6xl px-6">
    <!--
      The block itself. `divide-*` draws the internal rules, so every line in
      here has a field on each side of it.
    -->
    <div
      class="grid grid-cols-1 border border-rule-strong bg-paper sm:grid-cols-2 lg:grid-cols-4 lg:divide-x divide-y lg:divide-y-0 divide-rule"
    >
      <section class="p-5">
        <p class="drafted">Drawn by</p>
        <a
          href="/"
          aria-label="gitdebt homepage"
          class="mt-3 inline-flex min-h-10 items-center outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-signal"
        >
          <Brand />
        </a>
        <p class="mt-2 text-[0.8125rem] leading-[1.55] text-ink-2 [text-wrap:pretty]">
          Star history and repository health for any public GitHub repository.
        </p>
      </section>

      <nav class="p-5" aria-label="Explore">
        <p class="drafted">Sheets</p>
        <ul role="list" class="mt-3 flex flex-col">
          {
            explore.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="-mx-2 flex min-h-10 items-center px-2 text-[0.8125rem] text-ink-2 outline-none transition-colors duration-[--duration-ui] hover:bg-table hover:text-ink focus-visible:outline-2 focus-visible:outline-signal"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav class="p-5" aria-label="Legal">
        <p class="drafted">Notes</p>
        <ul role="list" class="mt-3 flex flex-col">
          {
            legal.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="-mx-2 flex min-h-10 items-center px-2 text-[0.8125rem] text-ink-2 outline-none transition-colors duration-[--duration-ui] hover:bg-table hover:text-ink focus-visible:outline-2 focus-visible:outline-signal"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <section class="p-5">
        <p class="drafted">Sheet data</p>
        <dl class="mt-3 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1.5 text-[0.8125rem]">
          <dt class="text-ink-3">Revision</dt>
          <dd class="font-mono tabular-nums text-ink-2">{year}</dd>
          <dt class="text-ink-3">Source</dt>
          <dd class="text-ink-2">Public GitHub data</dd>
          <dt class="text-ink-3">Licence</dt>
          <dd class="text-ink-2">
            <a
              href="https://github.com/zhom/gitdebt"
              class="underline decoration-rule-strong underline-offset-[3px] outline-none transition-colors duration-[--duration-ui] hover:text-signal hover:decoration-signal focus-visible:outline-2 focus-visible:outline-signal"
              >MIT, open source</a
            >
          </dd>
        </dl>
        <p class="mt-4 text-[0.75rem] leading-[1.5] text-ink-3">
          Not affiliated with GitHub.
        </p>
      </section>
    </div>
  </div>

  <!--
    The signature. Set in the drawing's own hand, tracked out, and anchored
    flush to the bottom edge so it bleeds off the sheet.

    It is clipped at the BOTTOM only: `pt-8` and the line-height give the cap
    tops real clearance, and the negative bottom margin pushes the baseline past
    the edge. A wordmark whose cap tops are shaved is the failure this is
    written to avoid, so the clearance above is not optional.
  -->
  <div class="mt-16 overflow-hidden" aria-hidden="true">
    <p
      class="px-6 pt-8 -mb-[0.16em] text-center font-draft leading-[0.8] tracking-[0.16em] text-rule-strong select-none"
      style="font-size: clamp(3.5rem, 17vw, 13rem)"
    >
      GITDEBT
    </p>
  </div>
</footer>
