---
import "@/styles/globals.css";
import { ArrowRight } from "lucide-react";

import BaseHead from "@/components/BaseHead.astro";
import Seo from "@/components/Seo.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { CompareBuilder } from "@/components/CompareBuilder";
import { WarmRepos } from "@/components/WarmRepos";
import { CATEGORIES, CATEGORY_GROUPS } from "@/data/categories";
import { staticApiBase } from "@/lib/static-api-base";

const POPULAR_PAIRS = [
  ["facebook/react", "vuejs/vue"],
  ["denoland/deno", "oven-sh/bun"],
  ["tailwindlabs/tailwindcss", "twbs/bootstrap"],
  ["django/django", "fastapi/fastapi"],
  ["gatsbyjs/gatsby", "vercel/next.js"],
  ["actix/actix-web", "tokio-rs/axum"],
  ["ollama/ollama", "vllm-project/vllm"],
  ["microsoft/vscode", "neovim/neovim"],
].map((repos) => ({
  repos: [...repos].sort(),
  label: repos.map((repo) => repo.split("/")[1]).join(" vs "),
}));

const apiBase = staticApiBase();
const site = (Astro.site ?? new URL("https://gitdebt.com")).href.replace(/\/$/, "");

const SLUG_RE = /^[a-z0-9._-]+\/[a-z0-9._-]+$/;
const rawRepos = Astro.url.searchParams.get("repos");
let repos: string[] = [];
if (rawRepos) {
  const parts = rawRepos
    .split(",")
    .map((slug) => slug.trim().toLowerCase())
    .filter(Boolean);
  if (parts.every((slug) => SLUG_RE.test(slug))) {
    repos = Array.from(new Set(parts)).sort().slice(0, 8);
  }
}
const hasSelection = repos.length >= 2;
const reposParam = repos.join(",");

const title = hasSelection
  ? `${repos.join(" vs ")} — star history · gitdebt`
  : "Compare GitHub star history · gitdebt";
const description = hasSelection
  ? `Star history of ${repos.join(", ")} overlaid on one chart — compare trajectories and copy an embeddable README chart.`
  : "Compare up to eight GitHub repositories on one star-history chart, or open a curated category with rankings, growth, and repository-health reports.";

const ogImage = hasSelection
  ? `${apiBase}/api/og.png?repos=${encodeURIComponent(reposParam)}`
  : `${apiBase}/api/og.png`;
const canonicalPath = !hasSelection
  ? "/compare"
  : repos.length === 2
    ? `/vs/${repos[0]}/${repos[1]}`
    : `/compare?repos=${encodeURIComponent(reposParam)}`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: hasSelection
    ? `Compare star history: ${repos.join(" vs ")}`
    : "Compare GitHub star history",
  url: `${site}${canonicalPath}`,
  description,
};

const suggestionRepos = Array.from(
  new Set([
    ...repos,
    ...POPULAR_PAIRS.flatMap((pair) => pair.repos),
    ...CATEGORIES.flatMap((category) => category.repos),
  ]),
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead />
    <Seo
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      ogImage={ogImage}
      imageAlt={hasSelection
        ? `Star history comparison card for ${repos.join(" versus ")}`
        : undefined}
      jsonLd={jsonLd}
    />
  </head>
  <body>
    <div class="isolate flex min-h-dvh flex-col">
      <SiteHeader />

      <main id="main-content" class="mx-auto flex w-full max-w-6xl flex-1 flex-col gap-14 px-6 py-12 sm:gap-16">
        <nav aria-label="Breadcrumb" class="font-mono text-xs text-muted-foreground">
          <a href="/" class="hover:text-foreground">gitdebt</a>
          <span class="px-1.5 text-border" aria-hidden="true">/</span>
          <span class="text-foreground">compare</span>
        </nav>

        <header>
          <p class="font-mono text-xs tracking-wide text-signal uppercase">
            GitHub star history overlay
          </p>
          <h1 class="mt-3 max-w-[24ch] text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
            Put repository growth on the same timeline.
          </h1>
          <p class="mt-4 max-w-[65ch] text-lg/8 text-pretty text-muted-foreground">
            Compare up to eight repos by calendar date or days since their
            first star. Use the builder for any combination, or open a curated
            field with rankings and project-health reports.
          </p>
        </header>

        <CompareBuilder client:load apiBase={apiBase} initialRepos={repos} />

        <section>
          <header>
            <p class="font-mono text-xs tracking-wide text-muted-foreground uppercase">
              Popular head to head
            </p>
            <h2 class="mt-2 text-2xl font-semibold tracking-tight">
              Start with a familiar decision
            </h2>
          </header>
          <ul role="list" class="mt-6 grid border-y border-border sm:grid-cols-2 sm:divide-x sm:divide-border">
            {POPULAR_PAIRS.map((pair, index) => (
              <li
                class:list={[
                  "border-b border-border sm:[&:nth-last-child(-n+2)]:border-b-0",
                  index === POPULAR_PAIRS.length - 1 && "border-b-0",
                ]}
              >
                <a
                  href={`/vs/${pair.repos[0]}/${pair.repos[1]}`}
                  data-warm-repos={pair.repos.join(",")}
                  class="group flex min-h-16 items-center justify-between gap-4 px-4 py-3 font-mono text-sm"
                >
                  <span>{pair.label}</span>
                  <ArrowRight
                    className="size-4 shrink-0 text-muted-foreground group-hover:text-signal"
                    strokeWidth={1.75}
                    aria-hidden="true"
                  />
                </a>
              </li>
            ))}
          </ul>
        </section>

        <section id="categories" class="scroll-mt-20">
          <header>
            <p class="font-mono text-xs tracking-wide text-muted-foreground uppercase">
              Curated fields
            </p>
            <h2 class="mt-2 max-w-[30ch] text-2xl font-semibold tracking-tight text-balance sm:text-3xl">
              Compare the tools that compete for the same job.
            </h2>
            <p class="mt-3 max-w-[68ch] text-base/7 text-pretty text-muted-foreground sm:text-sm/6">
              Each page has an editorial introduction, a shared star-history
              chart, recent growth, current ranking, and direct access to the
              maintenance signals behind every repository.
            </p>
          </header>

          <div class="mt-10 grid gap-10 lg:grid-cols-3">
            {CATEGORY_GROUPS.map((group) => (
              <section>
                <h3 class="text-lg font-medium">{group.name}</h3>
                <p class="mt-1 text-base/7 text-pretty text-muted-foreground sm:text-sm/6">
                  {group.description}
                </p>
                <ul role="list" class="mt-5 divide-y divide-border border-y border-border">
                  {group.categories.map((category) => (
                    <li>
                      <a
                        href={`/compare/${category.slug}`}
                        data-warm-repos={category.repos.join(",")}
                        class="group flex min-h-16 items-center justify-between gap-4 py-3"
                      >
                        <div class="text-base sm:text-sm">
                          <span class="font-medium">{category.name}</span>
                          <div class="mt-0.5 text-muted-foreground">
                            {category.short}
                          </div>
                        </div>
                        <ArrowRight
                          className="size-4 shrink-0 text-muted-foreground group-hover:text-signal"
                          strokeWidth={1.75}
                          aria-hidden="true"
                        />
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </div>

          <p class="mt-8 text-base text-muted-foreground sm:text-sm">
            Prefer one live ranking? See the{" "}
            <a
              href="/leaderboard"
              class="underline decoration-signal/60 underline-offset-4 hover:decoration-signal"
            >
              fastest-growing repositories
            </a>{" "}
            across the tracked catalog.
          </p>
        </section>

        <WarmRepos client:load apiBase={apiBase} repos={suggestionRepos} />
      </main>

      <SiteFooter />
    </div>
  </body>
</html>
