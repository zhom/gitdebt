---
import { Menu, X } from "lucide-react";
import Brand from "@/components/Brand.astro";
import { AuthControl } from "@/components/AuthControl";
import { staticApiBase } from "@/lib/static-api-base";

const navLinks = [
  { label: "Analyze", href: "/#lookup" },
  { label: "Compare", href: "/compare" },
  { label: "Leaderboard", href: "/leaderboard" },
];

const apiBase = staticApiBase();
const returnTo = `${Astro.url.pathname}${Astro.url.search}`;
const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";

function isCurrent(href: string): boolean {
  const path = href.split("#")[0].replace(/\/+$/, "") || "/";
  return path !== "/" && currentPath === path;
}
---

<a
  href="#main-content"
  class="fixed top-3 left-3 z-999 inline-flex min-h-10 -translate-y-20 items-center rounded-md bg-foreground px-4 font-mono text-xs text-background focus:translate-y-0 focus-visible:ring-2 focus-visible:ring-accent/30"
>
  Skip to content
</a>

<header class="site-header chrome sticky top-0 z-50">
  <div
    class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-3 px-4 sm:px-6 lg:grid lg:grid-cols-[1fr_auto_1fr]"
  >
    <a
      href="/"
      aria-label="gitdebt homepage"
      class="inline-flex min-h-10 min-w-0 shrink-0 items-center rounded-md outline-none focus-visible:ring-2 focus-visible:ring-accent/30 focus-visible:ring-offset-4 focus-visible:ring-offset-background"
    >
      <Brand />
    </a>

    <nav class="hidden items-center gap-1 lg:flex">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            aria-current={isCurrent(link.href) ? "page" : undefined}
            class="group relative inline-flex min-h-10 items-center gap-2.5 rounded-md px-2.5 font-mono text-[12px] text-muted-foreground outline-none transition-colors duration-150 hover:bg-card/60 hover:text-foreground focus-visible:ring-2 focus-visible:ring-accent/30 aria-[current=page]:bg-card aria-[current=page]:text-foreground"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex shrink-0 items-center gap-1 justify-self-end sm:gap-2">
      <div data-auth-slot>
        <AuthControl client:load apiBase={apiBase} returnTo={returnTo} />
      </div>
      <details class="relative lg:hidden" data-mobile-menu data-state="closed">
        <summary
          class="grid size-10 cursor-pointer list-none place-items-center rounded-md text-foreground outline-none transition-colors duration-150 hover:bg-card/60 focus-visible:ring-2 focus-visible:ring-accent/30 [&::-webkit-details-marker]:hidden"
          aria-label="Open navigation"
          aria-controls="mobile-navigation"
          aria-expanded="false"
        >
          <Menu
            className="mobile-nav-icon mobile-nav-icon-menu size-5"
            strokeWidth={1.75}
            aria-hidden="true"
          />
          <X
            className="mobile-nav-icon mobile-nav-icon-close size-5"
            strokeWidth={1.75}
            aria-hidden="true"
          />
        </summary>
        <div
          class="mobile-nav-panel absolute right-0 mt-2 w-[min(18rem,calc(100vw-2rem))] origin-top-right rounded-lg border border-border/80 bg-card p-2 text-popover-foreground shadow-[0_8px_24px_rgba(0,0,0,0.32)]"
          data-mobile-menu-panel
          aria-hidden="true"
          inert
        >
          <nav id="mobile-navigation" class="flex flex-col">
            {
              navLinks.map((link) => (
                <a
                  href={link.href}
                  aria-current={isCurrent(link.href) ? "page" : undefined}
                  class="relative flex min-h-10 items-center gap-2.5 rounded-md px-2.5 font-mono text-[12px] text-muted-foreground outline-none transition-colors duration-150 hover:bg-card/60 hover:text-foreground focus-visible:ring-2 focus-visible:ring-accent/30 aria-[current=page]:bg-card aria-[current=page]:text-foreground"
                >
                  {link.label}
                </a>
              ))
            }
          </nav>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  const CLOSE_MS = 140;

  function installMobileMenu(details: HTMLDetailsElement) {
    const summary = details.querySelector("summary");
    const panel = details.querySelector<HTMLElement>("[data-mobile-menu-panel]");
    if (!summary || !panel) return;
    const trigger = summary;
    const menuPanel = panel;

    let closeTimer: ReturnType<typeof setTimeout> | null = null;
    let openFrame: number | null = null;
    let settleFrame: number | null = null;

    function cancelOpenFrames() {
      if (openFrame !== null) cancelAnimationFrame(openFrame);
      if (settleFrame !== null) cancelAnimationFrame(settleFrame);
      openFrame = null;
      settleFrame = null;
    }

    function setPanelInteractive(interactive: boolean) {
      menuPanel.setAttribute("aria-hidden", String(!interactive));
      if (interactive) menuPanel.removeAttribute("inert");
      else menuPanel.setAttribute("inert", "");
    }

    function openMenu() {
      if (closeTimer) clearTimeout(closeTimer);
      closeTimer = null;
      cancelOpenFrames();
      details.open = true;
      details.dataset.state = "closed";
      trigger.setAttribute("aria-expanded", "true");
      trigger.setAttribute("aria-label", "Close navigation");
      setPanelInteractive(true);
      openFrame = requestAnimationFrame(() => {
        openFrame = null;
        settleFrame = requestAnimationFrame(() => {
          settleFrame = null;
          if (trigger.getAttribute("aria-expanded") === "true") {
            details.dataset.state = "open";
          }
        });
      });
    }

    function closeMenu(returnFocus = false) {
      if (!details.open) return;
      if (closeTimer) clearTimeout(closeTimer);
      cancelOpenFrames();
      details.dataset.state = "closed";
      trigger.setAttribute("aria-expanded", "false");
      trigger.setAttribute("aria-label", "Open navigation");
      setPanelInteractive(false);
      closeTimer = setTimeout(() => {
        details.open = false;
        closeTimer = null;
        if (returnFocus) trigger.focus();
      }, CLOSE_MS);
    }

    trigger.addEventListener("click", (event) => {
      event.preventDefault();
      if (trigger.getAttribute("aria-expanded") === "true") closeMenu();
      else openMenu();
    });

    document.addEventListener("pointerdown", (event) => {
      if (!details.contains(event.target as Node)) closeMenu();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && details.open) {
        event.preventDefault();
        closeMenu(true);
      }
    });

    menuPanel.addEventListener("click", (event) => {
      if ((event.target as Element).closest("a")) closeMenu();
    });
  }

  document
    .querySelectorAll<HTMLDetailsElement>("[data-mobile-menu]")
    .forEach(installMobileMenu);
</script>
