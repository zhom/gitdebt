---
export const prerender = true;

import "@/styles/globals.css";
import BaseHead from "@/components/BaseHead.astro";
import Seo from "@/components/Seo.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { BODY, CAPTION, HEADING, TITLE } from "@/components/style-tokens";
import { staticApiBase } from "@/lib/static-api-base";

const apiBase = staticApiBase();

const title = "Privacy policy · gitdebt";
const description =
  "How gitdebt handles optional GitHub sign-in, anonymous extension activity, public repository data, and operational logs.";
const ogImage = `${apiBase}/api/og.png`;

const updated = "2026-07-19";

const collected = [
  {
    term: "Repository views (browser extension)",
    desc: "When you open a GitHub repo with the gitdebt extension installed, it sends us {owner, repo, observed star count}. We use this to keep a repo's data fresh and to find popular repos worth charting. The star count is an untrusted hint compared against our cache — it is never stored. The extension is anonymous: no account, cookie, or identifier is attached.",
  },
  {
    term: "Public repository data",
    desc: "We fetch and cache public GitHub data — stargazer timestamps, commit history, contributors, language lines, and similar metadata — to render star-history and repo-debt charts. We only ever read public data.",
  },
  {
    term: "Optional GitHub sign-in",
    desc: "If you choose to sign in, GitHub gives us your public profile identity and an OAuth token. We store the token encrypted at rest and use an HTTP-only signed session cookie to keep you signed in. Sign-in provides a one-click link to your profile-wide report; public repository reports do not require it. In July 2026 GitHub restricted the stargazer-list endpoint to a repository's own admins and collaborators, and the permission GitHub requires to read it is Contents (read and write). So if you connect a repository you administer, gitdebt requests that permission in order to read that repository's stargazer timestamps. We never write to your repositories, and we never request account-management access. You choose which repositories the app can see, and you can revoke it at any time from GitHub's settings.",
  },
  {
    term: "Operational logs",
    desc: "Our hosting providers and server may process request metadata such as IP address, user agent, route, timestamp, and response status to operate, secure, and troubleshoot the service. We do not use this data for advertising.",
  },
];

const principles = [
  {
    term: "We don't sell your data",
    desc: "gitdebt does not sell, rent, or trade personal data to anyone, and we don't run third-party advertising or analytics trackers.",
  },
  {
    term: "Public data only",
    desc: "Every repo signal we compute comes from publicly available GitHub data, and every chart we publish is derived from a public repository. Connecting a repository you administer grants the Contents (read and write) permission GitHub now requires to read a stargazer list — we use it only to read, never to write, and a private repository never becomes a public page. We never request account-management permissions.",
  },
  {
    term: "Minimal retention",
    desc: "Cached public repo data is kept to serve charts quickly and refreshed over time. The extension's reported star counts are discarded after comparison and never persisted. Signing out clears your browser session; you can ask us to remove the stored OAuth record by opening a private security advisory.",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Privacy policy",
  url: `${(Astro.site ?? new URL("https://gitdebt.com")).href.replace(/\/$/, "")}/privacy`,
  description,
};
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead />
    <Seo
      title={title}
      description={description}
      canonicalPath="/privacy"
      ogImage={ogImage}
      jsonLd={jsonLd}
    />
  </head>
  <body>
    <div class="isolate flex min-h-dvh flex-col">
      <SiteHeader />

      <main id="main-content" class="mx-auto w-full max-w-3xl flex-1 px-6 py-12">
        <nav aria-label="Breadcrumb" class="font-mono text-[11px] text-muted-foreground">
          <a
            href="/"
            class="rounded outline-none transition-colors duration-150 hover:text-foreground focus-visible:ring-2 focus-visible:ring-accent/30"
            >gitdebt</a
          >
          <span class="px-1.5 text-border" aria-hidden="true">/</span>
          <span class="text-foreground">privacy</span>
        </nav>

        <header class="mt-8">
          <h1 class={TITLE}>Privacy policy</h1>
          <p class:list={["mt-3", CAPTION]}>
            Last updated <time datetime={updated} class="tabular-nums">{updated}</time>
          </p>
        </header>

        <section class="mt-16 scroll-mt-24 border-t border-border/60 pt-12">
          <h2 class={HEADING}>What we collect</h2>
          <dl class="mt-8 grid gap-x-12 gap-y-8 sm:grid-cols-2">
            {
              collected.map((item) => (
                <div>
                  <dt class="text-[13px] text-foreground/90">{item.term}</dt>
                  <dd class:list={["mt-1.5 max-w-[52ch]", BODY]}>{item.desc}</dd>
                </div>
              ))
            }
          </dl>
        </section>

        <section class="mt-16 scroll-mt-24 border-t border-border/60 pt-12">
          <h2 class={HEADING}>How we handle it</h2>
          <dl class="mt-8 grid gap-x-12 gap-y-8 sm:grid-cols-2">
            {
              principles.map((item) => (
                <div>
                  <dt class="text-[13px] text-foreground/90">{item.term}</dt>
                  <dd class:list={["mt-1.5 max-w-[52ch]", BODY]}>{item.desc}</dd>
                </div>
              ))
            }
          </dl>
        </section>

        <section class="mt-16 scroll-mt-24 border-t border-border/60 pt-12">
          <h2 class={HEADING}>Your choices</h2>
          <p class:list={["mt-2 max-w-[68ch]", BODY]}>
            gitdebt does not require an account. You can sign out at any time
            from the header menu. To stop the browser extension from sending
            repository views, turn off its automatic panel or uninstall the
            extension.
          </p>
        </section>

        <section class="mt-16 scroll-mt-24 border-t border-border/60 pt-12">
          <h2 class={HEADING}>Contact</h2>
          <p class:list={["mt-2 max-w-[68ch]", BODY]}>
            Questions about this policy? Open a
            <a
              href="https://github.com/zhom/gitdebt/issues"
              class="rounded underline decoration-border underline-offset-4 outline-none transition-colors duration-150 hover:text-foreground hover:decoration-foreground/60 focus-visible:ring-2 focus-visible:ring-accent/30"
            >
              GitHub issue
            </a>
            without including private information. Report vulnerabilities
            through GitHub's private security advisory flow. gitdebt is an
            independent tool and is not affiliated with, endorsed by, or
            sponsored by GitHub.
          </p>
        </section>
      </main>

      <SiteFooter />
    </div>
  </body>
</html>
