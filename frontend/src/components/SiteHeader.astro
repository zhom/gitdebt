---
import { Menu, X } from "lucide-react";
import Brand from "@/components/Brand.astro";
import { AuthControl } from "@/components/AuthControl";
import { staticApiBase } from "@/lib/static-api-base";

const navLinks = [
  { label: "Analyze", href: "/#lookup" },
  { label: "Compare", href: "/compare" },
  { label: "Leaderboard", href: "/leaderboard" },
];

const apiBase = staticApiBase();
const returnTo = `${Astro.url.pathname}${Astro.url.search}`;
---

<a
  href="#main-content"
  class="fixed top-3 left-3 z-999 inline-flex min-h-12 -translate-y-20 items-center rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground focus:translate-y-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
>
  Skip to content
</a>

<header
  class="site-header sticky top-0 z-50 border-b border-border bg-background/90 backdrop-blur-xl"
>
  <div
    class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-3 px-4 sm:px-6 lg:grid lg:grid-cols-[1fr_auto_1fr]"
  >
    <a
      href="/"
      aria-label="gitdebt homepage"
      class="inline-flex min-h-12 min-w-0 shrink-0 items-center rounded-md focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring"
    >
      <Brand />
    </a>

    <nav class="hidden items-center gap-1 lg:flex">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="inline-flex min-h-11 items-center rounded-md px-3 font-mono text-[0.6875rem] font-medium tracking-[0.14em] uppercase text-muted-foreground transition-colors duration-150 hover:bg-accent hover:text-accent-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring active:text-foreground"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex shrink-0 items-center gap-1 justify-self-end sm:gap-2">
      <div data-auth-slot>
        <AuthControl client:load apiBase={apiBase} returnTo={returnTo} />
      </div>
      <details class="relative lg:hidden" data-mobile-menu data-state="closed">
        <summary
          class="grid size-12 cursor-pointer list-none place-items-center rounded-md text-foreground transition-colors duration-150 hover:bg-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring [&::-webkit-details-marker]:hidden"
          aria-label="Open navigation"
          aria-controls="mobile-navigation"
          aria-expanded="false"
        >
          <Menu
            className="mobile-nav-icon mobile-nav-icon-menu size-6"
            strokeWidth={1.75}
            aria-hidden="true"
          />
          <X
            className="mobile-nav-icon mobile-nav-icon-close size-6"
            strokeWidth={1.75}
            aria-hidden="true"
          />
        </summary>
        <div
          class="mobile-nav-panel dither-menu absolute right-0 mt-2 w-[min(18rem,calc(100vw-2rem))] origin-top-right rounded-lg p-2 text-popover-foreground"
          data-mobile-menu-panel
          aria-hidden="true"
          inert
        >
          <nav id="mobile-navigation" class="flex flex-col">
            {
              navLinks.map((link) => (
                <a
                  href={link.href}
                  class="flex min-h-12 items-center rounded-md px-3 font-mono text-sm tracking-[0.12em] uppercase text-muted-foreground transition-colors duration-150 hover:bg-accent hover:text-accent-foreground focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-ring active:text-foreground"
                >
                  {link.label}
                </a>
              ))
            }
          </nav>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  const CLOSE_MS = 140;

  function installMobileMenu(details: HTMLDetailsElement) {
    const summary = details.querySelector("summary");
    const panel = details.querySelector<HTMLElement>("[data-mobile-menu-panel]");
    if (!summary || !panel) return;
    const trigger = summary;
    const menuPanel = panel;

    let closeTimer: ReturnType<typeof setTimeout> | null = null;
    let openFrame: number | null = null;
    let settleFrame: number | null = null;

    function cancelOpenFrames() {
      if (openFrame !== null) cancelAnimationFrame(openFrame);
      if (settleFrame !== null) cancelAnimationFrame(settleFrame);
      openFrame = null;
      settleFrame = null;
    }

    function setPanelInteractive(interactive: boolean) {
      menuPanel.setAttribute("aria-hidden", String(!interactive));
      if (interactive) menuPanel.removeAttribute("inert");
      else menuPanel.setAttribute("inert", "");
    }

    function openMenu() {
      if (closeTimer) clearTimeout(closeTimer);
      closeTimer = null;
      cancelOpenFrames();
      details.open = true;
      details.dataset.state = "closed";
      trigger.setAttribute("aria-expanded", "true");
      trigger.setAttribute("aria-label", "Close navigation");
      setPanelInteractive(true);
      openFrame = requestAnimationFrame(() => {
        openFrame = null;
        settleFrame = requestAnimationFrame(() => {
          settleFrame = null;
          if (trigger.getAttribute("aria-expanded") === "true") {
            details.dataset.state = "open";
          }
        });
      });
    }

    function closeMenu(returnFocus = false) {
      if (!details.open) return;
      if (closeTimer) clearTimeout(closeTimer);
      cancelOpenFrames();
      details.dataset.state = "closed";
      trigger.setAttribute("aria-expanded", "false");
      trigger.setAttribute("aria-label", "Open navigation");
      setPanelInteractive(false);
      closeTimer = setTimeout(() => {
        details.open = false;
        closeTimer = null;
        if (returnFocus) trigger.focus();
      }, CLOSE_MS);
    }

    trigger.addEventListener("click", (event) => {
      event.preventDefault();
      if (trigger.getAttribute("aria-expanded") === "true") closeMenu();
      else openMenu();
    });

    document.addEventListener("pointerdown", (event) => {
      if (!details.contains(event.target as Node)) closeMenu();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && details.open) {
        event.preventDefault();
        closeMenu(true);
      }
    });

    menuPanel.addEventListener("click", (event) => {
      if ((event.target as Element).closest("a")) closeMenu();
    });
  }

  document
    .querySelectorAll<HTMLDetailsElement>("[data-mobile-menu]")
    .forEach(installMobileMenu);
</script>
