---
import "@/styles/globals.css";
import { staticComparisonPaths } from "@/lib/build-catalog";
import { staticApiBase } from "@/lib/static-api-base";
import {
  loadBuildRepoSnapshot,
} from "@/lib/build-repo-snapshot";
import BaseHead from "@/components/BaseHead.astro";
import Seo from "@/components/Seo.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { comparisonColors } from "@/components/DitherComparisonChart";
import { LiveVsComparison } from "@/components/LiveVsComparison";
import { SeriesProvenance } from "@/components/SeriesProvenance";
import {
  BODY,
  HEADING,
  MEASURE,
  SECTION_HEADER,
} from "@/components/style-tokens";
import {
  coverageLabel,
  historyFreshness,
  sourceLabel,
  stateLabel,
  type HistorySnapshot,
} from "@/lib/history-freshness";

export function getStaticPaths() {
  return staticComparisonPaths();
}

const {
  owner1: rawOwner1,
  repo1: rawRepo1,
  owner2: rawOwner2,
  repo2: rawRepo2,
} = Astro.params;

const validSlug = /^[A-Za-z0-9._-]+$/;
if (
  !rawOwner1 ||
  !rawRepo1 ||
  !rawOwner2 ||
  !rawRepo2 ||
  !validSlug.test(rawOwner1) ||
  !validSlug.test(rawRepo1) ||
  !validSlug.test(rawOwner2) ||
  !validSlug.test(rawRepo2)
) {
  return new Response("Not found", { status: 404 });
}

const lower1 = rawOwner1.toLowerCase();
const lowerR1 = rawRepo1.toLowerCase();
const lower2 = rawOwner2.toLowerCase();
const lowerR2 = rawRepo2.toLowerCase();
const slugA = `${lower1}/${lowerR1}`;
const slugB = `${lower2}/${lowerR2}`;
const [first, second] = slugA <= slugB
  ? [[lower1, lowerR1], [lower2, lowerR2]]
  : [[lower2, lowerR2], [lower1, lowerR1]];
const canonicalPathname = `/vs/${first[0]}/${first[1]}/${second[0]}/${second[1]}`;
const rawPathname = `/vs/${rawOwner1}/${rawRepo1}/${rawOwner2}/${rawRepo2}`;
if (rawPathname !== canonicalPathname) {
  return new Response("Not found", { status: 404 });
}

const owner1 = first[0];
const repo1 = first[1];
const owner2 = second[0];
const repo2 = second[1];

const apiBase = staticApiBase();

const [left, right] = await Promise.all([
  loadBuildRepoSnapshot(`${owner1}/${repo1}`),
  loadBuildRepoSnapshot(`${owner2}/${repo2}`),
]);

const slug1 = `${owner1}/${repo1}`;
const slug2 = `${owner2}/${repo2}`;
const bothLoaded = left.data !== null && right.data !== null;
const fetchError = left.error ?? right.error;
const ready =
  bothLoaded &&
  left.data!.history.length > 0 &&
  right.data!.history.length > 0;

const reposParam = encodeURIComponent(`${slug1},${slug2}`);
const overlayPath = `/api/chart.svg?repos=${reposParam}`;

const title = `${repo1} vs ${repo2}: stars, code, and maintenance · gitdebt`;

/**
 * Two unbounded slugs eat most of the 160-character budget before a single
 * descriptive word is written, so the enumeration is the part that gives way.
 * All 278 of these pages used to truncate mid-clause.
 */
function fitDescription(head: string, tails: string[], limit = 160): string {
  for (const tail of tails) {
    const composed = `${head} ${tail}`;
    if (composed.length <= limit) return composed;
  }
  return head;
}

const description = fitDescription(`${slug1} vs ${slug2}.`, [
  "Star growth, forks, dominant language, codebase size, commit cadence, bus factor, and change pressure compared.",
  "Star growth, language, codebase size, commit cadence, and bus factor compared.",
  "Star growth, commit cadence, and contributor concentration compared.",
  "Star growth and repository health compared.",
]);
const site = (Astro.site ?? new URL("https://gitdebt.com")).href.replace(/\/$/, "");
const canonicalPath = `/vs/${slug1}/${slug2}`;
const canonical = `${site}${canonicalPath}`;

const ogImage = `${apiBase}/api/og.png?repos=${reposParam}`;

const noindex = !ready || fetchError !== null;

// A head-to-head is exactly where two series with different sources and
// different coverage ends get read as directly comparable. Hue is series
// identity — the same map the overlay chart builds — and the mark's density
// carries the source.
const vsColors = comparisonColors([slug1, slug2]);
const seriesRows = [
  { slug: slug1, snapshot: left.data, fill: vsColors.get(slug1) },
  { slug: slug2, snapshot: right.data, fill: vsColors.get(slug2) },
];

const faqs: { q: string; a: string }[] = [];
if (left.data && right.data) {
  const ranked = [
    { slug: slug1, stars: left.data.total_stars },
    { slug: slug2, stars: right.data.total_stars },
  ].sort((a, b) => b.stars - a.stars);
  faqs.push({
    q: `Which has more GitHub stars, ${slug1} or ${slug2}?`,
    a: `GitHub reports ${ranked[0].stars.toLocaleString()} stars for ${ranked[0].slug} and ${ranked[1].stars.toLocaleString()} for ${ranked[1].slug}.`,
  });

  // Source, date, state — per repository, and never a gap, a share or a score.
  // An archive series counts re-stars and can exceed a repository's own total,
  // so "how much is missing" is wrong exactly where it looks precise.
  const readAs = (slug: string, snapshot: HistorySnapshot) => {
    const freshness = historyFreshness(snapshot);
    return `${slug} — ${sourceLabel(freshness)} · ${coverageLabel(freshness)} · ${stateLabel(freshness)}`;
  };
  faqs.push({
    q: "Do both star histories cover the same period?",
    a: `Not necessarily, and each chart names its own. ${readAs(slug1, left.data)}. ${readAs(slug2, right.data)}. Since July 2026 GitHub serves a repository's stargazer list only to its own admins and collaborators, so one series can stop on a fixed date while the other keeps flowing from public archive events.`,
  });
  faqs.push({
    q: "How is this comparison computed?",
    a: "Star totals come from public repository metadata. The two curves are each repository's stored star series drawn on shared axes, from whichever source is named above. Repository-health figures are computed independently from each project's commit history.",
  });
}

const jsonLd: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: `${slug1} vs ${slug2}`,
    url: canonical,
    description,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "gitdebt", item: `${site}/` },
      { "@type": "ListItem", position: 2, name: "Compare", item: `${site}/compare` },
      { "@type": "ListItem", position: 3, name: `${slug1} vs ${slug2}`, item: canonical },
    ],
  },
];
// The star total is GitHub's own figure and the hero prints it; asserting it
// says nothing about how the series behind the chart was read.
if (left.data && right.data) {
  for (const entry of [
    { slug: slug1, stars: left.data.total_stars },
    { slug: slug2, stars: right.data.total_stars },
  ]) {
    jsonLd.push({
      "@context": "https://schema.org",
      "@type": "SoftwareSourceCode",
      name: entry.slug,
      codeRepository: `https://github.com/${entry.slug}`,
      url: `${site}/${entry.slug}`,
      interactionStatistic: {
        "@type": "InteractionCounter",
        interactionType: { "@type": "LikeAction" },
        userInteractionCount: entry.stars,
      },
    });
  }
}
// Mirrors the visible block below, and is never emitted without it.
if (faqs.length > 0) {
  jsonLd.push({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  });
}
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead />
    <Seo
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      ogImage={ogImage}
      imageAlt={`Star history comparison card for ${slug1} versus ${slug2}`}
      noindex={noindex}
      jsonLd={jsonLd}
    />
  </head>
  <body>
    <div class="isolate flex min-h-dvh flex-col">
      <SiteHeader />

      <main id="main-content" class="mx-auto min-w-0 w-full max-w-6xl flex-1 px-6 py-12">
        <nav aria-label="Breadcrumb" class="font-mono text-[11px] text-muted-foreground">
          <a
            href="/"
            class="rounded outline-none transition-colors duration-150 hover:text-foreground focus-visible:ring-2 focus-visible:ring-accent/30"
            >gitdebt</a
          >
          <span class="px-1.5 text-border" aria-hidden="true">/</span>
          <a
            href="/compare"
            class="rounded outline-none transition-colors duration-150 hover:text-foreground focus-visible:ring-2 focus-visible:ring-accent/30"
            >vs</a
          >
          <span class="px-1.5 text-border" aria-hidden="true">/</span>
          <span class="text-foreground">{slug1} · {slug2}</span>
        </nav>

        <LiveVsComparison
          client:load
          apiBase={apiBase}
          canonical={canonical}
          initialLeft={left.data}
          initialRight={right.data}
          overlayPath={overlayPath}
          slug1={slug1}
          slug2={slug2}
        />

        {bothLoaded && (
          <section class="mt-16 scroll-mt-24 border-t border-border/60 pt-12">
            <div class={SECTION_HEADER}>
              <h2 class={HEADING}>How each series was read</h2>
            </div>
            <p class:list={["mt-2", BODY, MEASURE]}>
              The overlay puts both repositories on one axis. It does not put
              them on one source: since July 2026 a stargazer-list series stops
              on a fixed date, while a series rebuilt from public archive events
              keeps receiving points. Each mark below shows its own source,
              coverage date, and state.
            </p>
            <ul role="list" class="mt-6 grid gap-x-12 gap-y-4 sm:grid-cols-2">
              {seriesRows.map((row) => (
                <li class="min-w-0">
                  <p class="truncate font-mono text-[12px]">{row.slug}</p>
                  <SeriesProvenance
                    client:visible
                    variant="inline"
                    className="mt-1.5"
                    fill={row.fill}
                    snapshot={row.snapshot}
                  />
                </li>
              ))}
            </ul>
          </section>
        )}

        {faqs.length > 0 && (
          <section class="mt-16 scroll-mt-24 border-t border-border/60 pt-12">
            <div class={SECTION_HEADER}>
              <h2 class={HEADING}>Frequently asked</h2>
            </div>
            <div class="mt-6">
              {faqs.map((f) => (
                <details class="group border-b border-border/40 py-4 last:border-0">
                  <summary class="cursor-pointer list-none rounded-md py-1 text-[13px] outline-none transition-colors duration-150 hover:text-foreground focus-visible:ring-2 focus-visible:ring-accent/30 [&::-webkit-details-marker]:hidden">
                    {f.q}
                  </summary>
                  <p class:list={["mt-2", BODY, MEASURE]}>{f.a}</p>
                </details>
              ))}
            </div>
          </section>
        )}
      </main>

      <SiteFooter
        signalValues={[
          left.data?.total_stars ?? 0,
          right.data?.total_stars ?? 0,
          left.data?.history.length ?? 0,
          right.data?.history.length ?? 0,
        ]}
      />
    </div>
  </body>
</html>
