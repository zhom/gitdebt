---
export const prerender = true;

import Sheet from "@/layouts/Sheet.astro";
import { LiveRepoReport } from "@/components/LiveRepoReport";
import { SeriesProvenance } from "@/components/SeriesProvenance";
import { BODY, CAPTION, MEASURE, PANEL, TITLE } from "@/components/style-tokens";
import { staticApiBase } from "@/lib/static-api-base";

const apiBase = staticApiBase();

// The Markdown representation an agent that landed here can always reach. The
// site prerenders none, so this route answers for any public repository —
// including the one whose missing static page brought the agent here.
const agentMarkdown = `${apiBase}/api/md/{owner}/{repo}`;

/**
 * The served title stays "Page not found", and that is correct.
 *
 * This document is what the host returns for a genuinely unmatched path, so the
 * HTML a crawler reads must say so; the route is `noindex` for the same reason.
 * Its most common *live* state is different — a public repository that is not
 * in the static catalog, where the island below renders a full report — and the
 * island retitles the document once it knows what it resolved. This page does
 * not compete with that: it renders no heading of its own except in the one
 * state where the island cannot run at all.
 */
const title = "Page not found · gitdebt";
const description =
  "We couldn't find that repo or page. Search any GitHub owner/repo to chart its star history on gitdebt.";
const ogImage = `${apiBase}/api/og.png`;
---

<Sheet
  title={title}
  description={description}
  canonicalPath="/404"
  ogImage={ogImage}
  noindex={true}
>
  <meta slot="head" name="gitdebt-route-fallback" content="missing-repo" />
  <meta slot="head" name="gitdebt-agent-markdown" content={agentMarkdown} />

  <section class="border-b border-rule bg-paper">
    <div class="mx-auto w-full max-w-6xl px-6 py-12">
      <LiveRepoReport client:only="react" apiBase={apiBase} />
      {/*
        Scripting off is the only state in which this really is a dead end, so
        it is the only state that says so — and it carries the `<h1>`, because
        the island that normally owns the heading never ran.
      */}
      <noscript>
        <h1 class={TITLE}>That sheet is not on file</h1>
        <div class:list={["mt-6 max-w-2xl", PANEL]}>
          <p class:list={[BODY, MEASURE]}>
            Opening a repository that is not in the static catalog needs
            JavaScript. Without it, <span class="font-mono text-[0.8125rem] text-ink"
              >{agentMarkdown}</span
            > returns the report as Markdown for any public repository, and queues
            the analysis when there is none yet.
          </p>
        </div>
      </noscript>
    </div>
  </section>

  {/*
    This route's most common real state is not "page missing" but "a public
    repository that is not in the static catalog", where the island renders the
    full report. The explainer covers the state that is genuinely empty, and
    says what gitdebt reads without claiming anything about a repository it has
    not read.
  */}
  <section class="bg-table">
    <div class="mx-auto w-full max-w-6xl px-6 py-16">
      <SeriesProvenance client:visible variant="explainer" />
      <p class:list={["mt-8", CAPTION, MEASURE]}>
        A repository gitdebt has already drawn has its own page at
        <span class="font-mono">gitdebt.com/owner/name</span>.
      </p>
    </div>
  </section>
</Sheet>
