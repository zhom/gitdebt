---
export const prerender = true;

import "@/styles/globals.css";
import BaseHead from "@/components/BaseHead.astro";
import Seo from "@/components/Seo.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { LiveRepoReport } from "@/components/LiveRepoReport";
import { staticApiBase } from "@/lib/static-api-base";

const apiBase = staticApiBase();

// The Markdown representation an agent that landed here can always reach. The
// site prerenders none, so this route answers for any public repository —
// including the one whose missing static page brought the agent here.
const agentMarkdown = `${apiBase}/api/md/{owner}/{repo}`;

const title = "Page not found · gitdebt";
const description =
  "We couldn't find that repo or page. Search any GitHub owner/repo to chart its star history on gitdebt.";
const ogImage = `${apiBase}/api/og.png`;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead />
    <Seo
      title={title}
      description={description}
      canonicalPath="/404"
      ogImage={ogImage}
      noindex={true}
    />
    <meta name="gitdebt-route-fallback" content="missing-repo" />
    <meta name="gitdebt-agent-markdown" content={agentMarkdown} />
  </head>
  <body>
    <div class="isolate flex min-h-dvh flex-col">
      <SiteHeader />

      <main id="main-content" class="mx-auto w-full max-w-6xl flex-1 px-6 py-12">
        <LiveRepoReport client:only="react" apiBase={apiBase} />
        <noscript>
          <div class="rounded-lg border border-border/60 bg-background/40 p-3.5 text-[13px] leading-relaxed text-muted-foreground">
            JavaScript is required to open a repository that has not been included in the static catalog yet.
            Without it, {agentMarkdown} returns the report as Markdown for any public repository, and queues the analysis when there is none yet.
          </div>
        </noscript>
      </main>

      <SiteFooter />
    </div>
  </body>
</html>
