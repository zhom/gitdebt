---
import "@/styles/globals.css";
import {
  staticCatalogRequired,
  staticRepoPaths,
} from "@/lib/build-catalog";
import { staticApiBase } from "@/lib/static-api-base";
import BaseHead from "@/components/BaseHead.astro";
import Seo from "@/components/Seo.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { RepoHero } from "@/components/RepoHero";
import { ChartViewer } from "@/components/ChartViewer";
import { SecondarySignals } from "@/components/LiveRepoReport";
import { StatCard } from "@/components/StatCard";
import { UsageSection, type UsageResponse } from "@/components/UsageSection";
import { WarmRepos } from "@/components/WarmRepos";
import { buttonVariants } from "@/components/ui/button";
import { categoriesForRepo, relatedRepos } from "@/data/categories";
import {
  firstStarYear as historyFirstYear,
  formatFullDate,
  formatMonthYear,
  gainedInTrailingDays,
  growthTrend,
  starMilestones,
  formatCompact,
} from "@/lib/star-insights";

export async function getStaticPaths() {
  return staticRepoPaths();
}

const { owner: rawOwner, repo: rawRepo } = Astro.params;
const { updatedAt = null } = Astro.props as { updatedAt?: string | null };
const requiredSnapshot = Boolean(updatedAt && staticCatalogRequired());

const validSlug = /^[A-Za-z0-9._-]+$/;
if (!rawOwner || !rawRepo || !validSlug.test(rawOwner) || !validSlug.test(rawRepo)) {
  return new Response("Not found", { status: 404 });
}

const owner = rawOwner.toLowerCase();
const repo = rawRepo.toLowerCase();

const apiBase = staticApiBase();

type AnalyzeResponse = {
  repo: string;
  total_stars: number;
  created_at: string | null;
  queued: number;
  pending?: boolean;
  history_complete: boolean;
  history_kind:
    | "current_stargazers"
    | "public_star_actions"
    | "unavailable";
  history_event_count: number;
  history_coverage_start: string | null;
  history_coverage_end: string | null;
  history_approximate: boolean;
  backfilling?: boolean;
  not_found?: boolean;
  history: { date: string; stars: number }[];
};

let data: AnalyzeResponse | null = null;
let fetchError: string | null = null;
let repoNotFound = false;
let usage: UsageResponse | null = null;

async function fetchAnalysis() {
  const maxAttempts = requiredSnapshot ? 5 : 1;

  for (let attempt = 0; attempt < maxAttempts; attempt += 1) {
    try {
      const response = await fetch(
        `${apiBase}/api/repos/${owner}/${repo}/analyze?enqueue=0`,
        {
          headers: { accept: "application/json" },
          signal: AbortSignal.timeout(5_000),
        },
      );
      const transient =
        response.status === 408 ||
        response.status === 425 ||
        response.status === 429 ||
        response.status >= 500;

      if (!transient || attempt === maxAttempts - 1) return response;

      await response.body?.cancel();
      const retryAfter = Number(response.headers.get("retry-after"));
      const delayMs =
        Number.isFinite(retryAfter) && retryAfter > 0
          ? Math.min(retryAfter * 1_000, 30_000)
          : 2_000 * 2 ** attempt;
      await new Promise((resolve) => setTimeout(resolve, delayMs));
    } catch (error) {
      if (attempt === maxAttempts - 1) throw error;
      await new Promise((resolve) =>
        setTimeout(resolve, 2_000 * 2 ** attempt),
      );
    }
  }

  throw new Error("analysis request exhausted its retry budget");
}

try {
  const [analyzeRes, usageRes] = await Promise.allSettled([
    fetchAnalysis(),
    fetch(`${apiBase}/api/repos/${owner}/${repo}/usage`, {
      headers: { accept: "application/json" },
      signal: AbortSignal.timeout(5_000),
    }),
  ]);

  if (analyzeRes.status === "fulfilled") {
    const res = analyzeRes.value;
    if (res.ok) {
      const result = (await res.json()) as AnalyzeResponse;
      if (result.not_found) {
        repoNotFound = true;
      } else {
        data = result;
      }
    } else if (res.status === 404) {
      repoNotFound = true;
    } else {
      fetchError = `backend returned ${res.status}`;
    }
  } else {
    fetchError =
      analyzeRes.reason instanceof Error
        ? analyzeRes.reason.message
        : String(analyzeRes.reason);
  }

  if (usageRes.status === "fulfilled" && usageRes.value.ok) {
    usage = (await usageRes.value.json()) as UsageResponse;
  }
} catch (err) {
  fetchError = err instanceof Error ? err.message : String(err);
}

if (
  requiredSnapshot &&
  !repoNotFound &&
  (!data || fetchError)
) {
  throw new Error(
    `Static snapshot refresh failed for ${owner}/${repo}: ${
      fetchError ?? "missing analysis data"
    }`,
  );
}

const repoSlug = `${owner}/${repo}`;
const canonicalPath = `/${repoSlug}`;
const site = (Astro.site ?? new URL("https://gitdebt.com")).href.replace(/\/$/, "");
const canonical = `${site}/${repoSlug}`;

const history = data?.history ?? [];
const hasHistory = history.length > 0;
const archiveHistory =
  data?.history_kind === "public_star_actions" ||
  data?.history_approximate === true;
const firstYear = historyFirstYear(history);
const firstStarYear = firstYear !== null ? String(firstYear) : null;
const gained90 = hasHistory ? gainedInTrailingDays(history, 90) : null;
const gained30 = hasHistory ? gainedInTrailingDays(history, 30) : null;
const trend = hasHistory ? growthTrend(history) : null;
const milestones = hasHistory ? starMilestones(history) : [];
const lastDataDate = hasHistory ? history[history.length - 1].date : null;
const updatedLabel = formatMonthYear(
  data?.history_coverage_end ?? lastDataDate,
);
const createdFull = formatFullDate(data?.created_at ?? null);
const firstStarMonth = hasHistory ? formatMonthYear(history[0].date) : null;

const title = `${repoSlug} — star history & stats · gitdebt`;
const description = data
  ? `${repoSlug} has ${data.total_stars.toLocaleString()} GitHub stars${
      archiveHistory && gained90 !== null && gained90 > 0
        ? `, with about ${gained90.toLocaleString()} public star actions observed in the latest 90 days of archive coverage`
        : gained90 !== null && gained90 > 0
          ? `, up about ${gained90.toLocaleString()} in 90 days`
          : firstStarYear
            ? ` since ${firstStarYear}`
            : ""
    }. ${archiveHistory ? "Approximate public star-activity chart" : "Full star-history chart"} plus repo health: bug-magnet files, churn, contributors, commit heatmap, TODO trend.`
  : `Star history and repo-debt insights for ${repoSlug}.`;

const ogImage = `${apiBase}/api/repos/${owner}/${repo}/og.png`;

// Cold and failed pages stay out of search results until history is available.
const noindex = data === null || fetchError !== null || !hasHistory;

const faqs: { q: string; a: string }[] = [];
if (data && hasHistory) {
  faqs.push({
    q: `How many stars does ${repoSlug} have?`,
    a: `GitHub currently reports ${data.total_stars.toLocaleString()} stars for ${repoSlug}${
      !archiveHistory && gained90 !== null && gained90 > 0
        ? `, with about ${gained90.toLocaleString()} of them added in the last 90 days`
        : ""
    }.${archiveHistory ? ` The chart separately represents ${data.history_event_count.toLocaleString()} public star actions and can differ because public WatchEvents do not include unstars.` : ""}`,
  });
  if (gained90 !== null) {
    const pace =
      trend === "accelerating"
        ? ` That's faster than its lifetime average ${archiveHistory ? "activity" : "growth"} pace.`
        : trend === "slowing"
          ? ` That's below its lifetime average ${archiveHistory ? "activity" : "growth"} pace, which is common for mature projects.`
          : trend === "steady"
            ? ` That's in line with its lifetime average ${archiveHistory ? "activity" : "growth"} pace.`
            : "";
    faqs.push({
      q: archiveHistory
        ? `What does recent star activity look like for ${repo}?`
        : `How fast is ${repo} growing?`,
      a: archiveHistory
        ? `gitdebt observed about ${gained90.toLocaleString()} public star actions for ${repoSlug} over the latest 90 days of archive coverage${
            gained30 !== null ? ` (about ${gained30.toLocaleString()} in the latest 30)` : ""
          }. This is an approximate attention signal, not a net-star count, because unstars are not present.${pace}`
        : `${repoSlug} gained about ${gained90.toLocaleString()} stars over the last 90 days of its history${
            gained30 !== null ? ` (about ${gained30.toLocaleString()} in the last 30)` : ""
          } — figures are approximate for older repos, whose star history is downsampled.${pace}`,
    });
  }
  if (gained30 !== null) {
    faqs.push({
      q: `Is ${repo} still active?`,
      a: archiveHistory
        ? gained30 > 0
          ? `Public archive data shows about ${gained30.toLocaleString()} star actions for ${repoSlug} in the latest 30 days of coverage. For repository activity, use the commit heatmap, commit trend, and contributor charts on this page.`
          : `Public archive data shows no star actions for ${repoSlug} in the latest 30 days of coverage. That does not describe maintenance activity; use the commit heatmap and commit trend charts on this page.`
        : gained30 > 0
          ? `${repoSlug} is still attracting attention — about ${gained30.toLocaleString()} new GitHub stars in the most recent 30 days of its history. For commit-level signals, see the commit activity heatmap, commit trend, and contributors charts on this page.`
          : `${repoSlug} added no new stars in the most recent 30 days of its cached history. Star momentum isn't the whole picture — check the commit activity heatmap and commit trend charts on this page for maintenance signals.`,
    });
  }
  if (createdFull || firstStarMonth) {
    faqs.push({
      q: `When was ${repo} created?`,
      a: archiveHistory
        ? `${createdFull ? `${repoSlug} was created on ${createdFull}. ` : ""}The first public star activity observed for ${repoSlug} is from ${
            firstStarMonth ?? firstStarYear
          }.`
        : `${repoSlug}${createdFull ? ` was created on ${createdFull} and` : ""} earned its first GitHub star in ${
            firstStarMonth ?? firstStarYear
          }.`,
    });
  }
}

const jsonLd: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareSourceCode",
    name: repoSlug,
    codeRepository: `https://github.com/${repoSlug}`,
    url: canonical,
    description,
    ...(data?.created_at && { dateCreated: data.created_at.slice(0, 10) }),
    ...(data && {
      interactionStatistic: {
        "@type": "InteractionCounter",
        interactionType: { "@type": "LikeAction" },
        userInteractionCount: data.total_stars,
      },
    }),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "gitdebt",
        item: `${site}/`,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: owner,
        item: `${site}/u/${owner}`,
      },
      {
        "@type": "ListItem",
        position: 3,
        name: repoSlug,
        item: canonical,
      },
    ],
  },
];
if (faqs.length > 0) {
  jsonLd.push({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  });
}

const stats = [
  {
    name: "bug-magnets",
    label: "Bug-magnet files",
    desc: "Files with the most fix commits",
  },
  {
    name: "top-files",
    label: "Most-changed files",
    desc: "Files with the most commits in the analyzed window",
  },
  {
    name: "contributors",
    label: "Contributors",
    desc: "Everyone who's shipped code",
  },
  {
    name: "lines",
    label: "Lines of code",
    desc: "Per-language breakdown via tokei",
  },
  {
    name: "heatmap",
    label: "Commit activity",
    desc: "Last 52 weeks of contributions",
  },
  {
    name: "todo-trend",
    label: "TODO/FIXME trend",
    desc: "Running count of debt markers in source",
  },
  {
    name: "bus-factor",
    label: "Bus factor",
    desc: "How concentrated the commit knowledge is",
  },
  {
    name: "commit-trend",
    label: "Commit trend",
    desc: "Commit volume over the repo's lifetime",
  },
];
const primaryStatNames = new Set([
  "bug-magnets",
  "top-files",
  "bus-factor",
  "commit-trend",
]);
const primaryStats = stats.filter((stat) => primaryStatNames.has(stat.name));

const repoCategories = categoriesForRepo(repoSlug);
const categoryRelated = relatedRepos(repoSlug, 6);
const FALLBACK_SUGGESTIONS = [
  "facebook/react",
  "vuejs/vue",
  "sveltejs/svelte",
  "rust-lang/rust",
];
const vsLinks = (categoryRelated.length > 0 ? categoryRelated : FALLBACK_SUGGESTIONS)
  .filter((s) => s !== repoSlug)
  .slice(0, 3);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead />
    <Seo
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      ogImage={ogImage}
      imageAlt={`Star history social card for ${repoSlug}`}
      noindex={noindex}
      jsonLd={jsonLd}
    />
  </head>
  <body>
    <div class="isolate flex min-h-dvh flex-col">
      <SiteHeader />

      <main id="main-content" class="mx-auto flex w-full max-w-5xl flex-1 flex-col gap-10 px-6 py-12">
        <nav aria-label="Breadcrumb" class="font-mono text-xs text-muted-foreground">
          <a href="/" class="hover:text-foreground">gitdebt</a>
          <span class="px-1.5 text-border" aria-hidden="true">/</span>
          <a href={`/u/${owner}`} class="hover:text-foreground">{owner}</a>
          <span class="px-1.5 text-border" aria-hidden="true">/</span>
          <span class="text-foreground">{repo}</span>
        </nav>

        <RepoHero
          client:load
          owner={owner}
          repo={repo}
          apiBase={apiBase}
          initialData={data}
        />

        <ChartViewer
          client:load
          apiBase={apiBase}
          path={`/api/repos/${owner}/${repo}/chart.svg`}
          alt={`${archiveHistory ? "Approximate public star activity" : "Star history"} for ${repoSlug}`}
          caption={archiveHistory ? "Approximate public star activity" : "Cumulative star history"}
          priority={true}
          liveRepo={repoSlug}
          embedLink={canonical}
          label={repoSlug}
        />

        {faqs.length > 0 && (
          <section class="space-y-4">
            <header class="flex flex-wrap items-baseline justify-between gap-2">
              <h2 class="text-xl font-semibold tracking-tight">
                {repoSlug} at a glance
              </h2>
              {updatedLabel && (
                <p class="font-mono text-xs text-muted-foreground">
                  {archiveHistory ? "Archive coverage through" : "Latest recorded star"}{" "}
                  {updatedLabel}
                </p>
              )}
            </header>
            <div class="grid gap-x-8 gap-y-6 sm:grid-cols-2">
              {faqs.map((f) => (
                <article class="space-y-1.5 border-t border-border pt-5">
                  <h3 class="text-base font-medium sm:text-sm">{f.q}</h3>
                  <p class="text-base text-pretty text-muted-foreground sm:text-sm">{f.a}</p>
                </article>
              ))}
            </div>
            {milestones.length > 0 && (
              <p class="text-base text-muted-foreground sm:text-sm">
                <strong class="font-mono tracking-wide uppercase">
                  {archiveHistory ? "Observed activity milestones:" : "Star milestones:"}
                </strong>{" "}
                {milestones.map((m, i) => (
                  <>
                    {i > 0 && <span aria-hidden="true"> · </span>}
                    <span class="whitespace-nowrap">
                      {formatCompact(m.threshold)} around {formatMonthYear(m.date)}
                    </span>
                  </>
                ))}
              </p>
            )}
          </section>
        )}

        <section id="stats" class="scroll-mt-24 space-y-6">
          <header class="max-w-2xl space-y-2">
            <p class="font-mono text-xs tracking-wide text-muted-foreground uppercase">
              Maintenance signals
            </p>
            <h2 class="text-2xl font-semibold tracking-tight text-balance sm:text-3xl">
              What deserves attention first
            </h2>
            <p class="text-base leading-relaxed text-pretty text-muted-foreground">
              Start with fix concentration, file churn, ownership risk, and
              maintenance cadence. These four views are the fastest way to
              locate structural pressure in {repoSlug}.
            </p>
          </header>
          <div class="grid gap-6 sm:grid-cols-2">
            {primaryStats.map((s) => (
              <StatCard
                client:load
                src={`${apiBase}/api/repos/${owner}/${repo}/stats/${s.name}.svg`}
                alt={`${s.label} for ${repoSlug}`}
                caption={s.label}
                apiBase={apiBase}
                embedLink={canonical}
                priority={true}
                liveRepo={repoSlug}
              />
            ))}
          </div>
          <SecondarySignals
            client:visible
            apiBase={apiBase}
            repoBase={`${apiBase}/api/repos/${owner}/${repo}`}
            slug={repoSlug}
            embedLink={canonical}
          />
        </section>

        <section class="space-y-6">
          <header class="max-w-2xl space-y-2">
            <p class="font-mono text-xs tracking-wide text-muted-foreground uppercase">
              Adoption
            </p>
            <h2 class="text-2xl font-semibold tracking-tight text-balance sm:text-3xl">
              Attention versus real usage
            </h2>
          </header>
          <UsageSection
            client:visible
            owner={owner}
            repo={repo}
            apiBase={apiBase}
            initialData={usage}
            showEmbed={false}
          />
        </section>

        <section class="space-y-4 border-y border-border py-6">
          <header class="space-y-1">
            <p class="font-mono text-xs tracking-wide text-muted-foreground uppercase">
              Context
            </p>
            <h2 class="text-xl font-semibold tracking-tight">
              How does {repoSlug} stack up?
            </h2>
          </header>
          <div class="flex flex-wrap items-center gap-2">
            {vsLinks.map((other) => (
              <a
                href={`/vs/${repoSlug}/${other}`}
                data-warm-repos={`${repoSlug},${other}`}
                class="inline-flex min-h-11 items-center gap-1.5 rounded-md border border-border bg-background px-3 py-2 font-mono text-base text-muted-foreground hover:bg-accent hover:text-accent-foreground sm:min-h-0 sm:py-1.5 sm:text-sm"
              >
                vs {other}
              </a>
            ))}
            <a
              href={`/compare?repos=${encodeURIComponent(repoSlug)}`}
              class={buttonVariants({ variant: "outline", size: "sm" })}
            >
              Compare with any repo
            </a>
          </div>
          {repoCategories.length > 0 && (
            <p class="text-base text-muted-foreground sm:text-sm">
              {repoSlug} is featured in{" "}
              {repoCategories.map((c, i) => (
                <>
                  {i > 0 && ", "}
                  <a
                    href={`/compare/${c.slug}`}
                    class="underline decoration-signal/60 underline-offset-4 hover:decoration-signal"
                  >
                    {c.name} compared
                  </a>
                </>
              ))}
              {" "}— see how the whole category stacks up.
            </p>
          )}
        </section>

        <WarmRepos
          client:load
          apiBase={apiBase}
          repos={[repoSlug, ...vsLinks]}
        />
      </main>

      <SiteFooter />
    </div>
  </body>
</html>
