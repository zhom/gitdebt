---
import "@/styles/globals.css";
import { staticComparisonPaths } from "@/lib/build-catalog";
import { staticApiBase } from "@/lib/static-api-base";
import {
  loadBuildRepoSnapshot,
} from "@/lib/build-repo-snapshot";
import BaseHead from "@/components/BaseHead.astro";
import Seo from "@/components/Seo.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { LiveVsComparison } from "@/components/LiveVsComparison";

export function getStaticPaths() {
  return staticComparisonPaths();
}

const {
  owner1: rawOwner1,
  repo1: rawRepo1,
  owner2: rawOwner2,
  repo2: rawRepo2,
} = Astro.params;

const validSlug = /^[A-Za-z0-9._-]+$/;
if (
  !rawOwner1 ||
  !rawRepo1 ||
  !rawOwner2 ||
  !rawRepo2 ||
  !validSlug.test(rawOwner1) ||
  !validSlug.test(rawRepo1) ||
  !validSlug.test(rawOwner2) ||
  !validSlug.test(rawRepo2)
) {
  return new Response("Not found", { status: 404 });
}

const lower1 = rawOwner1.toLowerCase();
const lowerR1 = rawRepo1.toLowerCase();
const lower2 = rawOwner2.toLowerCase();
const lowerR2 = rawRepo2.toLowerCase();
const slugA = `${lower1}/${lowerR1}`;
const slugB = `${lower2}/${lowerR2}`;
const [first, second] = slugA <= slugB
  ? [[lower1, lowerR1], [lower2, lowerR2]]
  : [[lower2, lowerR2], [lower1, lowerR1]];
const canonicalPathname = `/vs/${first[0]}/${first[1]}/${second[0]}/${second[1]}`;
const rawPathname = `/vs/${rawOwner1}/${rawRepo1}/${rawOwner2}/${rawRepo2}`;
if (rawPathname !== canonicalPathname) {
  return new Response("Not found", { status: 404 });
}

const owner1 = first[0];
const repo1 = first[1];
const owner2 = second[0];
const repo2 = second[1];

const apiBase = staticApiBase();

const [left, right] = await Promise.all([
  loadBuildRepoSnapshot(`${owner1}/${repo1}`),
  loadBuildRepoSnapshot(`${owner2}/${repo2}`),
]);

const slug1 = `${owner1}/${repo1}`;
const slug2 = `${owner2}/${repo2}`;
const bothLoaded = left.data !== null && right.data !== null;
const fetchError = left.error ?? right.error;
const ready =
  bothLoaded &&
  left.data!.history.length > 0 &&
  right.data!.history.length > 0;

const reposParam = encodeURIComponent(`${slug1},${slug2}`);
const overlayPath = `/api/chart.svg?repos=${reposParam}`;

const title = `${repo1} vs ${repo2}: stars, code, and maintenance · gitdebt`;
const description = `Compare ${slug1} and ${slug2} by GitHub star growth, forks, dominant language, codebase size, commit cadence, bus factor, contributor concentration, and change pressure.`;
const site = (Astro.site ?? new URL("https://gitdebt.com")).href.replace(/\/$/, "");
const canonicalPath = `/vs/${slug1}/${slug2}`;
const canonical = `${site}${canonicalPath}`;

const ogImage = `${apiBase}/api/og.png?repos=${reposParam}`;

const noindex = !ready || fetchError !== null;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: `${slug1} vs ${slug2}`,
    url: canonical,
    description,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "gitdebt", item: `${site}/` },
      { "@type": "ListItem", position: 2, name: "Compare", item: `${site}/compare` },
      { "@type": "ListItem", position: 3, name: `${slug1} vs ${slug2}`, item: canonical },
    ],
  },
];

---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead />
    <Seo
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      ogImage={ogImage}
      imageAlt={`Star history comparison card for ${slug1} versus ${slug2}`}
      noindex={noindex}
      jsonLd={jsonLd}
    />
  </head>
  <body>
    <div class="isolate flex min-h-dvh flex-col">
      <SiteHeader />

      <main id="main-content" class="mx-auto min-w-0 w-full max-w-6xl flex-1 px-6 py-12">
        <nav aria-label="Breadcrumb" class="font-mono text-[11px] text-muted-foreground">
          <a
            href="/"
            class="rounded outline-none transition-colors duration-150 hover:text-foreground focus-visible:ring-2 focus-visible:ring-accent/30"
            >gitdebt</a
          >
          <span class="px-1.5 text-border" aria-hidden="true">/</span>
          <a
            href="/compare"
            class="rounded outline-none transition-colors duration-150 hover:text-foreground focus-visible:ring-2 focus-visible:ring-accent/30"
            >vs</a
          >
          <span class="px-1.5 text-border" aria-hidden="true">/</span>
          <span class="text-foreground">{slug1} · {slug2}</span>
        </nav>

        <LiveVsComparison
          client:load
          apiBase={apiBase}
          canonical={canonical}
          initialLeft={left.data}
          initialRight={right.data}
          overlayPath={overlayPath}
          slug1={slug1}
          slug2={slug2}
        />
      </main>

      <SiteFooter
        signalValues={[
          left.data?.total_stars ?? 0,
          right.data?.total_stars ?? 0,
          left.data?.history.length ?? 0,
          right.data?.history.length ?? 0,
        ]}
      />
    </div>
  </body>
</html>
