---
export const prerender = true;

import "@/styles/globals.css";

import BaseHead from "@/components/BaseHead.astro";
import { ButtonLink } from "@/components/ButtonLink";
import Seo from "@/components/Seo.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { ComparisonModeGraphic } from "@/components/ComparisonModeGraphic";
import { DitherField } from "@/components/DitherField";
import { LandingRepoLookup } from "@/components/LandingRepoLookup";
import { GrowthTicker } from "@/components/GrowthTicker";
import { PlatformPulse } from "@/components/PlatformPulse";
import { ReportLayerGraphic } from "@/components/ReportLayerGraphic";
import { SignalFlowGraphic } from "@/components/SignalFlowGraphic";
import { StatStrip } from "@/components/StatStrip";
import { ThemeEmbedPreview } from "@/components/ThemeEmbedPreview";
import { WarmRepos } from "@/components/WarmRepos";
import {
  BODY,
  EYEBROW,
  HEADING,
  ROW,
  ROW_BADGE,
  SECTION_ACTION,
  SECTION_HEADER,
  TILE,
  TILE_DESC,
  TILE_TITLE,
} from "@/components/style-tokens";
import { CATEGORIES } from "@/data/categories";
import { staticApiBase } from "@/lib/static-api-base";

const apiBase = staticApiBase();
const site = (Astro.site ?? new URL("https://gitdebt.com")).href.replace(/\/$/, "");

const title = "GitHub star history & repository health charts | gitdebt";
const description =
  "Get GitHub repository stats in one live report: star history, growth, churn, contributors, bus factor, bug magnets, package usage, and README-ready charts.";
const ogImage = `${apiBase}/api/og.png`;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "gitdebt",
    url: `${site}/`,
    description,
    applicationCategory: "DeveloperApplication",
    operatingSystem: "Any",
    browserRequirements: "Requires JavaScript for live report updates",
    isAccessibleForFree: true,
    license: "https://opensource.org/license/mit",
    codeRepository: "https://github.com/zhom/gitdebt",
    author: {
      "@type": "Organization",
      name: "Internet Technology Services LLC",
    },
    offers: {
      "@type": "Offer",
      price: 0,
      priceCurrency: "USD",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "gitdebt",
    url: `${site}/`,
    description,
  },
];

const heroStats = [
  { label: "Stars", value: "Full history" },
  { label: "Code", value: "Health signals" },
  { label: "Share", value: "README embeds" },
];

const reportLayers = [
  {
    graphic: "stars" as const,
    title: "Star history",
    desc: "See when attention arrived. Compare launches by calendar date or from day zero in the comparison tool.",
    link: "/compare",
  },
  {
    graphic: "health" as const,
    title: "Repository health",
    desc: "Find churn, bug magnets, bus factor, contributor concentration, and TODO drift on any report.",
    link: "/facebook/react",
  },
  {
    graphic: "readme" as const,
    title: "README stats",
    desc: "Embed theme-aware SVG, PNG, WebP, and GIF charts that link back to the live report.",
    link: "/badges",
  },
];

const popularPairs = [
  ["facebook/react", "vuejs/vue"],
  ["denoland/deno", "oven-sh/bun"],
  ["django/django", "fastapi/fastapi"],
  ["gatsbyjs/gatsby", "vercel/next.js"],
].map((repos) => ({
  repos: [...repos].sort(),
  label: repos.map((repo) => repo.split("/")[1]).join(" vs "),
}));

const featuredCategorySlugs = [
  "frontend-frameworks",
  "build-tools",
  "ai-coding-tools",
  "sql-databases",
];
const featuredCategories = featuredCategorySlugs.flatMap((slug) => {
  const category = CATEGORIES.find((candidate) => candidate.slug === slug);
  return category ? [category] : [];
});
const landingWarmRepos = Array.from(
  new Set([
    ...popularPairs.flatMap((pair) => pair.repos),
    ...featuredCategories.flatMap((category) => category.repos),
  ]),
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead />
    <Seo
      title={title}
      description={description}
      canonicalPath="/"
      ogImage={ogImage}
      jsonLd={jsonLd}
    />
  </head>
  <body>
    <div class="isolate flex min-h-dvh flex-col">
      <SiteHeader />

      <main id="main-content" class="flex-1 bg-background text-foreground">
        <section id="top" class="relative isolate overflow-hidden">
          <DitherField client:idle />
          <div class="mx-auto max-w-6xl px-6 py-16 sm:py-24 lg:py-28">
            <div class="grid gap-14 lg:grid-cols-[minmax(0,1.08fr)_minmax(24rem,0.92fr)] lg:items-center">
              <div class="min-w-0">
                <p class="dither-chip reveal" style="--reveal-delay:0ms">
                  <span
                    class="size-1.5 shrink-0 rounded-full bg-[var(--swatch-green)]"
                    aria-hidden="true"></span>
                  Built from public GitHub data
                </p>
                <h1
                  class="reveal mt-6 max-w-[18ch] text-4xl tracking-tight text-balance sm:text-5xl lg:text-6xl"
                  style="--reveal-delay:90ms"
                >
                  Star history and repo health for any GitHub repo.
                </h1>
                <p
                  class="reveal mt-5 max-w-[54ch] text-[15px] leading-relaxed text-pretty text-muted-foreground"
                  style="--reveal-delay:180ms"
                >
                  Star history, growth, churn, contributors, bus factor, and
                  bug magnets—live, shareable, and README-ready.
                </p>

                <div
                  id="lookup"
                  class="reveal mt-8 scroll-mt-24"
                  style="--reveal-delay:260ms"
                >
                  <LandingRepoLookup client:load />
                </div>

                <div class="reveal mt-8" style="--reveal-delay:300ms">
                  <StatStrip
                    columns={3}
                    items={heroStats}
                    aria-label="What every report covers"
                  />
                </div>
              </div>

              <SignalFlowGraphic client:load apiBase={apiBase} />
            </div>
          </div>
          <GrowthTicker client:load apiBase={apiBase} />
        </section>

        <div class="mx-auto max-w-6xl px-6 pb-16">
          <section
            id="live"
            class="mt-16 scroll-mt-24 border-t border-border/60 pt-12"
          >
            <div class={SECTION_HEADER}>
              <h2 class={HEADING}>What people are looking at right now</h2>
              <a href="/leaderboard" class={SECTION_ACTION}>
                leaderboard
                <span
                  aria-hidden="true"
                  class="transition-transform duration-150 group-hover:translate-x-0.5 motion-reduce:transition-none"
                  >→</span
                >
              </a>
            </div>
            <p class:list={["mt-2 max-w-[62ch]", BODY]}>
              Live GitHub star totals, report views, history progress, and
              repository-health status—straight from gitdebt’s stored data.
            </p>
            <div class="mt-6">
              <PlatformPulse client:load apiBase={apiBase} />
            </div>
          </section>

          <section
            id="how-it-works"
            class="mt-16 scroll-mt-24 border-t border-border/60 pt-12"
          >
            <div class={SECTION_HEADER}>
              <h2 class={HEADING}>Popularity, momentum, and maintenance</h2>
              <a href="/facebook/react" class={SECTION_ACTION}>
                see a full report
                <span
                  aria-hidden="true"
                  class="transition-transform duration-150 group-hover:translate-x-0.5 motion-reduce:transition-none"
                  >→</span
                >
              </a>
            </div>
            <p class:list={["mt-2 max-w-[64ch]", BODY]}>
              Current stars show size. Star history shows growth. Commit
              history shows where maintaining the code gets expensive.
            </p>

            <ul
              id="features"
              role="list"
              class="mt-10 grid scroll-mt-24 gap-x-12 gap-y-14 sm:grid-cols-3"
            >
              {reportLayers.map((layer) => (
                <li>
                  <a href={layer.link} class={TILE}>
                    <div
                      inert
                      class="flex h-24 items-center overflow-hidden opacity-80 transition-opacity duration-200 group-hover:opacity-100 motion-reduce:transition-none"
                    >
                      <ReportLayerGraphic client:visible kind={layer.graphic} />
                    </div>
                    <h3 class={TILE_TITLE}>{layer.title}</h3>
                    <p class={TILE_DESC}>{layer.desc}</p>
                  </a>
                </li>
              ))}
            </ul>
          </section>

          <section
            id="compare"
            class="mt-16 scroll-mt-24 border-t border-border/60 pt-12"
          >
            <div class={SECTION_HEADER}>
              <h2 class={HEADING}>Compare growth, not just totals</h2>
              <a href="/compare" class={SECTION_ACTION}>
                comparison builder
                <span
                  aria-hidden="true"
                  class="transition-transform duration-150 group-hover:translate-x-0.5 motion-reduce:transition-none"
                  >→</span
                >
              </a>
            </div>
            <p class:list={["mt-2 max-w-[62ch]", BODY]}>
              Put up to eight GitHub star histories on one chart. Switch
              between calendar time and equal-start growth.
            </p>

            <div class="mt-8 grid gap-12 lg:grid-cols-[1.12fr_0.88fr] lg:items-start">
              <ComparisonModeGraphic client:idle />

              <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-1">
                <div>
                  <p class={EYEBROW}>Head to head</p>
                  <ul role="list" class="mt-3">
                    {popularPairs.map((pair) => (
                      <li>
                        <a
                          href={`/vs/${pair.repos[0]}/${pair.repos[1]}`}
                          data-warm-repos={pair.repos.join(",")}
                          class={ROW}
                        >
                          <span class="min-w-0 flex-1 truncate">{pair.label}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>

                <div>
                  <p class={EYEBROW}>Curated fields</p>
                  <ul role="list" class="mt-3">
                    {featuredCategories.map((category) => (
                      <li>
                        <a
                          href={`/compare/${category.slug}`}
                          data-warm-repos={category.repos.join(",")}
                          class={ROW}
                        >
                          <span class="min-w-0 flex-1 truncate">
                            {category.name}
                          </span>
                          <span class={ROW_BADGE}>{category.repos.length}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>

            <div class="mt-8">
              <ButtonLink
                client:visible
                href="/compare"
                variant="outline"
                pulse
              >
                Build a comparison
              </ButtonLink>
            </div>
          </section>

          <section
            id="share"
            class="mt-16 scroll-mt-24 border-t border-border/60 pt-12"
          >
            <div class={SECTION_HEADER}>
              <h2 class={HEADING}>README stats, ready to paste</h2>
              <a href="/badges" class={SECTION_ACTION}>
                badge studio
                <span
                  aria-hidden="true"
                  class="transition-transform duration-150 group-hover:translate-x-0.5 motion-reduce:transition-none"
                  >→</span
                >
              </a>
            </div>
            <p class:list={["mt-2 max-w-[62ch]", BODY]}>
              Add star history, health cards, and badges to any GitHub README
              with a theme-aware <code class="font-mono text-[12px] text-foreground"
                >&lt;picture&gt;</code
              > snippet.
            </p>

            <div class="mt-8 grid gap-12 lg:grid-cols-[1.08fr_0.92fr] lg:items-start">
              <ThemeEmbedPreview client:idle />

              <div>
                <p class={EYEBROW}>What you paste</p>
                <ul role="list" class:list={["mt-3 space-y-2", BODY]}>
                  <li>One snippet, light and dark variants behind it.</li>
                  <li>Cacheable image URLs; attribution stays on the link.</li>
                  <li>Static by default — animation is always explicit.</li>
                </ul>
                <div class="mt-6">
                  <ButtonLink
                    client:visible
                    href="/badges"
                    variant="outline"
                    pulse
                  >
                    Open the badge studio
                  </ButtonLink>
                </div>
              </div>
            </div>
          </section>

        </div>

        <section class="relative isolate overflow-hidden border-t border-border/60">
          <DitherField
            client:idle
            render="static"
            opacity={0.14}
            vignette={0.7}
            colors={["#12161f", "#1d2b45"]}
          />
          <div class="mx-auto flex max-w-6xl flex-col gap-6 px-6 py-16 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <h2 class={HEADING}>Look up any public repository</h2>
              <p class:list={["mt-2 max-w-[52ch]", BODY]}>
                Free, public, open source, and ready to embed.
              </p>
            </div>
            <ButtonLink
              client:visible
              href="#lookup"
              variant="outline"
              size="lg"
              pulse
            >
              Analyze a repository
            </ButtonLink>
          </div>
        </section>

        <WarmRepos client:load apiBase={apiBase} repos={landingWarmRepos} />
      </main>

      <SiteFooter showExtensionLink={false} />
    </div>
  </body>
</html>
