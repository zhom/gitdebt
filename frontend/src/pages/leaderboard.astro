---
import "@/styles/globals.css";
import { staticApiBase } from "@/lib/static-api-base";
import BaseHead from "@/components/BaseHead.astro";
import Seo from "@/components/Seo.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { MomentumBoard } from "@/components/MomentumBoard";
import { weeklyPace } from "@/lib/momentum";
import {
  BODY,
  CAPTION,
  HEADING,
  PANEL_PADDED,
  ROW,
  ROW_BADGE,
  SECTION_ACTION,
  SECTION_HEADER,
  TITLE,
} from "@/components/style-tokens";
import { CATEGORIES } from "@/data/categories";

const apiBase = staticApiBase();
const site = (Astro.site ?? new URL("https://gitdebt.com")).href.replace(/\/$/, "");

type LeaderboardRow = {
  rank: number;
  repo: string;
  stars: number;
  velocity: number;
};
type LeaderboardResponse = {
  metric: string;
  page: number;
  per_page: number;
  window_days: number;
  repos: LeaderboardRow[];
};

async function fetchJson<T>(url: string): Promise<T | null> {
  for (let attempt = 0; attempt < 3; attempt += 1) {
    try {
      const res = await fetch(url, {
        headers: { accept: "application/json" },
        signal: AbortSignal.timeout(20_000),
      });
      if (res.ok) return (await res.json()) as T;
      if (res.status < 500 && res.status !== 429) return null;
    } catch {}

    if (attempt < 2) {
      await new Promise((resolve) =>
        setTimeout(resolve, 500 * 2 ** attempt),
      );
    }
  }
  return null;
}

async function fetchBoard(
  metric: "stars" | "velocity",
  window = 7,
): Promise<LeaderboardResponse | null> {
  // The deepest page the API allows. Depth is what makes the merge work: a
  // repository has to appear in more than one window before its windows can be
  // compared, and at the previous fifty the overlap was thin enough that most
  // rows had nothing to compare.
  return fetchJson<LeaderboardResponse>(
    `${apiBase}/api/leaderboard.json?metric=${metric}&window=${window}&per=100&page=0`,
  );
}

const [dailyBoard, weeklyBoard, monthlyBoard, starsBoard, totalAnalyzed] = await Promise.all([
  fetchBoard("velocity", 1),
  fetchBoard("velocity", 7),
  fetchBoard("velocity", 30),
  fetchBoard("stars"),
  (async () => {
    const result = await fetchJson<{ total?: number }>(
      `${apiBase}/api/sitemap/repos?page=0&per=1`,
    );
    return typeof result?.total === "number" ? result.total : null;
  })(),
]);

const trending = weeklyBoard?.repos ?? [];
const mostStarred = starsBoard?.repos ?? [];

// One row per repository, carrying every window at once.
//
// The page used to render the same repositories in four separate lists with one
// number each, which is why it could never answer whether a repo was rising or
// fading. A window a repo is absent from stays `null` rather than 0: the API
// returns a top-N per window, so absence means "not ranked here", not "gained
// nothing".
type Merged = {
  repo: string;
  stars: number;
  d1: number | null;
  d7: number | null;
  d30: number | null;
};
const merged = new Map<string, Merged>();
const absorb = (
  rows: LeaderboardRow[] | undefined,
  field: "d1" | "d7" | "d30" | null,
) => {
  for (const row of rows ?? []) {
    const existing = merged.get(row.repo) ?? {
      repo: row.repo,
      stars: row.stars,
      d1: null,
      d7: null,
      d30: null,
    };
    existing.stars = Math.max(existing.stars, row.stars);
    if (field) existing[field] = row.velocity;
    merged.set(row.repo, existing);
  }
};
absorb(dailyBoard?.repos, "d1");
absorb(weeklyBoard?.repos, "d7");
absorb(monthlyBoard?.repos, "d30");
absorb(starsBoard?.repos, null);

// Ranked by the weekly rate, which is the window the page has always led with.
//
// A repository ranked in no velocity window at all is excluded: it reached this
// set only through the most-starred board, so it has no pace to be ranked by
// and every momentum column on its row would be a dash. Carrying it would cost
// a row of vertical space to say nothing. Its size still shows wherever it does
// have movement, and the stars column carries size for every row that stays.
const rankedRows = [...merged.values()]
  .filter((row) => row.d1 !== null || row.d7 !== null || row.d30 !== null)
  .sort((a, b) => {
    const delta = weeklyPace(b) - weeklyPace(a);
    return delta !== 0 ? delta : b.stars - a.stars;
  });
const loaded = dailyBoard !== null || weeklyBoard !== null || monthlyBoard !== null || starsBoard !== null;
const hasRows = rankedRows.length > 0;
const windowDays = weeklyBoard?.window_days ?? 7;

const top = trending[0] ?? null;
const topStarred = mostStarred[0] ?? null;
const runnerUp = trending[1] ?? null;

const vsPair =
  top && runnerUp
    ? [top.repo, runnerUp.repo].sort((a, b) => (a < b ? -1 : 1))
    : null;
const vsLabel = top && runnerUp ? `${top.repo} vs ${runnerUp.repo}` : null;

const updatedDate = new Date().toLocaleDateString("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});
const year = new Date().getUTCFullYear();

const title = `Fastest-growing GitHub repos (${year}) · gitdebt`;
const description = top
  ? `${top.repo} leads the gitdebt leaderboard with ${top.velocity.toLocaleString()} stars gained in ${windowDays} days. See the fastest-growing and most-starred repos, from public star timestamps.`
  : `Fastest-growing and most-starred GitHub repos, ranked from public star timestamps across every repo gitdebt has analyzed. Updated daily.`;

const canonicalPath = "/leaderboard";
const ogImage = `${apiBase}/api/og.png`;

const noindex = !loaded || !hasRows;

const featuredCategories = CATEGORIES.slice(0, 8);

const jsonLd: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: "GitHub repo leaderboard — fastest-growing & most-starred",
    url: `${site}/leaderboard`,
    description,
    dateModified: new Date().toISOString().slice(0, 10),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "gitdebt", item: `${site}/` },
      { "@type": "ListItem", position: 2, name: "Leaderboard", item: `${site}/leaderboard` },
    ],
  },
];
if (trending.length > 0) {
  jsonLd.push({
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: `Fastest-growing GitHub repos (trailing ${windowDays} days)`,
    itemListOrder: "https://schema.org/ItemListOrderDescending",
    numberOfItems: trending.length,
    itemListElement: trending.slice(0, 25).map((r) => ({
      "@type": "ListItem",
      position: r.rank,
      name: r.repo,
      url: `${site}/${r.repo}`,
    })),
  });
}
if (mostStarred.length > 0) {
  jsonLd.push({
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Most-starred repos on gitdebt",
    itemListOrder: "https://schema.org/ItemListOrderDescending",
    numberOfItems: mostStarred.length,
    itemListElement: mostStarred.slice(0, 25).map((r) => ({
      "@type": "ListItem",
      position: r.rank,
      name: r.repo,
      url: `${site}/${r.repo}`,
    })),
  });
}
if (top && topStarred) {
  jsonLd.push({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: [
      {
        "@type": "Question",
        name: "What is the fastest-growing repo on gitdebt right now?",
        acceptedAnswer: {
          "@type": "Answer",
          text: `${top.repo} is the fastest-growing repo gitdebt tracks, gaining ${top.velocity.toLocaleString()} GitHub stars in the last ${windowDays} days (as of ${updatedDate}). The full ranking is computed from public stargazer timestamps.`,
        },
      },
      {
        "@type": "Question",
        name: "How is the gitdebt leaderboard computed?",
        acceptedAnswer: {
          "@type": "Answer",
          text: `Rankings come from public GitHub star timestamps cached by gitdebt${totalAnalyzed ? ` across the ${totalAnalyzed.toLocaleString()} repos it has analyzed` : ""}. "Fastest-growing" counts stars added in the trailing ${windowDays} days; "most-starred" ranks by current total stars. No repo is ranked until its full star history has been fetched.`,
        },
      },
    ],
  });
}

const sectionLinks = [
  { href: "#trending-daily", label: "Daily" },
  { href: "#trending-weekly", label: "Weekly" },
  { href: "#trending-monthly", label: "Monthly" },
  { href: "#most-starred", label: "Most starred" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead />
    <Seo
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      ogImage={ogImage}
      noindex={noindex}
      jsonLd={jsonLd}
    />
  </head>
  <body>
    <div class="isolate flex min-h-dvh flex-col">
      <SiteHeader />

      <main id="main-content" class="mx-auto w-full max-w-[88rem] flex-1 px-6 py-12">
        <nav aria-label="Breadcrumb" class="font-mono text-[11px] text-muted-foreground">
          <a
            href="/"
            class="rounded outline-none transition-colors duration-150 hover:text-foreground focus-visible:ring-2 focus-visible:ring-accent/30"
            >gitdebt</a
          >
          <span class="px-1.5 text-border" aria-hidden="true">/</span>
          <span class="text-foreground">leaderboard</span>
        </nav>

        <header class="mt-8">
          <h1 class={TITLE}>Fastest-growing & most-starred repos</h1>
          {top ? (
            <p class:list={["mt-3 max-w-[68ch] text-[15px]", BODY]}>
              <a
                href={`/${top.repo}`}
                class="rounded text-foreground underline decoration-border underline-offset-4 outline-none transition-colors duration-150 hover:decoration-foreground/60 focus-visible:ring-2 focus-visible:ring-accent/30"
                >{top.repo}</a
              >
              {" "}is the fastest-growing repo gitdebt tracks right now, gaining{" "}
              <span class="text-foreground tabular-nums">{top.velocity.toLocaleString()}</span> stars in the
              last {windowDays} days. Rankings are computed from public star timestamps
              {totalAnalyzed
                ? ` across the ${totalAnalyzed.toLocaleString()} repos gitdebt has analyzed`
                : " across every repo gitdebt has analyzed"} — repos join the board once
              their full star history is cached.
            </p>
          ) : (
            <p class:list={["mt-3 max-w-[68ch] text-[15px]", BODY]}>
              Repos ranked by star growth and total stars, computed from public star
              timestamps across every repo gitdebt has analyzed.
            </p>
          )}
          <p class:list={["mt-3 font-mono", CAPTION]}>
            Data updated {updatedDate} · rankings refreshed daily from cached public history
          </p>
          <nav class="mt-4 flex flex-wrap gap-2" aria-label="Leaderboard sections">
            {sectionLinks.map((link) => (
              <a
                href={link.href}
                class="dither-chip rounded-md outline-none focus-visible:ring-2 focus-visible:ring-accent/30"
              >
                {link.label}
              </a>
            ))}
          </nav>
        </header>

        {!loaded && (
          <section class:list={["mt-12", PANEL_PADDED]} role="alert">
            <p class="font-mono text-[10px] tracking-[0.25em] text-[var(--swatch-red)] uppercase">
              Leaderboard unavailable
            </p>
            <p class:list={["mt-2", BODY]}>
              We couldn't load the rankings. Try again in a moment.
            </p>
          </section>
        )}

        {loaded && !hasRows && (
          <section class:list={["mt-12", PANEL_PADDED]}>
            <p class={BODY}>
              No repos have a complete star history yet. Look up any repo to start
              tracking it — it joins the leaderboard as soon as its history is cached.
            </p>
          </section>
        )}

        {loaded && hasRows && (
          <section id="ranking" class="mt-10 scroll-mt-24">
            <div class={SECTION_HEADER}>
              <h2 class={HEADING}>Every tracked repo, ranked by weekly pace</h2>
              <p class={CAPTION}>
                <span style="color: rgb(40 210 110)">▲</span> climbing ·
                <span style="color: rgb(255 150 50)">▼</span> cooling · today vs its 30-day pace
              </p>
            </div>
            {vsPair && vsLabel && (
              <p class:list={["mt-2", BODY]}>
                Compare the top two directly:{" "}
                <a
                  href={`/vs/${vsPair[0]}/${vsPair[1]}`}
                  class="rounded underline decoration-border underline-offset-4 outline-none transition-colors duration-150 hover:text-foreground hover:decoration-foreground/60 focus-visible:ring-2 focus-visible:ring-accent/30"
                >
                  {vsLabel}
                </a>.
              </p>
            )}
            <div class="mt-4">
              <MomentumBoard client:visible rows={rankedRows} />
            </div>
            <p class:list={["mt-3", CAPTION]}>
              Bar length is the weekly pace; the brighter tip is today's, on the same
              per-day scale — a short bar with a bright tip is a repo spiking right now.
              A dash means the repo is outside that window's top ranks, not that it
              gained nothing.
            </p>
          </section>
        )}


        <section class="mt-16 scroll-mt-24 border-t border-border/60 pt-12">
          <div class={SECTION_HEADER}>
            <h2 class={HEADING}>Browse by category</h2>
            <a href="/compare#categories" class={SECTION_ACTION}>
              all categories
              <span
                aria-hidden="true"
                class="transition-transform duration-150 group-hover:translate-x-0.5 motion-reduce:transition-none"
                >→</span
              >
            </a>
          </div>
          <ul role="list" class="mt-6 grid gap-x-10 sm:grid-cols-2">
            {featuredCategories.map((c) => (
              <li>
                <a href={`/compare/${c.slug}`} class={ROW}>
                  <span class="min-w-0 flex-1 py-2">
                    <span class="block truncate">{c.name}</span>
                    <span class="mt-0.5 block truncate text-[11px] text-muted-foreground/80 group-hover:text-muted-foreground">
                      {c.short}
                    </span>
                  </span>
                  <span class={ROW_BADGE}>{c.repos.length}</span>
                </a>
              </li>
            ))}
          </ul>
          <p class:list={["mt-6", BODY]}>
            Or{" "}
            <a
              href="/compare"
              class="rounded underline decoration-border underline-offset-4 outline-none transition-colors duration-150 hover:text-foreground hover:decoration-foreground/60 focus-visible:ring-2 focus-visible:ring-accent/30"
            >
              build your own star-history comparison
            </a>.
          </p>
        </section>

        {hasRows && (
          <section class="mt-16 scroll-mt-24 border-t border-border/60 pt-12">
            <div class={SECTION_HEADER}>
              <h2 class={HEADING}>How this leaderboard works</h2>
            </div>
            <p class:list={["mt-2 max-w-[70ch]", BODY]}>
              gitdebt caches the public timestamp of every star on the repos it analyzes.
              "Trending" counts stars added in the trailing {windowDays} days; "most
              starred" ranks by current totals. A repo appears once its complete star
              history is cached, so the board covers
              {totalAnalyzed
                ? ` the ${totalAnalyzed.toLocaleString()} repos analyzed so far`
                : " the repos analyzed so far"} rather than all of GitHub — look up any
              repo to add it.
            </p>
          </section>
        )}
      </main>

      <SiteFooter />
    </div>
  </body>
</html>
