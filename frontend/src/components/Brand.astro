---
import logoSource from "../../../assets/gitdebt-logo.svg?raw";

/**
 * The repository artwork fills its silhouette with a rotated 32-unit dither
 * pattern. That pattern samples below one device pixel under ~96px, where the
 * glyph collapses into noise, so on-site lockups draw the same path with a
 * solid ink instead.
 */
const robot = logoSource.match(/fill="url\(#gitdebt-dither\)"\s+d="([^"]+)"/);
if (!robot) {
  throw new Error("assets/gitdebt-logo.svg no longer exposes the robot path");
}
const ROBOT_PATH = robot[1];

/** Ink bounds of that path inside its 512x512 artboard. */
const MARK_VIEWBOX = "41.436 108.392 429.115 299.305";

interface Props {
  markClass?: string;
  wordmarkClass?: string;
  showWordmark?: boolean;
}

const {
  markClass = "size-8",
  wordmarkClass = "font-mono text-[0.9375rem] font-medium tracking-[-0.01em]",
  showWordmark = true,
} = Astro.props;
---

<span class="inline-flex min-w-0 items-center gap-2">
  <svg
    class:list={[markClass, "block shrink-0 text-foreground"]}
    viewBox={MARK_VIEWBOX}
    fill="currentColor"
    aria-hidden="true"
    focusable="false"
  >
    <path d={ROBOT_PATH}></path>
  </svg>
  {showWordmark && <span class={wordmarkClass}>gitdebt</span>}
</span>
