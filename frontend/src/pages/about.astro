---
export const prerender = true;

import Sheet from "@/layouts/Sheet.astro";
import { ReportLayerGraphic } from "@/components/ReportLayerGraphic";
import { SeriesProvenance } from "@/components/SeriesProvenance";
import {
  BODY,
  BREADCRUMB,
  CAPTION,
  CRUMB,
  FIELD,
  HEADING,
  LEAD,
  MEASURE,
  PROSE_LINK,
  TITLE,
} from "@/components/style-tokens";
import { CATEGORIES } from "@/data/categories";
import { staticApiBase } from "@/lib/static-api-base";

const apiBase = staticApiBase();
const site = (Astro.site ?? new URL("https://gitdebt.com")).href.replace(
  /\/$/,
  "",
);

const title = "About & methodology · gitdebt";
const description =
  "How gitdebt builds GitHub star-history charts, which of the two sources produced a given series, and what its git-history health signals do and do not claim.";
const ogImage = `${apiBase}/api/og.png`;

/**
 * Every term links to the report section that demonstrates it. The slugs are
 * the first member of each curated category, which `build-catalog` always
 * seeds into the published catalog, so none of these links can point at a
 * page the build did not emit.
 */
const demoSlugs = CATEGORIES.map((category) => category.repos[0]).filter(
  (slug): slug is string => typeof slug === "string" && slug.length > 0,
);

type Signal = {
  term: string;
  desc: string;
  /** Section of a repository report that renders this signal. */
  anchor: "" | "#stats" | "#readme";
};

type SignalGroup = {
  label: string;
  graphic: "stars" | "health" | "readme";
  signals: Signal[];
};

const groups: SignalGroup[] = [
  {
    label: "Star history",
    graphic: "stars",
    signals: [
      {
        term: "Star history",
        desc: "One point per star, plotted as a cumulative count over time. Read it against calendar dates or aligned to days-since-first-star to compare growth shapes, overlay several repositories on shared axes, and embed the result in a README.",
        anchor: "",
      },
    ],
  },
  {
    label: "Read from the git history",
    graphic: "health",
    signals: [
      {
        term: "Commit trend",
        desc: "Monthly commit volume across the analyzed history, so a slowdown shows up as a shape rather than an impression.",
        anchor: "#stats",
      },
      {
        term: "Commit heatmap",
        desc: "The last 52 weeks of commit activity, bucketed by day, to show how steadily — or sporadically — the project moves.",
        anchor: "#stats",
      },
      {
        term: "File change frequency",
        desc: "A straight count of how many analyzed commits touched each file. It identifies frequently revisited files without claiming those changes were unstable or defective.",
        anchor: "#stats",
      },
      {
        term: "Fix-labelled changes",
        desc: "How often each file appears in commits whose message matches a fix heuristic. This describes fix-labelled history; it does not prove a bug or measure code quality.",
        anchor: "#stats",
      },
      {
        term: "Contributors",
        desc: "Everyone who has authored commits, aggregated from the git log so it reflects actual shipped code rather than profile metadata.",
        anchor: "#stats",
      },
      {
        term: "Ownership concentration",
        desc: "How few contributors it takes to write half the commits. It shows where knowledge has pooled in a codebase; it is not a judgement about any person.",
        anchor: "#stats",
      },
      {
        term: "Language lines",
        desc: "A per-language lines-of-code breakdown of the current HEAD, measured with tokei over a materialized checkout — so you can see where the codebase's mass sits.",
        anchor: "#stats",
      },
      {
        term: "Recent TODO / FIXME movement",
        desc: "The recent running movement of TODO, FIXME, and similar source markers inside the analyzed commit window. It is a directional maintenance signal, not a complete backlog.",
        anchor: "#stats",
      },
    ],
  },
  {
    label: "Published as an embed",
    graphic: "readme",
    signals: [
      {
        term: "README embeds",
        desc: "Every chart above also renders as a static image for a README — SVG, PNG and WebP, with light and dark variants where the theme matters. The URL takes the repository slug and nothing else.",
        anchor: "#readme",
      },
    ],
  },
];

let cursor = 0;
const signalGroups = groups.map((group) => ({
  ...group,
  signals: group.signals.map((signal) => {
    const slug = demoSlugs[cursor++ % demoSlugs.length];
    return { ...signal, slug, href: `/${slug}${signal.anchor}` };
  }),
}));
const allSignals = signalGroups.flatMap((group) => group.signals);

const canonical = `${site}/about`;
const termSetId = `${canonical}#signals`;

const jsonLd: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "AboutPage",
    "@id": `${canonical}#page`,
    name: "About gitdebt",
    url: canonical,
    description,
    mainEntity: { "@id": termSetId },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "gitdebt", item: `${site}/` },
      { "@type": "ListItem", position: 2, name: "About", item: canonical },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "DefinedTermSet",
    "@id": termSetId,
    name: "What gitdebt computes",
    url: canonical,
    hasDefinedTerm: allSignals.map((signal) => ({
      "@type": "DefinedTerm",
      name: signal.term,
      description: signal.desc,
      inDefinedTermSet: { "@id": termSetId },
      url: `${site}${signal.href}`,
    })),
  },
];

/**
 * The column count follows the group's own size.
 *
 * A fixed four-column track is what turns a one-signal group into one cell and
 * three empty ones — and because the internal rules here are 1px gaps showing
 * the ground through, an empty cell is not empty space, it is a solid block of
 * rule colour. The grid never has a hole in it because it is never wider than
 * what it holds.
 */
function groupColumns(count: number): string {
  if (count >= 4) return "sm:grid-cols-2 lg:grid-cols-4";
  if (count === 3) return "sm:grid-cols-3";
  if (count === 2) return "sm:grid-cols-2";
  return "";
}

const access = [
  {
    term: "Cold vs cached",
    desc: "The first request for a repository is cold: star history starts in the background while a shallow clone is analyzed for the health charts. The report shows a measured live ETA, then fills each finished section on its own — no reload needed. After that, results are cached and served from the edge, so repeat views are near-instant. Popular repos refresh more often, and our browser extension reports the repos people are actively viewing so their data stays current. Very large histories build in durable windows and appear only after the complete snapshot is stored.",
  },
  {
    term: "What gitdebt does not do",
    desc: "gitdebt does not flag stars as fake, real, or suspicious, and it doesn't score individual accounts. That can't be done correctly without privileged access to GitHub's full dataset, so we don't pretend to. A star series stores the timestamp of each star plus the opaque event id needed to avoid counting one twice — never an actor, a stargazer profile, or an event payload.",
  },
  {
    term: "Sign-in is optional",
    desc: "Every public repository report works without an account. GitHub sign-in adds a one-click shortcut to your profile-wide aggregate report and queues your own public repositories for analysis; it does not unlock private repository analysis or request write access.",
  },
];
---

<Sheet
  title={title}
  description={description}
  canonicalPath="/about"
  ogImage={ogImage}
  jsonLd={jsonLd}
>
  {/* ── The title block ──────────────────────────────────────────────────── */}
  <section class="registered border-b border-rule bg-paper">
    <div class="mx-auto w-full max-w-6xl px-6 pt-8 pb-14">
      <nav aria-label="Breadcrumb" class={BREADCRUMB}>
        <a href="/" class={CRUMB}>gitdebt</a>
        <span class="px-1.5 text-rule-strong" aria-hidden="true">/</span>
        <span class="text-ink">about</span>
      </nav>

      <h1 class:list={["mt-6", TITLE]}>How gitdebt works</h1>
      <p class:list={["mt-5", LEAD, MEASURE]}>
        gitdebt charts the star history of any public GitHub repository and
        pairs it with health signals read from the git history itself: commit
        cadence, change frequency, ownership concentration, and recent
        TODO/FIXME movement.
      </p>
    </div>
  </section>

  {/* ── What we compute ──────────────────────────────────────────────────── */}
  <section class="border-b border-rule bg-table">
    <div class="mx-auto w-full max-w-6xl px-6 py-16">
      <h2 class={HEADING}>What we compute</h2>
      <p class:list={["mt-4", BODY, MEASURE]}>
        The health signals come from a shallow git clone analyzed on our side,
        and each one is a pure, unit-tested function over that data. Star
        history is different: it is read either from GitHub's stargazer list or
        rebuilt from historical star data, and every report names the source
        that produced its chart.
      </p>

      {
        signalGroups.map((group, index) => (
          <div class:list={[index === 0 ? "mt-12" : "mt-16"]}>
            {/*
              The group's own drawing sits beside its name rather than above a
              wall of terms: the notation is what the group IS, so it reads as
              the subject of the heading, not as an illustration parked near it.
            */}
            <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-4 border-b border-rule pb-4">
              <h3 class="min-h-[2.55rem] font-draft text-[1.0625rem] leading-[1.2] text-ink">
                {group.label}
              </h3>
              <figure class="shrink-0">
                <ReportLayerGraphic client:visible kind={group.graphic} />
                <figcaption class:list={["mt-1.5 text-right", CAPTION]}>
                  Illustrative — no repository values
                </figcaption>
              </figure>
            </div>

            <dl
              class:list={[
                "mt-6 grid grid-cols-1 gap-px border border-rule-strong bg-rule",
                groupColumns(group.signals.length),
              ]}
            >
              {group.signals.map((signal) => (
                <div class="bg-paper p-5">
                  <dt class:list={[FIELD, "min-h-[1.5rem]"]}>{signal.term}</dt>
                  <dd class:list={["mt-2.5", CAPTION]}>{signal.desc}</dd>
                  <dd class="mt-2.5">
                    <a
                      href={signal.href}
                      class:list={["font-mono text-[0.75rem] text-ink-3", PROSE_LINK]}
                    >
                      See it on {signal.slug}
                    </a>
                  </dd>
                </div>
              ))}
            </dl>
          </div>
        ))
      }
    </div>
  </section>

  {/* ── Freshness, limits, and access ────────────────────────────────────── */}
  <section class="bg-paper">
    <div class="mx-auto w-full max-w-6xl px-6 py-16">
      <h2 class={HEADING}>Freshness, limits, and access</h2>
      <dl
        class="mt-8 grid grid-cols-1 gap-px border border-rule-strong bg-rule sm:grid-cols-3"
      >
        {
          access.map((item) => (
            <div class="bg-paper p-5">
              <dt class="min-h-[2.55rem] font-draft text-[1.0625rem] leading-[1.2] text-ink">
                {item.term}
              </dt>
              <dd class:list={["mt-2.5", CAPTION]}>{item.desc}</dd>
            </div>
          ))
        }
      </dl>

      <div class="mt-10">
        <SeriesProvenance client:visible variant="explainer" />
      </div>
    </div>
  </section>
</Sheet>
