---
export const prerender = true;

import Sheet from "@/layouts/Sheet.astro";
import { ButtonLink } from "@/components/ButtonLink";
import { ComparisonSheet } from "@/components/ComparisonSheet";
import { LandingRepoLookup } from "@/components/LandingRepoLookup";
import { MomentumBoard } from "@/components/MomentumBoard";
import { CommitColumns, Measure } from "@/components/RepoHealthScorecard";
import { StarSheet } from "@/components/StarSheet";
import { ThemeEmbedPreview } from "@/components/ThemeEmbedPreview";
import { WarmRepos } from "@/components/WarmRepos";
import {
  BODY,
  CAPTION,
  FIELD,
  HEADING,
  LEAD,
  MEASURE,
  ROW,
  SECTION_ACTION,
  SECTION_HEADER,
  TITLE,
} from "@/components/style-tokens";
import { CATEGORIES } from "@/data/categories";
import { loadBuildRepoSnapshot } from "@/lib/build-repo-snapshot";
import { heroMomentumRows, type LeaderboardResponse } from "@/lib/hero-momentum";
import {
  commitMonthPoints,
  healthReadings,
  type RepoHealth,
} from "@/lib/repo-health";
import {
  coverageLabel,
  historyFreshness,
  sourceLabel,
  stateLabel,
} from "@/lib/history-freshness";
import { repoEmbedAssets } from "@/lib/readme-embeds";
import { ORGANIZATION_SAME_AS, organizationId } from "@/lib/organization";
import { staticApiBase } from "@/lib/static-api-base";

const apiBase = staticApiBase();
const site = (Astro.site ?? new URL("https://gitdebt.com")).href.replace(/\/$/, "");

const title = "GitHub star history & repository health charts | gitdebt";
const description =
  "Star history for any public GitHub repo, plus what its commit history says about maintenance, ownership, repair load, and debt — as README-ready charts.";
const ogImage = `${apiBase}/api/og.png`;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "@id": `${site}/#app`,
    name: "gitdebt",
    url: `${site}/`,
    description,
    applicationCategory: "DeveloperApplication",
    operatingSystem: "Any",
    browserRequirements: "Requires JavaScript for live report updates",
    isAccessibleForFree: true,
    license: "https://opensource.org/license/mit",
    codeRepository: "https://github.com/zhom/gitdebt",
    image: `${site}/icon-512.png`,
    sameAs: [...ORGANIZATION_SAME_AS],
    publisher: { "@id": organizationId(site) },
    isPartOf: { "@id": `${site}/#website` },
    author: {
      "@type": "Organization",
      name: "Internet Technology Services LLC",
    },
    offers: { "@type": "Offer", price: 0, priceCurrency: "USD" },
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${site}/#website`,
    name: "gitdebt",
    url: `${site}/`,
    description,
    publisher: { "@id": organizationId(site) },
  },
];

async function fetchJson<T>(url: string): Promise<T | null> {
  for (let attempt = 0; attempt < 3; attempt += 1) {
    try {
      const res = await fetch(url, {
        headers: { accept: "application/json" },
        signal: AbortSignal.timeout(20_000),
      });
      if (res.ok) return (await res.json()) as T;
      if (res.status < 500 && res.status !== 429) return null;
    } catch {}
    if (attempt < 2) {
      await new Promise((resolve) => setTimeout(resolve, 500 * 2 ** attempt));
    }
  }
  return null;
}

const fetchBoard = (days: 1 | 7 | 30) =>
  fetchJson<LeaderboardResponse>(
    `${apiBase}/api/leaderboard.json?metric=velocity&window=${days}&per=100&page=0`,
  );

/**
 * The hero draws a real repository's real star history.
 *
 * This is the product doing its job in the first viewport rather than
 * describing it. `facebook/react` is the example the rest of the site already
 * uses — the report link, the embed catalogue — so the page stays consistent
 * with itself, and the drawing is labelled with the repository it is of.
 */
const HERO_REPO = "facebook/react";

const [analyzedRepos, monthBoard, weekBoard, dayBoard, heroSnapshot, heroHealth] =
  await Promise.all([
    (async () => {
      const result = await fetchJson<{ total?: number }>(
        `${apiBase}/api/sitemap/repos?page=0&per=1`,
      );
      return typeof result?.total === "number" ? result.total : null;
    })(),
    fetchBoard(30),
    fetchBoard(7),
    fetchBoard(1),
    loadBuildRepoSnapshot(HERO_REPO),
    fetchJson<RepoHealth>(`${apiBase}/api/repos/${HERO_REPO}/health.json`),
  ]);

const heroData = heroSnapshot.data;
const heroHistory = heroData?.history ?? [];
const heroFreshness = historyFreshness(heroData);
const heroProvenance =
  heroHistory.length > 1
    ? {
        source: sourceLabel(heroFreshness),
        coverage: coverageLabel(heroFreshness),
        state: stateLabel(heroFreshness),
      }
    : undefined;

const HERO_BOARD_ROWS = 8;
const heroRows = heroMomentumRows(
  {
    d30: monthBoard?.repos ?? null,
    d7: weekBoard?.repos ?? null,
    d1: dayBoard?.repos ?? null,
  },
  HERO_BOARD_ROWS,
);

const embedAssets = repoEmbedAssets(HERO_REPO);
const healthChartCount = embedAssets.filter((a) => a.group === "health").length;
const embedAssetCount = embedAssets.length;

const nf = new Intl.NumberFormat("en-US");
const boardUpdated = new Date().toLocaleDateString("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});

const featuredCategories = [
  "frontend-frameworks",
  "build-tools",
  "ai-coding-tools",
  "sql-databases",
].flatMap((slug) => {
  const category = CATEGORIES.find((c) => c.slug === slug);
  return category ? [category] : [];
});

/**
 * The comparison is shown, not described: the first featured category drawn
 * from the same build snapshots its own page uses, so this costs no extra
 * request. Each series is thinned to the resolution the sheet can plot, which
 * keeps the island's props small without inventing a single reading.
 */
const SPECIMEN_POINTS = 200;
const specimenCategory = featuredCategories[0];
const specimenSnapshots = specimenCategory
  ? await Promise.all(specimenCategory.repos.map((slug) => loadBuildRepoSnapshot(slug)))
  : [];
const specimenSeries = (specimenCategory?.repos ?? []).flatMap((slug, index) => {
  const history = specimenSnapshots[index]?.data?.history ?? [];
  if (history.length < 2) return [];
  const step = Math.max(1, (history.length - 1) / (SPECIMEN_POINTS - 1));
  const points =
    history.length <= SPECIMEN_POINTS
      ? history
      : Array.from({ length: SPECIMEN_POINTS }, (_, i) => history[Math.round(i * step)]);
  return [{ slug, points }];
});
const landingWarmRepos = Array.from(
  new Set(featuredCategories.flatMap((c) => c.repos)),
);

/**
 * The same four readings taken on the hero's repository, so the section shows
 * the measurement instead of only naming it. Absent when the build could not
 * read the health endpoint; the definitions then stand on their own.
 */
const heroReadings =
  heroHealth?.ready === true ? healthReadings(heroHealth) : [];
const heroMonths = heroHealth?.ready === true ? commitMonthPoints(heroHealth) : [];
const heroMonthCommits = heroMonths.reduce((total, point) => total + point.value, 0);
const heroBusiestMonth = Math.max(0, ...heroMonths.map((point) => point.value));

/** The four readings the commit history yields. Real, and named exactly. */
const readings = [
  {
    field: "Maintenance",
    value: "Commit cadence",
    note: "How regularly work actually lands, not when the last release was tagged.",
  },
  {
    field: "Ownership",
    value: "Author concentration",
    note: "Whether the work is spread across a team or resting on one person.",
  },
  {
    field: "Repair load",
    value: "Fix-labelled share",
    note: "How much of recent work is fixing rather than building.",
  },
  {
    field: "Debt markers",
    value: "TODO / FIXME movement",
    note: "Whether the markers left in the code are being cleared or accumulating.",
  },
];
---

<Sheet
  title={title}
  description={description}
  canonicalPath="/"
  ogImage={ogImage}
  jsonLd={jsonLd}
>
  {/* ── The sheet. The drawing owns the fold; the words are lettered on it. ── */}
  <section class="registered border-b border-rule bg-paper">
    <div class="mx-auto max-w-6xl px-6 pt-14 pb-10 sm:pt-20">
      <div class="grid gap-x-12 gap-y-10 lg:grid-cols-[minmax(0,1fr)_20rem] lg:items-end">
        {/*
          No terminal punctuation. The drawing's hand sets its full stop as an
          open ring — authentic to a face built from modules, and unmistakable
          for a CJK full stop at the end of a sentence. A two-line display
          headline does not need the periods: the line break separates the
          clauses, which is ordinary display typography and sidesteps the one
          glyph in this face that fights its own reading.
        */}
        <h1 class={TITLE}>
          Stars say a repository is popular<br />
          Its commits say whether it is alive
        </h1>

        {/*
          The lookup is the drawing's input field, not a hero CTA. It is
          labelled the way a field on a drawing is labelled, and it sits under
          the title rather than in a panel floated to the right — that
          arrangement is the one every tool ships and it is not this one.
        */}
        <div id="lookup" class="scroll-mt-24 lg:pb-1">
          <p class={FIELD}>Repository</p>
          <div class="mt-2.5">
            <LandingRepoLookup client:load />
          </div>
        </div>
      </div>

      <p class:list={["mt-6", LEAD, MEASURE]}>
        One drawing per repository: the star curve, where it was read from, and
        what the commit history says about maintenance and repair load.
      </p>
    </div>

    {/*
      The trace, full width. It inks in along its own measured length, and the
      pointer re-dimensions it: move along the curve and the leader follows,
      measuring a real sampled datum rather than an interpolated one.
    */}
    {heroHistory.length > 1 && (
      <div class="mx-auto max-w-6xl px-6 pb-12">
        <div class={SECTION_HEADER}>
          <p class={FIELD}>Drawing of — {HERO_REPO}</p>
          <a href={`/${HERO_REPO}`} class={SECTION_ACTION}>
            open the full report
          </a>
        </div>
        <div class="mt-4">
          <StarSheet
            client:load
            repo={HERO_REPO}
            history={heroHistory}
            provenance={heroProvenance}
          />
        </div>
      </div>
    )}
  </section>

  {/* ── What the commits say ─────────────────────────────────────────────── */}
  <section id="how-it-works" class="scroll-mt-24 border-b border-rule bg-table">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <h2 class={HEADING}>
        Four readings taken from the repository's own commit history
      </h2>
      <p class:list={["mt-3", BODY, MEASURE]}>
        None of these come from stars. They are measured from commits, which is
        why they can disagree with the star curve — and why it matters when they
        do.
      </p>

      {/* Each cell states what the reading is, then takes it on the hero's
          repository. The grid rows are shared, so every verdict, every
          measure and every note lands on one line across the row whatever
          the copy above it says. */}
      <dl
        class="mt-10 grid grid-cols-1 border border-rule-strong bg-paper sm:grid-cols-2 lg:grid-cols-4 divide-y sm:divide-y-0 lg:divide-x divide-rule"
        data-draw
      >
        {
          readings.map((reading, index) => {
            const taken = heroReadings[index];
            return (
              <div class="row-span-7 grid grid-rows-subgrid gap-y-0 p-5">
                <dt class={FIELD}>{reading.field}</dt>
                <dd class="mt-2.5 font-draft text-[1.0625rem] text-ink">
                  {reading.value}
                </dd>
                <dd class:list={["mt-2", CAPTION]}>{reading.note}</dd>
                {taken ? (
                  <>
                    <dd class="mt-5 border-t border-rule pt-4">
                      <span class={FIELD}>{HERO_REPO}</span>
                    </dd>
                    <dd class="mt-2 font-draft text-[1.0625rem] leading-tight text-ink">
                      {taken.verdict}
                    </dd>
                    <dd class="mt-3">
                      <Measure
                        ratio={taken.ratio}
                        warn={taken.tone === "risk"}
                        delay={180 + index * 110}
                      />
                    </dd>
                    <dd class:list={["mt-2.5", CAPTION]}>{taken.detail}</dd>
                  </>
                ) : null}
              </div>
            );
          })
        }
      </dl>

      {heroMonthCommits > 0 && (
        <figure class="mt-6 border border-rule-strong bg-paper">
          <figcaption class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-b border-rule px-5 py-3">
            <span class={FIELD}>Commits per month — {HERO_REPO}</span>
            <span class={CAPTION}>
              {nf.format(heroMonthCommits)} commits in the last {heroMonths.length} months
              · busiest month {nf.format(heroBusiestMonth)}
            </span>
          </figcaption>
          <div class="px-5 py-4">
            <CommitColumns points={heroMonths} height={96} />
          </div>
        </figure>
      )}

      <div class="mt-8">
        <ButtonLink href={`/${HERO_REPO}`} variant="primary">
          See all four on a real repository
        </ButtonLink>
      </div>
    </div>
  </section>

  {/* ── Moving now ───────────────────────────────────────────────────────── */}
  {heroRows.length > 0 && (
    <section class="border-b border-rule bg-paper">
      <div class="mx-auto max-w-6xl px-6 py-16">
        <div class={SECTION_HEADER}>
          <h2 class={HEADING}>Moving now</h2>
          <a href="/leaderboard" class={SECTION_ACTION}>full leaderboard</a>
        </div>
        <p class:list={["mt-3", CAPTION]}>
          Ranked by stars gained in the last 30 days
          {analyzedRepos !== null && ` across ${nf.format(analyzedRepos)} analyzed repositories`}
          {` · updated ${boardUpdated}`}
        </p>
        <div class="mt-6">
          <MomentumBoard client:visible variant="compact" rows={heroRows} />
        </div>
      </div>
    </section>
  )}

  {/* ── Compare ──────────────────────────────────────────────────────────── */}
  <section id="compare" class="scroll-mt-24 border-b border-rule bg-table">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <div class={SECTION_HEADER}>
        <h2 class={HEADING}>Compare growth, not just totals</h2>
        <a href="/compare" class={SECTION_ACTION}>comparison builder</a>
      </div>
      <p class:list={["mt-3", BODY, MEASURE]}>
        Put up to eight star histories on one drawing. Switch between calendar
        time and equal-start growth, so a project launched last year can be read
        against one launched in 2015.
      </p>

      {specimenCategory && specimenSeries.length >= 2 && (
        <div class="mt-8 min-w-0">
          <ComparisonSheet
            client:visible
            apiBase={apiBase}
            path={`/api/chart.svg?repos=${encodeURIComponent(specimenCategory.repos.join(","))}`}
            caption={`${specimenCategory.name} — star history`}
            embedLink={`${site}/compare/${specimenCategory.slug}`}
            label={specimenCategory.name}
            series={specimenSeries}
            height={420}
          />
        </div>
      )}

      <ul role="list" class="mt-8 grid gap-px border border-rule-strong bg-rule sm:grid-cols-2 lg:grid-cols-4">
        {
          featuredCategories.map((category) => (
            <li class="bg-paper">
              <a
                href={`/compare/${category.slug}`}
                data-warm-repos={category.repos.join(",")}
                class:list={[ROW, "min-h-14 justify-between"]}
              >
                <span class="min-w-0 flex-1 truncate">{category.name}</span>
                <span class="font-mono text-[0.75rem] tabular-nums text-ink-3">
                  {category.repos.length}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ── README embeds ────────────────────────────────────────────────────── */}
  <section id="share" class="scroll-mt-24 bg-paper">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <div class={SECTION_HEADER}>
        <h2 class={HEADING}>README charts, ready to paste</h2>
        <a href="/badges" class={SECTION_ACTION}>badge studio</a>
      </div>
      <p class:list={["mt-3", BODY, MEASURE]}>
        {healthChartCount} health charts and {embedAssetCount} embeddable assets
        in total. One snippet carries a light and a dark drawing behind it, and
        every URL is cacheable and renders without JavaScript.
      </p>

      <div class="mt-8">
        <ThemeEmbedPreview client:idle />
      </div>
    </div>
  </section>

  <WarmRepos client:load apiBase={apiBase} repos={landingWarmRepos} />
</Sheet>
