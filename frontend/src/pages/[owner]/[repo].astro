---
import "@/styles/globals.css";
import {
  staticCatalogRequired,
  staticRepoPaths,
} from "@/lib/build-catalog";
import { staticApiBase } from "@/lib/static-api-base";
import {
  loadBuildRepoSnapshot,
  type BuildAnalyzeResponse as AnalyzeResponse,
} from "@/lib/build-repo-snapshot";
import BaseHead from "@/components/BaseHead.astro";
import { AgentReadmePrompt } from "@/components/AgentReadmePrompt";
import { ButtonLink } from "@/components/ButtonLink";
import { CodeBlock } from "@/components/CodeBlock";
import Seo from "@/components/Seo.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { PageAmbientSignal } from "@/components/PageAmbientSignal";
import { RepoHero } from "@/components/RepoHero";
import { ChartViewer } from "@/components/ChartViewer";
import { EarnedBadges } from "@/components/EarnedBadges";
import { InteractiveRepoSignals } from "@/components/InteractiveRepoSignals";
import { SeriesProvenance } from "@/components/SeriesProvenance";
import { UsageSection, type UsageResponse } from "@/components/UsageSection";
import { WarmRepos } from "@/components/WarmRepos";
import {
  BODY,
  CAPTION,
  EYEBROW,
  HEADING,
  MEASURE,
  PANEL_PADDED,
  SECTION_ACTION,
  SECTION_HEADER,
} from "@/components/style-tokens";
import { categoriesForRepo, relatedRepos } from "@/data/categories";
import { starFacts } from "@/lib/agent-prompt";
import { historyFreshness, sourceLabel } from "@/lib/history-freshness";
import { provenanceReadmeBlock } from "@/lib/provenance-embed";
import { BUILD_DEFECT_META, repoIndexability } from "@/lib/repo-indexability";
import { profileLogin } from "@/lib/static-routing.mjs";
import {
  firstStarYear as historyFirstYear,
  formatFullDate,
  formatMonthYear,
  gainedInTrailingDays,
  growthTrend,
  starMilestones,
  formatCompact,
} from "@/lib/star-insights";

export async function getStaticPaths() {
  return staticRepoPaths();
}

const { owner: rawOwner, repo: rawRepo } = Astro.params;
// A production build must publish a page it could actually read, full stop.
// This used to also require a non-null `updatedAt` prop, which is the freshness
// of the *catalog row* and says nothing about whether the backend answered.
// In practice that gate was near-redundant in production — the API always
// sends `updated_at`, and `compare/[category].astro` already awaits every
// curated repository uncaught — so what it really did was make local and
// preview builds silently de-index instead of failing loudly. Gating on the
// build kind alone is both simpler and honest about what is being asserted.
const requiredSnapshot = staticCatalogRequired();

const validSlug = /^[A-Za-z0-9._-]+$/;
if (!rawOwner || !rawRepo || !validSlug.test(rawOwner) || !validSlug.test(rawRepo)) {
  return new Response("Not found", { status: 404 });
}

const owner = rawOwner.toLowerCase();
const repo = rawRepo.toLowerCase();

const apiBase = staticApiBase();

let data: AnalyzeResponse | null = null;
let fetchError: string | null = null;
let repoNotFound = false;
let usage: UsageResponse | null = null;

async function fetchAnalysis() {
  const snapshot = await loadBuildRepoSnapshot(`${owner}/${repo}`);
  return {
    status: snapshot.notFound ? 404 : snapshot.data ? 200 : 503,
    result: snapshot.data,
  };
}

async function fetchUsage() {
  const response = await fetch(`${apiBase}/api/repos/${owner}/${repo}/usage`, {
    headers: { accept: "application/json" },
    signal: AbortSignal.timeout(5_000),
  });

  return response.ok ? ((await response.json()) as UsageResponse) : null;
}

try {
  const [analyzeRes, usageRes] = await Promise.allSettled([
    fetchAnalysis(),
    fetchUsage(),
  ]);

  if (analyzeRes.status === "fulfilled") {
    const { status, result } = analyzeRes.value;
    if (result) {
      if (result.not_found) {
        repoNotFound = true;
      } else {
        data = result;
      }
    } else if (status === 404) {
      repoNotFound = true;
    } else {
      fetchError = `backend returned ${status}`;
    }
  } else {
    fetchError =
      analyzeRes.reason instanceof Error
        ? analyzeRes.reason.message
        : String(analyzeRes.reason);
  }

  if (usageRes.status === "fulfilled") {
    usage = usageRes.value;
  }
} catch (err) {
  fetchError = err instanceof Error ? err.message : String(err);
}

// Only an unreadable snapshot fails the build. A cold repository still answers
// 200 with an empty `history`, so `data` is set and this throws nothing — the
// page is published, de-indexed for the honest reason, and indexes itself on a
// later build once history lands.
if (
  requiredSnapshot &&
  !repoNotFound &&
  (!data || fetchError)
) {
  throw new Error(
    `Static snapshot refresh failed for ` +
      `${apiBase}/api/repos/${owner}/${repo}/analyze: ${
        fetchError ?? "the backend returned no analysis payload"
      }`,
  );
}

const repoSlug = `${owner}/${repo}`;
const canonicalPath = `/${repoSlug}`;
const site = (Astro.site ?? new URL("https://gitdebt.com")).href.replace(/\/$/, "");
const canonical = `${site}/${repoSlug}`;

const history = data?.history ?? [];
const hasHistory = history.length > 0;
const archiveHistory =
  data?.history_kind === "public_star_actions" ||
  data?.history_approximate === true;
const firstYear = historyFirstYear(history);
const firstStarYear = firstYear !== null ? String(firstYear) : null;
const gained90 = hasHistory ? gainedInTrailingDays(history, 90) : null;
const gained30 = hasHistory ? gainedInTrailingDays(history, 30) : null;
const trend = hasHistory ? growthTrend(history) : null;
const milestones = hasHistory ? starMilestones(history) : [];
const createdFull = formatFullDate(data?.created_at ?? null);
const firstStarMonth = hasHistory ? formatMonthYear(history[0].date) : null;

// Source, coverage date, state — the only three things gitdebt can observe
// about how this series was read. Never a count and never a share.
const freshness = historyFreshness(data);

const title = `${repoSlug} — star history & stats · gitdebt`;

/**
 * The composed description has to land under Seo's 160-character truncation,
 * and the slug is unbounded, so the distinguishing clause goes first and the
 * enumeration is the part that gives way. 112 of 118 repo pages used to cut
 * mid-word here.
 */
function fitDescription(head: string, tails: string[], limit = 160): string {
  for (const tail of tails) {
    const composed = `${head} ${tail}`;
    if (composed.length <= limit) return composed;
  }
  return head;
}

const sourceWord = archiveHistory ? "Public star-activity" : "Star-history";
const description = data
  ? fitDescription(`${repoSlug}: ${data.total_stars.toLocaleString()} GitHub stars.`, [
      `${sourceWord} chart plus repo health — fix-labelled changes, file churn, contributor concentration, and commit cadence.`,
      `${sourceWord} chart plus repo health: fix-labelled changes, file churn, and contributors.`,
      `${sourceWord} chart plus repo-health charts.`,
    ])
  : `Star history and repo-debt insights for ${repoSlug}.`;

const ogImage = `${apiBase}/api/repos/${owner}/${repo}/og.png`;

// Cold and failed pages stay out of search results until history is available —
// the same robots meta for both, but no longer the same *reason*. "No history
// yet" is a fact about the repository; "the build could not read a snapshot" is
// a defect in this build, and only the second one gets a marker.
const indexability = repoIndexability({
  hasSnapshot: data !== null,
  fetchError,
  notFound: repoNotFound,
  hasHistory,
});
const noindex = indexability.noindex;

const faqs: { q: string; a: string }[] = [];
if (data && hasHistory) {
  faqs.push({
    q: `How many stars does ${repoSlug} have?`,
    // No event count beside the star total: an archive series records star
    // actions and not unstars, so it can exceed the repository's own total and
    // the subtraction a reader would make is not a real figure.
    a: `GitHub currently reports ${data.total_stars.toLocaleString()} stars for ${repoSlug}${
      !archiveHistory && gained90 !== null && gained90 > 0
        ? `, with about ${gained90.toLocaleString()} of them added in the last 90 days`
        : ""
    }.${archiveHistory ? ` The chart itself is rebuilt from historical star data, which records star actions and not unstars, so it reads as an attention signal rather than a net star count.` : ""}`,
  });
  if (gained90 !== null) {
    const pace =
      trend === "accelerating"
        ? ` That's faster than its lifetime average ${archiveHistory ? "activity" : "growth"} pace.`
        : trend === "slowing"
          ? ` That's below its lifetime average ${archiveHistory ? "activity" : "growth"} pace, which is common for mature projects.`
          : trend === "steady"
            ? ` That's in line with its lifetime average ${archiveHistory ? "activity" : "growth"} pace.`
            : "";
    faqs.push({
      q: archiveHistory
        ? `What does recent star activity look like for ${repo}?`
        : `How fast is ${repo} growing?`,
      a: archiveHistory
        ? `gitdebt observed about ${gained90.toLocaleString()} public star actions for ${repoSlug} over the latest 90 days of archive coverage${
            gained30 !== null ? ` (about ${gained30.toLocaleString()} in the latest 30)` : ""
          }. This is an approximate attention signal, not a net-star count, because unstars are not present.${pace}`
        : `${repoSlug} gained about ${gained90.toLocaleString()} stars over the last 90 days of its history${
            gained30 !== null ? ` (about ${gained30.toLocaleString()} in the last 30)` : ""
          } — figures are approximate for older repos, whose star history is downsampled.${pace}`,
    });
  }
  if (gained30 !== null) {
    faqs.push({
      q: `Is ${repo} still active?`,
      a: archiveHistory
        ? gained30 > 0
          ? `Public archive data shows about ${gained30.toLocaleString()} star actions for ${repoSlug} in the latest 30 days of coverage. For repository activity, use the commit heatmap, commit trend, and contributor charts on this page.`
          : `Public archive data shows no star actions for ${repoSlug} in the latest 30 days of coverage. That does not describe maintenance activity; use the commit heatmap and commit trend charts on this page.`
        : gained30 > 0
          ? `${repoSlug} is still attracting attention — about ${gained30.toLocaleString()} new GitHub stars in the most recent 30 days of its history. For commit-level signals, see the commit activity heatmap, commit trend, and contributors charts on this page.`
          : `${repoSlug} added no new stars in the most recent 30 days of its cached history. Star momentum isn't the whole picture — check the commit activity heatmap and commit trend charts on this page for maintenance signals.`,
    });
  }
  if (createdFull || firstStarMonth) {
    faqs.push({
      q: `When was ${repo} created?`,
      a: archiveHistory
        ? `${createdFull ? `${repoSlug} was created on ${createdFull}. ` : ""}The first public star activity observed for ${repoSlug} is from ${
            firstStarMonth ?? firstStarYear
          }.`
        : `${repoSlug}${createdFull ? ` was created on ${createdFull} and` : ""} earned its first GitHub star in ${
            firstStarMonth ?? firstStarYear
          }.`,
    });
  }
}

// Owner segments accept dots and any length; the profile route does not. A
// catalog entry with a dotted owner would otherwise link a 404 breadcrumb and
// assert a structured-data URL for a page that is never emitted.
const ownerProfile = profileLogin(owner);

// Coverage is asserted in markup only where the page actually shows it. The
// node carries a source, a window and a download — never a count, a share, or
// a completeness score.
const temporalCoverage =
  hasHistory && data?.history_coverage_end
    ? `${history[0].date.slice(0, 10)}/${data.history_coverage_end.slice(0, 10)}`
    : null;
// `hasHistory` is part of the gate, not decoration. A `restricted` repository
// classifies out of "unknown" but has no series at all — the backend only
// reports that status while `history_complete` is false — so without this the
// page would publish a Dataset node whose `DataDownload` points at a
// `stars.json` that has nothing to serve, and credit it to "No readable
// source". Assert a dataset only where a dataset exists.
const showProvenanceDataset =
  Boolean(data) && hasHistory && freshness.state !== "unknown";

const breadcrumbItems: Record<string, unknown>[] = [
  { "@type": "ListItem", position: 1, name: "gitdebt", item: `${site}/` },
  ...(ownerProfile
    ? [
        {
          "@type": "ListItem",
          position: 2,
          name: ownerProfile,
          item: `${site}/${ownerProfile}`,
        },
      ]
    : []),
];
breadcrumbItems.push({
  "@type": "ListItem",
  position: breadcrumbItems.length + 1,
  name: repoSlug,
  item: canonical,
});

const jsonLd: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareSourceCode",
    name: repoSlug,
    codeRepository: `https://github.com/${repoSlug}`,
    url: canonical,
    description,
    ...(data?.created_at && { dateCreated: data.created_at.slice(0, 10) }),
    ...(data && {
      interactionStatistic: {
        "@type": "InteractionCounter",
        interactionType: { "@type": "LikeAction" },
        userInteractionCount: data.total_stars,
      },
    }),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: breadcrumbItems,
  },
];
if (showProvenanceDataset) {
  jsonLd.push({
    "@context": "https://schema.org",
    "@type": "Dataset",
    name: `${repoSlug} star history`,
    description: `Dated star series for ${repoSlug}, as read by gitdebt.`,
    url: canonical,
    isAccessibleForFree: true,
    creditText: sourceLabel(freshness),
    ...(temporalCoverage && { temporalCoverage }),
    distribution: {
      "@type": "DataDownload",
      contentUrl: `${apiBase}/api/repos/${owner}/${repo}/stars.json`,
      encodingFormat: "application/json",
    },
  });
}
if (faqs.length > 0) {
  jsonLd.push({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  });
}

const repoCategories = categoriesForRepo(repoSlug);
const categoryRelated = relatedRepos(repoSlug, 6);
const FALLBACK_SUGGESTIONS = [
  "facebook/react",
  "vuejs/vue",
  "sveltejs/svelte",
  "rust-lang/rust",
];
const vsLinks = (categoryRelated.length > 0 ? categoryRelated : FALLBACK_SUGGESTIONS)
  .filter((s) => s !== repoSlug)
  .slice(0, 3);

// Prerendered seed for the agent prompt. The island refreshes it from the
// report's own live broadcast, so the copied brief never issues a request.
const promptStars = data ? starFacts(history, data.total_stars, archiveHistory) : null;

// The owner's one move from "my chart is frozen" to "my README says why": the
// unmodified chart embed plus one line of provenance text. Null while the
// source is unestablished, because publishing an unestablished claim into a
// permanent place is worse than publishing nothing.
const readmeBlock = provenanceReadmeBlock({
  apiBase,
  siteOrigin: site,
  slug: repoSlug,
  snapshot: data,
});
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead />
    <Seo
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      ogImage={ogImage}
      imageAlt={`Star history social card for ${repoSlug}`}
      noindex={noindex}
      jsonLd={jsonLd}
    />
    {/* This page is de-indexed because the build could not read its snapshot,
        not because the repository has nothing to show. `audit-seo` counts the
        marker and reports it on its own line. A production build throws above
        before such a page can be emitted, so the marker being here at all is
        the proof that this build was not a production one. */}
    {indexability.buildDefect && (
      <meta name={BUILD_DEFECT_META.name} content={BUILD_DEFECT_META.unreachable} />
    )}
  </head>
  <body>
    <div class="isolate flex min-h-dvh flex-col">
      <PageAmbientSignal
        client:load
        mode="repository"
        seed={repoSlug}
        values={[
          data?.total_stars ?? 0,
          data?.history_event_count ?? 0,
          history.length,
        ]}
      />
      <SiteHeader />

      <main id="main-content" class="mx-auto w-full max-w-6xl flex-1 px-6 py-12">
        <nav aria-label="Breadcrumb" class="font-mono text-[11px] text-muted-foreground">
          <a
            href="/"
            class="rounded outline-none transition-colors duration-150 hover:text-foreground focus-visible:ring-2 focus-visible:ring-accent/30"
            >gitdebt</a
          >
          <span class="px-1.5 text-border" aria-hidden="true">/</span>
          {ownerProfile ? (
            <a
              href={`/${ownerProfile}`}
              class="rounded outline-none transition-colors duration-150 hover:text-foreground focus-visible:ring-2 focus-visible:ring-accent/30"
              >{owner}</a
            >
          ) : (
            <span>{owner}</span>
          )}
          <span class="px-1.5 text-border" aria-hidden="true">/</span>
          <span class="text-foreground">{repo}</span>
        </nav>

        <div class="mt-8">
          <RepoHero
            client:load
            owner={owner}
            repo={repo}
            apiBase={apiBase}
            initialData={data}
          />
        </div>

        <section class="mt-16 scroll-mt-24 border-t border-border/60 pt-12">
          <div class={SECTION_HEADER}>
            <h2 class={HEADING}>
              {archiveHistory ? "Public star activity" : "Star history"}
            </h2>
          </div>
          <div class="mt-6">
            <ChartViewer
              client:load
              apiBase={apiBase}
              path={`/api/repos/${owner}/${repo}/chart.svg`}
              alt={`${archiveHistory ? "Approximate public star activity" : "Star history"} for ${repoSlug}`}
              caption={archiveHistory ? "Approximate public star activity" : "Cumulative star history"}
              priority={true}
              liveRepo={repoSlug}
              embedLink={canonical}
              label={repoSlug}
              points={history}
            />
          </div>
          {/* The header used to caption this date "latest star", which reads as
              a repository that stopped gaining stars rather than a coverage
              window that closed. Source, date and state now sit on the chart
              itself, said once and in the vocabulary that can be defended. */}
          <div class="mt-4 flex flex-wrap items-center justify-between gap-x-8 gap-y-2">
            <SeriesProvenance
              client:visible
              variant="inline"
              snapshot={data}
              slug={repoSlug}
            />
            {milestones.length > 0 && (
              <p class={CAPTION}>
                {archiveHistory ? "Observed activity milestones" : "Star milestones"}:{" "}
                {milestones.map((m, i) => (
                  <>
                    {i > 0 && <span aria-hidden="true"> · </span>}
                    <span class="whitespace-nowrap tabular-nums">
                      {formatCompact(m.threshold)} around {formatMonthYear(m.date)}
                    </span>
                  </>
                ))}
              </p>
            )}
          </div>
        </section>

        <section id="readme" class="mt-16 scroll-mt-24 border-t border-border/60 pt-12">
          <div class={SECTION_HEADER}>
            <h2 class={HEADING}>Put this in your README</h2>
            <a href={`/${repoSlug}.md`} class={SECTION_ACTION}>
              markdown for agents
              <span
                aria-hidden="true"
                class="transition-transform duration-150 group-hover:translate-x-0.5 motion-reduce:transition-none"
                >→</span
              >
            </a>
          </div>
          <p class:list={["mt-2", BODY, MEASURE]}>
            Copy the block below to publish the chart with its source and
            coverage date stated beside it — the same three facts this page
            shows, as text a reader can check. Or hand the prompt underneath to
            a coding agent and it adds the badges and repo-health charts too.
          </p>
          {readmeBlock ? (
            <div class="mt-6">
              <CodeBlock
                client:visible
                code={readmeBlock.snippet}
                language={readmeBlock.language}
                label={`README.md · ${repoSlug} star history`}
                copyLabel="Copy block"
                copyAriaLabel={`Copy the README block for ${repoSlug}`}
              />
              <p class:list={["mt-2", CAPTION, MEASURE]}>
                Light and dark variants, alt text, and one provenance line.
                Provenance is text in your README, never baked into the image
                URL, so the chart stays cacheable.
              </p>
            </div>
          ) : (
            <div class:list={["mt-6", PANEL_PADDED]}>
              <p class={EYEBROW}>Star-history block</p>
              <p class:list={["mt-2", CAPTION, MEASURE]}>
                Available once gitdebt has read this repository.
              </p>
            </div>
          )}
          <div class="mt-8">
            <AgentReadmePrompt
              client:visible
              apiBase={apiBase}
              siteOrigin={site}
              target={{ kind: "repo", slug: repoSlug, stars: promptStars }}
            />
          </div>
        </section>

        <section class="mt-16 scroll-mt-24 border-t border-border/60 pt-12">
          <div class={SECTION_HEADER}>
            <h2 class={HEADING}>Earned badges</h2>
            <a href="/badges" class={SECTION_ACTION}>
              badge studio
              <span
                aria-hidden="true"
                class="transition-transform duration-150 group-hover:translate-x-0.5 motion-reduce:transition-none"
                >→</span
              >
            </a>
          </div>
          <p class:list={["mt-2", BODY, MEASURE]}>
            Embeddable maintenance, ownership, and star-momentum signals,
            computed from commit and star history.
          </p>
          <div class="mt-6">
            <EarnedBadges client:visible owner={owner} repo={repo} apiBase={apiBase} embedLink={canonical} />
          </div>
        </section>

        <section id="stats" class="mt-16 scroll-mt-24 border-t border-border/60 pt-12">
          <div class={SECTION_HEADER}>
            <h2 class={HEADING}>Where changes concentrate</h2>
            <a href="/about" class={SECTION_ACTION}>
              methodology
              <span
                aria-hidden="true"
                class="transition-transform duration-150 group-hover:translate-x-0.5 motion-reduce:transition-none"
                >→</span
              >
            </a>
          </div>
          <p class:list={["mt-2", BODY, MEASURE]}>
            Fix-labelled changes, file change frequency, ownership risk, and
            maintenance cadence for {repoSlug}, each computed from its analyzed
            commit window.
          </p>
          <div class="mt-6">
            <InteractiveRepoSignals
              client:load
              apiBase={apiBase}
              slug={repoSlug}
              embedLink={canonical}
            />
          </div>
        </section>

        <section class="mt-16 scroll-mt-24 border-t border-border/60 pt-12">
          <div class={SECTION_HEADER}>
            <h2 class={HEADING}>Stars versus package downloads</h2>
          </div>
          <div class="mt-6">
            <UsageSection
              client:visible
              owner={owner}
              repo={repo}
              apiBase={apiBase}
              initialData={usage}
              showEmbed={false}
            />
          </div>
        </section>

        {faqs.length > 0 && (
          <section class="mt-16 scroll-mt-24 border-t border-border/60 pt-12">
            <div class={SECTION_HEADER}>
              <h2 class={HEADING}>{repoSlug} at a glance</h2>
            </div>
            <div class="mt-8 grid gap-x-12 gap-y-8 sm:grid-cols-2">
              {faqs.map((f) => (
                <article>
                  <h3 class="text-[13px] text-foreground/90">{f.q}</h3>
                  <p class:list={["mt-1.5", BODY]}>{f.a}</p>
                </article>
              ))}
            </div>
          </section>
        )}

        <section class="mt-16 scroll-mt-24 border-t border-border/60 pt-12">
          <div class={SECTION_HEADER}>
            <h2 class={HEADING}>Compare {repoSlug} with similar projects</h2>
            <a
              href={`/compare?repos=${encodeURIComponent(repoSlug)}`}
              class={SECTION_ACTION}
            >
              comparison builder
              <span
                aria-hidden="true"
                class="transition-transform duration-150 group-hover:translate-x-0.5 motion-reduce:transition-none"
                >→</span
              >
            </a>
          </div>
          <div class="mt-6 flex flex-wrap items-center gap-2">
            {vsLinks.map((other) => (
              <a
                href={`/vs/${repoSlug}/${other}`}
                data-warm-repos={`${repoSlug},${other}`}
                class="dither-chip rounded-md outline-none focus-visible:ring-2 focus-visible:ring-accent/30"
              >
                vs {other}
              </a>
            ))}
            <ButtonLink
              client:visible
              href={`/compare?repos=${encodeURIComponent(repoSlug)}`}
              variant="outline"
              size="sm"
              pulse
            >
              Compare with any repo
            </ButtonLink>
          </div>
          {repoCategories.length > 0 && (
            <p class:list={["mt-6", BODY, MEASURE]}>
              {repoSlug} is featured in{" "}
              {repoCategories.map((c, i) => (
                <>
                  {i > 0 && ", "}
                  <a
                    href={`/compare/${c.slug}`}
                    class="rounded underline decoration-border underline-offset-4 outline-none transition-colors duration-150 hover:text-foreground hover:decoration-foreground/60 focus-visible:ring-2 focus-visible:ring-accent/30"
                  >
                    {c.name} compared
                  </a>
                </>
              ))}
              {" "}— see how the whole category stacks up.
            </p>
          )}
        </section>

        <WarmRepos
          client:load
          apiBase={apiBase}
          repos={[repoSlug, ...vsLinks]}
        />
      </main>

      <SiteFooter
        signalValues={[
          data?.total_stars ?? 0,
          data?.history_event_count ?? 0,
          history.length,
        ]}
      />
    </div>
  </body>
</html>
