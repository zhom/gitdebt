---
export const prerender = true;

import Sheet from "@/layouts/Sheet.astro";
import { CompareBuilder } from "@/components/CompareBuilder";
import {
  ComparisonSheet,
  comparisonColors,
} from "@/components/ComparisonSheet";
import { SeriesProvenance } from "@/components/SeriesProvenance";
import { WarmRepos } from "@/components/WarmRepos";
import {
  BODY,
  BREADCRUMB,
  CAPTION,
  CRUMB,
  DATUM,
  FIELD,
  HEADING,
  LEAD,
  MEASURE,
  ROW,
  SECTION_ACTION,
  SECTION_HEADER,
  TITLE,
} from "@/components/style-tokens";
import { CATEGORIES, CATEGORY_GROUPS } from "@/data/categories";
import {
  loadBuildRepoSnapshot,
  type BuildAnalyzeResponse,
} from "@/lib/build-repo-snapshot";
import { formatCompact } from "@/lib/star-insights";
import { staticApiBase } from "@/lib/static-api-base";

const POPULAR_PAIRS: [string, string][] = [
  ["facebook/react", "vuejs/vue"],
  ["denoland/deno", "oven-sh/bun"],
  ["tailwindlabs/tailwindcss", "twbs/bootstrap"],
  ["django/django", "fastapi/fastapi"],
  ["gatsbyjs/gatsby", "vercel/next.js"],
  ["actix/actix-web", "tokio-rs/axum"],
  ["ollama/ollama", "vllm-project/vllm"],
  ["microsoft/vscode", "neovim/neovim"],
].map((pair) => [...pair].sort() as [string, string]);

const apiBase = staticApiBase();
const site = (Astro.site ?? new URL("https://gitdebt.com")).href.replace(/\/$/, "");

// `Astro.url.searchParams` is always empty during prerender, so the old
// selection branch could never run: it only ever produced a canonical carrying
// a query. `CompareBuilder` reads `window.location.search` itself, which is the
// working client-side contract, so the page ships exactly one honest canonical.
const canonicalPath = "/compare";
const title = "Compare GitHub star history · gitdebt";
const description =
  "Compare up to eight GitHub repositories by star history, codebase scale, maintenance cadence, ownership concentration, and change pressure.";
const ogImage = `${apiBase}/api/og.png`;

type LeaderboardResponse = {
  repos: { repo: string; stars: number }[];
};

async function fetchJson<T>(url: string): Promise<T | null> {
  for (let attempt = 0; attempt < 3; attempt += 1) {
    try {
      const res = await fetch(url, {
        headers: { accept: "application/json" },
        signal: AbortSignal.timeout(20_000),
      });
      if (res.ok) return (await res.json()) as T;
      if (res.status < 500 && res.status !== 429) return null;
    } catch {}

    if (attempt < 2) {
      await new Promise((resolve) => setTimeout(resolve, 500 * 2 ** attempt));
    }
  }
  return null;
}

// One Postgres-backed board read. A pair whose sides are not both on it renders
// no figure at all: absent means "no data", and a build must never fail because
// a secondary number was unavailable.
const starsBoard = await fetchJson<LeaderboardResponse>(
  `${apiBase}/api/leaderboard.json?metric=stars&per=100&page=0`,
);
const starsBySlug = new Map<string, number>(
  (starsBoard?.repos ?? []).map((row) => [row.repo.toLowerCase(), row.stars]),
);

const popularPairs = POPULAR_PAIRS.map(([first, second]) => {
  const starsFirst = starsBySlug.get(first) ?? null;
  const starsSecond = starsBySlug.get(second) ?? null;
  return {
    repos: [first, second] as [string, string],
    label: `${first.split("/")[1]} vs ${second.split("/")[1]}`,
    detail: `${first} · ${second}`,
    figure:
      starsFirst !== null && starsSecond !== null
        ? `${formatCompact(starsFirst)} · ${formatCompact(starsSecond)}`
        : null,
    combined: (starsFirst ?? 0) + (starsSecond ?? 0),
  };
}).sort(
  (a, b) => b.combined - a.combined || (a.label < b.label ? -1 : 1),
);

// The demo is pinned to the first declared pair rather than the sorted one, so
// the same two series are baked on every build regardless of what the board
// returned. Both slugs are already curated members, so this shares the snapshot
// promise `compare/[category]` opens and costs no extra request.
const demoSlugs = POPULAR_PAIRS[0];
const demoSnapshots = await Promise.all(
  demoSlugs.map((slug) => loadBuildRepoSnapshot(slug)),
);
const demoEntries = demoSlugs
  .map((slug, index) => ({ slug, data: demoSnapshots[index].data }))
  .filter(
    (entry): entry is { slug: string; data: BuildAnalyzeResponse } =>
      entry.data !== null && entry.data.history.length >= 2,
  );
// Never chart from partial data: one usable series is not a comparison.
const showDemo = demoEntries.length === demoSlugs.length;
const demoColors = comparisonColors(demoSlugs);
const demoParam = demoSlugs.join(",");
const demoPath = `/api/chart.svg?repos=${encodeURIComponent(demoParam)}`;
const demoLink = `${site}/compare?repos=${encodeURIComponent(demoParam)}`;
const demoLabel = demoSlugs.map((slug) => slug.split("/")[1]).join(" vs ");

// The exact array the category columns render, so the markup cannot describe a
// list the page does not show.
const renderedCategories = CATEGORY_GROUPS.flatMap((group) => group.categories);

const jsonLd: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Compare GitHub star history",
    url: `${site}${canonicalPath}`,
    description,
    mainEntity: {
      "@type": "ItemList",
      name: "Curated categories of comparable repositories",
      numberOfItems: renderedCategories.length,
      itemListElement: renderedCategories.map((category, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: category.name,
        url: `${site}/compare/${category.slug}`,
      })),
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "gitdebt", item: `${site}/` },
      { "@type": "ListItem", position: 2, name: "Compare", item: `${site}/compare` },
    ],
  },
];

const suggestionRepos = Array.from(
  new Set([
    ...POPULAR_PAIRS.flat(),
    ...CATEGORIES.flatMap((category) => category.repos),
  ]),
);
---

<Sheet
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  ogImage={ogImage}
  jsonLd={jsonLd}
>
  {/* ── The sheet: the drawing is the worked example, not a picture of one ── */}
  <section class="registered border-b border-rule bg-paper">
    <div class="mx-auto w-full min-w-0 max-w-6xl px-6 pt-8 pb-14">
      <nav aria-label="Breadcrumb" class={BREADCRUMB}>
        <a href="/" class={CRUMB}>gitdebt</a>
        <span class="px-1.5 text-rule-strong" aria-hidden="true">/</span>
        <span class="text-ink">compare</span>
      </nav>

      <h1 class:list={["mt-6", TITLE]}>
        Eight star histories, one set of axes
      </h1>
      <p class:list={["mt-5", LEAD, MEASURE]}>
        Plot by calendar date or by days since each repository's first star,
        then read languages, codebase scale, maintenance cadence, ownership
        resilience and debt signals. Build any combination, or open a curated
        field.
      </p>

      {showDemo && (
        <div id="compare-demo" class="mt-10">
          <ComparisonSheet
            client:load
            apiBase={apiBase}
            path={demoPath}
            caption={`Example — ${demoLabel} star history`}
            embedLink={demoLink}
            label={demoLabel}
            series={demoEntries.map((entry) => ({
              slug: entry.slug,
              points: entry.data.history,
            }))}
          />
          {/* Two curves on shared axes need not share a source, so each one
              carries its own mark rather than one claim covering both. */}
          <p class:list={["mt-6", FIELD]}>How each series was read</p>
          <ul role="list" class="mt-3 grid gap-x-12 gap-y-3 sm:grid-cols-2">
            {demoEntries.map((entry) => (
              <li class="min-w-0">
                <SeriesProvenance
                  client:visible
                  variant="inline"
                  slug={entry.slug}
                  snapshot={entry.data}
                  fill={demoColors.get(entry.slug)}
                />
              </li>
            ))}
          </ul>
          <p class:list={["mt-4", CAPTION, MEASURE]}>
            A worked example from cached star history. Enter repositories below
            to replace it.
          </p>
        </div>
      )}
    </div>
  </section>

  {/* ── The builder ──────────────────────────────────────────────────────── */}
  <section class="border-b border-rule bg-table">
    <div class="mx-auto w-full min-w-0 max-w-6xl px-6 py-16">
      <CompareBuilder client:load apiBase={apiBase} />
    </div>
  </section>

  {/* ── Frequently compared pairs ────────────────────────────────────────── */}
  <section class="border-b border-rule bg-paper">
    <div class="mx-auto w-full min-w-0 max-w-6xl px-6 py-16">
      <div class={SECTION_HEADER}>
        <h2 class={HEADING}>Frequently compared pairs</h2>
        <a href="/leaderboard" class={SECTION_ACTION}>leaderboard</a>
      </div>
      <ul
        role="list"
        class="mt-8 grid gap-px border border-rule-strong bg-rule sm:grid-cols-2"
      >
        {
          popularPairs.map((pair) => (
            <li class="bg-paper">
              <a
                href={`/vs/${pair.repos[0]}/${pair.repos[1]}`}
                data-warm-repos={pair.repos.join(",")}
                class:list={[ROW, "min-h-16 justify-between py-2.5"]}
              >
                <span class="min-w-0 flex-1">
                  <span class="block truncate">{pair.label}</span>
                  <span class:list={["mt-0.5 block truncate", CAPTION]}>
                    {pair.detail}
                  </span>
                </span>
                {pair.figure && (
                  <span class:list={[DATUM, "shrink-0 text-ink-3"]}>
                    <span class="sr-only">stars: </span>
                    {pair.figure}
                  </span>
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ── Curated categories ───────────────────────────────────────────────── */}
  <section id="categories" class="scroll-mt-24 bg-table">
    <div class="mx-auto w-full min-w-0 max-w-6xl px-6 py-16">
      <div class={SECTION_HEADER}>
        <h2 class={HEADING}>Curated categories of comparable tools</h2>
        <p class={CAPTION}>{renderedCategories.length} categories</p>
      </div>
      <p class:list={["mt-4", BODY, MEASURE]}>
        Each page carries an editorial introduction, a shared star-history
        chart, recent growth, the current ranking, and direct access to the
        maintenance signals behind every repository.
      </p>

      <div class="mt-10 grid gap-x-12 gap-y-12 lg:grid-cols-3">
        {
          CATEGORY_GROUPS.map((group) => (
            <section>
              <h3 class="font-draft text-[1.0625rem] leading-[1.2] text-ink">
                {group.name}
              </h3>
              <p class:list={["mt-2", CAPTION]}>{group.description}</p>
              <ul
                role="list"
                class="mt-4 grid gap-px border border-rule-strong bg-rule"
              >
                {group.categories.map((category) => (
                  <li class="bg-paper">
                    <a
                      href={`/compare/${category.slug}`}
                      data-warm-repos={category.repos.join(",")}
                      class:list={[ROW, "min-h-16 justify-between py-2.5"]}
                    >
                      <span class="min-w-0 flex-1">
                        <span class="block truncate">{category.name}</span>
                        <span class:list={["mt-0.5 block truncate", CAPTION]}>
                          {category.short}
                        </span>
                      </span>
                      <span class:list={[DATUM, "shrink-0 text-ink-3"]}>
                        {category.repos.length}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </div>
  </section>

  <WarmRepos client:load apiBase={apiBase} repos={suggestionRepos} />
</Sheet>

{/* Deliberately NOT `is:inline`: Astro's CSP hashes the scripts it processes,
    and an `is:inline` script is left untouched and therefore has no hash, so
    `script-src` blocks it at runtime. Bundled is the only form that actually
    executes here. */}
<script>
  // The demo is the empty state of the builder. Once the visitor has a
  // selection of their own, the builder charts it and a second, unrelated chart
  // above it is noise.
  if (new URLSearchParams(window.location.search).get("repos")) {
    document.getElementById("compare-demo")?.remove();
  }
</script>
