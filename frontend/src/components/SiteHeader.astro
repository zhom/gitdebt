---
import Brand from "@/components/Brand.astro";
import { GitHubLoginButton } from "@/components/GitHubLoginButton";
import { NavStarCount } from "@/components/NavStarCount";
import { Index, Cut } from "@/components/ui/marks";
import {
  GITDEBT_REPO,
  GITDEBT_REPO_URL,
  navStarSeed,
} from "@/lib/nav-star-seed";
import { staticApiBase } from "@/lib/static-api-base";

/**
 * The header is the sheet's top frame.
 *
 * It is solid paper, not glass. A drawing sheet is opaque, and a translucent
 * blurred bar over a white page buys nothing but a chance to band. The single
 * rule along its bottom edge is the frame line: it separates the chrome from
 * the sheet, so it encloses something real.
 *
 * The current page is marked by ink alone — full graphite against ink-3 for
 * the rest. There is no dot, no pill and no underline bolted beneath it.
 */

const navLinks = [
  { label: "Analyze", href: "/#lookup" },
  { label: "Compare", href: "/compare" },
  { label: "Leaderboard", href: "/leaderboard" },
];

const gitdebtStars = await navStarSeed();
const apiBase = staticApiBase();
const returnTo = `${Astro.url.pathname}${Astro.url.search}`;
const loginHref = `${apiBase}/auth/github/start?return_to=${encodeURIComponent(returnTo)}`;
const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";

function isCurrent(href: string): boolean {
  const path = href.split("#")[0].replace(/\/+$/, "") || "/";
  return path !== "/" && currentPath === path;
}

const NAV_LINK =
  "inline-flex min-h-10 items-center px-3 font-draft text-[0.8125rem] tracking-[0.06em] uppercase outline-none transition-colors duration-[--duration-ui] hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-signal";
---

<a
  href="#main-content"
  class="fixed top-3 left-3 z-[999] inline-flex min-h-10 -translate-y-24 items-center bg-ink px-4 font-draft text-[0.8125rem] tracking-[0.06em] text-paper uppercase transition-transform focus:translate-y-0"
>
  Skip to content
</a>

<header class="site-header sticky top-0 z-50 border-b border-rule bg-paper">
  <div
    class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-3 px-6 lg:grid lg:grid-cols-[1fr_auto_1fr]"
  >
    <a
      href="/"
      aria-label="gitdebt homepage"
      class="inline-flex min-h-10 min-w-0 shrink-0 items-center outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-signal"
    >
      <Brand />
    </a>

    <nav class="hidden items-center lg:flex" aria-label="Primary">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            aria-current={isCurrent(link.href) ? "page" : undefined}
            class:list={[
              NAV_LINK,
              isCurrent(link.href) ? "text-ink" : "text-ink-3",
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex shrink-0 items-center gap-2 justify-self-end">
      <div class="hidden sm:block">
        <NavStarCount
          client:load
          stars={gitdebtStars}
          href={GITDEBT_REPO_URL}
          apiBase={apiBase}
          repo={GITDEBT_REPO}
        />
      </div>
      <div data-auth-slot>
        <div data-auth-control data-api-base={apiBase}>
          <GitHubLoginButton client:load href={loginHref} />
        </div>
      </div>

      <details class="relative lg:hidden" data-mobile-menu data-state="closed">
        <summary
          class="grid size-10 cursor-pointer list-none place-items-center text-ink outline-none transition-colors duration-[--duration-ui] hover:bg-table focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-signal [&::-webkit-details-marker]:hidden"
          aria-label="Open navigation"
          aria-controls="mobile-navigation"
          aria-expanded="false"
        >
          <Index size={18} className="mobile-nav-icon mobile-nav-icon-menu" />
          <Cut size={18} className="mobile-nav-icon mobile-nav-icon-close" />
        </summary>
        <div
          class="mobile-nav-panel lifted absolute right-0 mt-2 w-[min(18rem,calc(100vw-2rem))] origin-top-right border border-rule-strong bg-paper p-2"
          data-mobile-menu-panel
          aria-hidden="true"
          inert
        >
          <nav id="mobile-navigation" class="flex flex-col" aria-label="Primary">
            {
              navLinks.map((link) => (
                <a
                  href={link.href}
                  aria-current={isCurrent(link.href) ? "page" : undefined}
                  class:list={[
                    NAV_LINK,
                    "px-2.5",
                    isCurrent(link.href) ? "text-ink" : "text-ink-3",
                  ]}
                >
                  {link.label}
                </a>
              ))
            }
          </nav>
        </div>
      </details>
    </div>
  </div>

  {/* The reading index. On a long sheet the frame line under the header is
      also a dimension of the page: a tick for every section heading, and a
      line measured out to where the reader is. It is hidden until a script
      has measured the page, and it is only ever shown when the page is long
      enough for a reader to lose their place in it. */}
  <div class="reading-index" data-reading-index hidden aria-hidden="true">
    <span class="reading-index-line"></span>
    <span class="reading-index-head"></span>
  </div>
</header>

<style>
  /* The menu and close marks occupy one grid cell so they cross-fade in place
     rather than reflowing the summary box. Both are in the DOM from the start;
     only opacity and a 3% scale move. */
  .mobile-nav-icon {
    grid-area: 1 / 1;
    transition:
      opacity var(--duration-ui) var(--ease-land),
      transform var(--duration-ui) var(--ease-land);
  }

  .mobile-nav-icon-close {
    opacity: 0;
    transform: scale(0.97);
  }

  details[open][data-state="open"] .mobile-nav-icon-menu {
    opacity: 0;
    transform: scale(0.97);
  }

  details[open][data-state="open"] .mobile-nav-icon-close {
    opacity: 1;
    transform: scale(1);
  }

  .mobile-nav-panel {
    opacity: 0;
    pointer-events: none;
    transform: translateY(-6px);
    transition:
      opacity var(--duration-ui) var(--ease-land),
      transform var(--duration-ui) var(--ease-land);
  }

  details[open][data-state="open"] .mobile-nav-panel {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-nav-icon,
    .mobile-nav-panel {
      transform: none;
      transition-property: opacity;
    }
  }

  /* Two pixels, the drawing's emphasis weight, laid over the 1px frame line:
     the reader's position is the one thing this rule now measures. */
  .reading-index {
    position: absolute;
    inset-inline: 0;
    bottom: -1px;
    height: 2px;
    pointer-events: none;
  }

  .reading-index-line {
    position: absolute;
    inset: 0;
    background-color: var(--ink);
    transform: scaleX(var(--read, 0));
    transform-origin: left center;
  }

  /* The ticks are created by the script below, so they carry no scope
     attribute and are reached through `:global`. */
  .reading-index :global(.reading-index-tick) {
    position: absolute;
    bottom: 0;
    width: 1px;
    height: 5px;
    background-color: var(--rule-strong);
    transition:
      background-color var(--duration-ui) linear,
      height var(--duration-ui) var(--ease-land);
  }

  .reading-index :global(.reading-index-tick[data-passed]) {
    height: 7px;
    background-color: var(--ink);
  }

  /* The line's terminator: it stands where the reader is, so the dimension
     ends on the one point it measures. */
  .reading-index-head {
    position: absolute;
    bottom: 0;
    left: calc(var(--read, 0) * 100% - 1px);
    width: 2px;
    height: 9px;
    background-color: var(--ink);
  }

  @media print {
    .reading-index {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reading-index :global(.reading-index-tick) {
      transition: none;
    }
  }
</style>

<script>
  /**
   * The reading index: the page measured along the header's frame line.
   *
   * Every datum is real. A tick stands where a section heading sits in the
   * page, and the line runs out to the reader's own position. Nothing animates
   * on a timer: the line moves only as the reader scrolls, which is direct
   * manipulation, so it follows the page under reduced motion too.
   */
  function installReadingIndex(root: HTMLElement) {
    const line = root.querySelector<HTMLElement>(".reading-index-line");
    const header = root.closest("header");
    if (!line || !header) return;
    let ticks: { el: HTMLElement; at: number }[] = [];
    let max = 0;
    let frame = 0;

    const update = () => {
      frame = 0;
      const read = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
      root.style.setProperty("--read", read.toFixed(4));
      for (const tick of ticks) tick.el.toggleAttribute("data-passed", tick.at <= read + 0.001);
    };

    const measure = () => {
      max = document.documentElement.scrollHeight - window.innerHeight;
      const long = max > window.innerHeight * 2.5;
      root.hidden = !long;
      for (const tick of ticks) tick.el.remove();
      ticks = [];
      if (!long) return;
      const offset = header.getBoundingClientRect().height + 16;
      for (const heading of document.querySelectorAll<HTMLElement>("main h2")) {
        const box = heading.getBoundingClientRect();
        if (box.height === 0 || heading.closest(".sr-only")) continue;
        const at = Math.min(1, Math.max(0, (box.top + window.scrollY - offset) / max));
        const el = document.createElement("span");
        el.className = "reading-index-tick";
        el.style.left = `calc(${(at * 100).toFixed(3)}% - 0.5px)`;
        root.append(el);
        ticks.push({ el, at });
      }
      update();
    };

    let measuring = 0;
    const remeasure = () => {
      window.clearTimeout(measuring);
      measuring = window.setTimeout(measure, 150);
    };

    window.addEventListener(
      "scroll",
      () => {
        if (!frame) frame = requestAnimationFrame(update);
      },
      { passive: true },
    );
    window.addEventListener("resize", remeasure, { passive: true });
    // A report fills in as its sections land, so the page grows after load.
    if (typeof ResizeObserver === "function") {
      new ResizeObserver(remeasure).observe(document.body);
    }
    measure();
  }

  document
    .querySelectorAll<HTMLElement>("[data-reading-index]")
    .forEach(installReadingIndex);
</script>

<script>
  const CLOSE_MS = 140;

  function installMobileMenu(details: HTMLDetailsElement) {
    const summary = details.querySelector("summary");
    const panel = details.querySelector<HTMLElement>("[data-mobile-menu-panel]");
    if (!summary || !panel) return;
    const trigger = summary;
    const menuPanel = panel;

    let closeTimer: ReturnType<typeof setTimeout> | null = null;
    let openFrame: number | null = null;
    let settleFrame: number | null = null;

    function cancelOpenFrames() {
      if (openFrame !== null) cancelAnimationFrame(openFrame);
      if (settleFrame !== null) cancelAnimationFrame(settleFrame);
      openFrame = null;
      settleFrame = null;
    }

    function setPanelInteractive(interactive: boolean) {
      menuPanel.setAttribute("aria-hidden", String(!interactive));
      if (interactive) menuPanel.removeAttribute("inert");
      else menuPanel.setAttribute("inert", "");
    }

    function openMenu() {
      if (closeTimer) clearTimeout(closeTimer);
      closeTimer = null;
      cancelOpenFrames();
      details.open = true;
      details.dataset.state = "closed";
      trigger.setAttribute("aria-expanded", "true");
      trigger.setAttribute("aria-label", "Close navigation");
      setPanelInteractive(true);
      openFrame = requestAnimationFrame(() => {
        openFrame = null;
        settleFrame = requestAnimationFrame(() => {
          settleFrame = null;
          if (trigger.getAttribute("aria-expanded") === "true") {
            details.dataset.state = "open";
          }
        });
      });
    }

    function closeMenu(returnFocus = false) {
      if (!details.open) return;
      if (closeTimer) clearTimeout(closeTimer);
      cancelOpenFrames();
      details.dataset.state = "closed";
      trigger.setAttribute("aria-expanded", "false");
      trigger.setAttribute("aria-label", "Open navigation");
      setPanelInteractive(false);
      closeTimer = setTimeout(() => {
        details.open = false;
        closeTimer = null;
        if (returnFocus) trigger.focus();
      }, CLOSE_MS);
    }

    trigger.addEventListener("click", (event) => {
      event.preventDefault();
      if (trigger.getAttribute("aria-expanded") === "true") closeMenu();
      else openMenu();
    });

    document.addEventListener("pointerdown", (event) => {
      if (!details.contains(event.target as Node)) closeMenu();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && details.open) {
        event.preventDefault();
        closeMenu(true);
      }
    });

    menuPanel.addEventListener("click", (event) => {
      if ((event.target as Element).closest("a")) closeMenu();
    });
  }

  document
    .querySelectorAll<HTMLDetailsElement>("[data-mobile-menu]")
    .forEach(installMobileMenu);
</script>

<script>
  type SessionUser = {
    login?: string;
    name?: string | null;
    avatar_url?: string | null;
  };

  // These mirror the drafting control treatment. They live as strings because
  // this menu is built after a fetch resolves, outside Astro's render.
  const ACCOUNT_TRIGGER =
    "inline-flex min-h-10 cursor-pointer list-none items-center justify-center gap-2 whitespace-nowrap border border-rule-strong px-3 font-draft text-[0.8125rem] tracking-[0.04em] text-ink uppercase outline-none transition-colors duration-[140ms] hover:bg-table focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-signal [&::-webkit-details-marker]:hidden";
  const ACCOUNT_MENU =
    "lifted absolute right-0 z-50 mt-2 w-72 border border-rule-strong bg-paper p-2";
  const ACCOUNT_ITEM =
    "flex min-h-10 w-full items-center px-2.5 text-left text-[0.8125rem] text-ink-2 outline-none transition-colors duration-[140ms] hover:bg-table hover:text-ink focus-visible:outline-2 focus-visible:outline-signal";

  function element<K extends keyof HTMLElementTagNameMap>(
    tag: K,
    className?: string,
  ): HTMLElementTagNameMap[K] {
    const node = document.createElement(tag);
    if (className) node.className = className;
    return node;
  }

  function accountMenu(user: SessionUser, apiBase: string) {
    const login = user.login!.toLowerCase();
    const details = element("details", "group relative");
    const trigger = element("summary", ACCOUNT_TRIGGER);
    trigger.setAttribute("aria-label", `Open account menu for ${login}`);

    if (user.avatar_url) {
      const avatar = element("img", "size-6");
      avatar.src = user.avatar_url;
      avatar.alt = "";
      avatar.width = 24;
      avatar.height = 24;
      trigger.append(avatar);
    }

    const loginText = element("span", "hidden max-w-28 truncate sm:inline");
    loginText.textContent = login;
    trigger.append(loginText);

    const menu = element("div", ACCOUNT_MENU);
    const identity = element("div", "px-2.5 py-2");
    const name = element("p", "truncate text-[0.8125rem] text-ink");
    name.textContent = user.name || login;
    const handle = element("p", "truncate font-mono text-[0.75rem] text-ink-3");
    handle.textContent = `@${login}`;
    identity.append(name, handle);

    const divider = element("hr", "rule-drawn my-1.5");

    const profile = element("a", ACCOUNT_ITEM);
    profile.href = `/${encodeURIComponent(login)}`;
    profile.textContent = "Your profile report";

    const signOut = element("button", ACCOUNT_ITEM);
    signOut.type = "button";
    signOut.textContent = "Sign out";
    signOut.addEventListener("click", async () => {
      try {
        await fetch(`${apiBase}/auth/logout`, {
          method: "POST",
          credentials: "include",
          redirect: "manual",
        });
      } finally {
        location.reload();
      }
    });

    menu.append(identity, divider, profile, signOut);
    details.append(trigger, menu);
    return details;
  }

  for (const root of document.querySelectorAll<HTMLElement>("[data-auth-control]")) {
    const apiBase = root.dataset.apiBase ?? "";
    const controller = new AbortController();
    fetch(`${apiBase}/api/me`, {
      credentials: "include",
      headers: { accept: "application/json" },
      signal: controller.signal,
    })
      .then(async (response) =>
        response.ok ? ((await response.json()) as SessionUser) : null,
      )
      .then((user) => {
        if (user?.login) root.replaceChildren(accountMenu(user, apiBase));
      })
      .catch(() => undefined);
  }
</script>
