---
export const prerender = true;

import Sheet from "@/layouts/Sheet.astro";
import {
  BODY,
  BREADCRUMB,
  CAPTION,
  CRUMB,
  FIELD,
  HEADING,
  MEASURE,
  PROSE_LINK,
  TITLE,
} from "@/components/style-tokens";
import { staticApiBase } from "@/lib/static-api-base";

/**
 * A notes sheet, like /terms.
 *
 * Nothing here is measured, so nothing here is drawn in drafting red and no
 * trace runs across it. The page earns its place in the set by being structured
 * like the rest of it: a title block, clauses ruled into real cells, a revision
 * date that says when the sheet was last issued.
 */

const apiBase = staticApiBase();

const title = "Privacy policy · gitdebt";
const description =
  "How gitdebt handles optional GitHub sign-in, anonymous extension activity, public repository data, and operational logs.";
const ogImage = `${apiBase}/api/og.png`;

const updated = "2026-08-11";

const collected = [
  {
    term: "Repository views (browser extension)",
    desc: "When you open a GitHub repo with the gitdebt extension installed, it sends us {owner, repo, observed star count}. We use this to keep a repo's data fresh and to find popular repos worth charting. The star count is an untrusted hint compared against our cache — it is never stored. The extension is anonymous: no account, cookie, or identifier is attached.",
  },
  {
    term: "Public repository data",
    desc: "We fetch and cache public GitHub data — stargazer timestamps, commit history, contributors, language lines, and similar metadata — to render star-history and repo-debt charts. We only ever read public data.",
  },
  {
    term: "Optional GitHub sign-in",
    desc: "If you choose to sign in, GitHub gives us your public profile identity and an OAuth token. We store the token encrypted at rest and use an HTTP-only signed session cookie to keep you signed in. Sign-in provides a one-click link to your profile-wide report and queues your own public repositories for analysis; public repository reports do not require it. gitdebt has no repository connection flow today. In July 2026 GitHub restricted the stargazer-list endpoint to a repository's own admins and collaborators, and the permission GitHub requires to read it is Contents (read and write). If gitdebt adds repository connection, it will request that permission solely to read that repository's stargazer timestamps. You would choose which repositories the app can see, and you could revoke it at any time from GitHub's settings. We never write to your repositories, and we never request account-management access.",
  },
  {
    term: "Operational logs",
    desc: "Our hosting providers and server may process request metadata such as IP address, user agent, route, timestamp, and response status to operate, secure, and troubleshoot the service. We do not use this data for advertising.",
  },
];

const principles = [
  {
    term: "We don't sell your data",
    desc: "gitdebt does not sell, rent, or trade personal data to anyone, and we don't run third-party advertising or analytics trackers.",
  },
  {
    term: "Public data only",
    desc: "Every repo signal we compute comes from publicly available GitHub data, and every chart we publish is derived from a public repository. gitdebt has no repository connection flow today; if one is added, connecting a repository you administer would grant the Contents (read and write) permission GitHub now requires to read a stargazer list — we would use it only to read, never to write, and a private repository would never become a public page. We never request account-management permissions.",
  },
  {
    term: "Minimal retention",
    desc: "Cached public repo data is kept to serve charts quickly and refreshed over time. The extension's reported star counts are discarded after comparison and never persisted. Signing out clears your browser session; you can ask us to remove the stored OAuth record by opening a private security advisory.",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Privacy policy",
  url: `${(Astro.site ?? new URL("https://gitdebt.com")).href.replace(/\/$/, "")}/privacy`,
  description,
};
---

<Sheet
  title={title}
  description={description}
  canonicalPath="/privacy"
  ogImage={ogImage}
  jsonLd={jsonLd}
>
  {/* ── The title block ──────────────────────────────────────────────────── */}
  <section class="registered border-b border-rule bg-paper">
    <div class="mx-auto w-full max-w-6xl px-6 pt-8 pb-14">
      <nav aria-label="Breadcrumb" class={BREADCRUMB}>
        <a href="/" class={CRUMB}>gitdebt</a>
        <span class="px-1.5 text-rule-strong" aria-hidden="true">/</span>
        <span class="text-ink">privacy</span>
      </nav>

      <div
        class="mt-6 grid gap-x-12 gap-y-6 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end"
      >
        <h1 class={TITLE}>Privacy policy</h1>
        <div class="lg:text-right">
          <p class={FIELD}>Revision</p>
          <p class="mt-2 font-mono text-[0.8125rem] tabular-nums text-ink">
            <time datetime={updated}>{updated}</time>
          </p>
        </div>
      </div>

      <p class:list={["mt-6", BODY, MEASURE]}>
        gitdebt reads public GitHub data. An account is optional, the browser
        extension is anonymous, and nothing here is sold to anyone.
      </p>
    </div>
  </section>

  {/* ── What we collect ──────────────────────────────────────────────────── */}
  <section class="border-b border-rule bg-table">
    <div class="mx-auto w-full max-w-6xl px-6 py-16">
      <h2 class={HEADING}>What we collect</h2>
      {/* 1px gaps showing the ground through, not `divide-*`: a divided grid
          drops its rules the moment it wraps to one column. */}
      <dl
        class="mt-8 grid grid-cols-1 gap-px border border-rule-strong bg-rule sm:grid-cols-2"
      >
        {
          collected.map((item) => (
            <div class="bg-paper p-5">
              <dt class="min-h-[2.55rem] font-draft text-[1.0625rem] leading-[1.2] text-ink">
                {item.term}
              </dt>
              <dd class:list={["mt-2.5", CAPTION]}>{item.desc}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  {/* ── How we handle it ─────────────────────────────────────────────────── */}
  <section class="border-b border-rule bg-paper">
    <div class="mx-auto w-full max-w-6xl px-6 py-16">
      <h2 class={HEADING}>How we handle it</h2>
      <dl
        class="mt-8 grid grid-cols-1 gap-px border border-rule-strong bg-rule sm:grid-cols-3"
      >
        {
          principles.map((item) => (
            <div class="bg-paper p-5">
              <dt class="min-h-[2.55rem] font-draft text-[1.0625rem] leading-[1.2] text-ink">
                {item.term}
              </dt>
              <dd class:list={["mt-2.5", CAPTION]}>{item.desc}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  {/* ── Your choices, and where to ask ───────────────────────────────────── */}
  <section class="bg-table">
    <div class="mx-auto w-full max-w-6xl px-6 py-16">
      <div class="grid gap-x-12 gap-y-10 sm:grid-cols-2">
        <div>
          <h2 class={HEADING}>Your choices</h2>
          <p class:list={["mt-4", BODY, MEASURE]}>
            gitdebt does not require an account. You can sign out at any time
            from the header menu. To stop the browser extension from sending
            repository views, turn off its automatic panel or uninstall the
            extension.
          </p>
        </div>
        <div>
          <h2 class={HEADING}>Contact</h2>
          <p class:list={["mt-4", BODY, MEASURE]}>
            Questions about this policy? Open a <a
              href="https://github.com/zhom/gitdebt/issues"
              class={PROSE_LINK}>GitHub issue</a
            > without including private information. Report vulnerabilities through
            GitHub's private security advisory flow. gitdebt is an independent tool
            and is not affiliated with, endorsed by, or sponsored by GitHub.
          </p>
        </div>
      </div>
    </div>
  </section>
</Sheet>
