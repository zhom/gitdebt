---
export const prerender = true;

import "@/styles/globals.css";
import BaseHead from "@/components/BaseHead.astro";
import { AgentReadmePrompt } from "@/components/AgentReadmePrompt";
import Seo from "@/components/Seo.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { EmbedCatalog } from "@/components/BadgeStudio";
import { ReportLayerGraphic } from "@/components/ReportLayerGraphic";
import {
  BODY,
  CAPTION,
  EYEBROW,
  HEADING,
  LEAD,
  MEASURE,
  SECTION_ACTION,
  SECTION_HEADER,
  TITLE,
} from "@/components/style-tokens";
import {
  loadBuildRepoSnapshot,
  type BuildAnalyzeResponse,
} from "@/lib/build-repo-snapshot";
import { provenanceReadmeBlock } from "@/lib/provenance-embed";
import {
  assetUrl,
  profileEmbedAssets,
  repoEmbedAssets,
  EMBED_RULES,
  QUERY_REFERENCE,
  type EmbedFormat,
} from "@/lib/readme-embeds";
import { staticApiBase } from "@/lib/static-api-base";

const apiBase = staticApiBase();

const site = (Astro.site ?? new URL("https://gitdebt.com")).href.replace(/\/$/, "");

/** The target every asset points at until a visitor types their own. */
const exampleSlug = "facebook/react";
const exampleLogin = exampleSlug.split("/")[0];

// One catalog, shared with the agent prompt and the Rust renderer behind
// `/api/md`. The page counts what it renders instead of asserting a number.
const repoAssets = repoEmbedAssets(exampleSlug);
const profileAssets = profileEmbedAssets(exampleLogin);
const allAssets = [...repoAssets, ...profileAssets];
const healthCount = repoAssets.filter((asset) => asset.group === "health").length;
const formatCount = new Set(allAssets.flatMap((asset) => asset.formats)).size;

// The provenance-stated README block is composed from a real analyze payload,
// so it can only be built for the default target. A failed or cold snapshot
// classifies as "source not established", which renders a disabled action —
// never a wrong claim, and never a failed build.
let exampleSnapshot: BuildAnalyzeResponse | null = null;
try {
  exampleSnapshot = (await loadBuildRepoSnapshot(exampleSlug)).data;
} catch {
  exampleSnapshot = null;
}
const provenance = provenanceReadmeBlock({
  apiBase,
  siteOrigin: site,
  slug: exampleSlug,
  snapshot: exampleSnapshot,
});

/** The two rules people get wrong, quoted from the shared list, not retyped. */
const PUBLISHED_RULES = EMBED_RULES.filter((rule) =>
  /^(?:Do not add cache-busting|Alt text is not optional)/.test(rule),
);

/**
 * The shared copy is written for a page and for a Markdown file, so it carries
 * backticks. Rendering them as `<code>` keeps one source of truth.
 */
function segments(text: string): { code: boolean; text: string }[] {
  return text
    .split(/(`[^`]+`)/g)
    .filter((part) => part.length > 0)
    .map((part) =>
      part.startsWith("`") && part.endsWith("`") && part.length > 2
        ? { code: true, text: part.slice(1, -1) }
        : { code: false, text: part },
    );
}

const MIME: Record<EmbedFormat, string> = {
  svg: "image/svg+xml",
  png: "image/png",
  webp: "image/webp",
  gif: "image/gif",
};

const title = "GitHub README badges and embeds · gitdebt";
const description = `Point ${allAssets.length} README embeds at your repository: metrics and signal badges, the star-history chart, repository and maintainer cards, and ${healthCount} health charts.`;
const ogImage = `${apiBase}/api/og.png`;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "@id": `${site}/badges#page`,
    name: "GitHub README badges and embeds",
    url: `${site}/badges`,
    description,
    isPartOf: {
      "@type": "WebSite",
      "@id": `${site}/#website`,
      name: "gitdebt",
      url: site,
    },
    // Generated from the same arrays that render the grids, so the markup
    // cannot describe an asset the page does not show.
    mainEntity: {
      "@type": "ItemList",
      "@id": `${site}/badges#embeds`,
      name: "gitdebt README embeds",
      numberOfItems: allAssets.length,
      itemListElement: allAssets.map((asset, index) => ({
        "@type": "ListItem",
        position: index + 1,
        item: {
          "@type": "ImageObject",
          name: asset.name,
          description: asset.purpose,
          contentUrl: assetUrl(apiBase, asset),
          encodingFormat: MIME[asset.formats[0]],
          isAccessibleForFree: true,
        },
      })),
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "@id": `${site}/badges#builder`,
    name: "gitdebt README badge builder",
    applicationCategory: "DeveloperApplication",
    operatingSystem: "Web",
    url: `${site}/badges`,
    isAccessibleForFree: true,
    offers: {
      "@type": "Offer",
      price: 0,
      priceCurrency: "USD",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "gitdebt",
        item: site,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "README badges",
        item: `${site}/badges`,
      },
    ],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead />
    <Seo
      title={title}
      description={description}
      canonicalPath="/badges"
      ogImage={ogImage}
      imageAlt="gitdebt GitHub README badge builder"
      imageType="image/png"
      imageWidth={1200}
      imageHeight={630}
      jsonLd={jsonLd}
    />
  </head>
  <body>
    <div class="isolate flex min-h-dvh flex-col">
      <SiteHeader />

      <main id="main-content" class="mx-auto w-full max-w-6xl flex-1 px-6 py-12">
        <nav aria-label="Breadcrumb" class="font-mono text-[11px] text-muted-foreground">
          <a
            href="/"
            class="rounded outline-none transition-colors duration-150 hover:text-foreground focus-visible:ring-2 focus-visible:ring-accent/30"
            >gitdebt</a
          >
          <span class="px-1.5 text-border" aria-hidden="true">/</span>
          <span class="text-foreground">badges</span>
        </nav>

        <header class="mt-8">
          <h1 class={TITLE}>Everything you can embed in a README</h1>
          <p class:list={["mt-3", LEAD, BODY]}>
            Badges, the star-history chart, repository and maintainer cards, a
            social preview, and {healthCount} repository-health charts. Every asset
            is a plain image URL served from gitdebt's own database. Point them
            at your repository below and copy what you need.
          </p>
          <p class:list={["mt-3 font-mono", CAPTION]}>
            {allAssets.length} assets · {formatCount} formats · light and dark · no
            account or token
          </p>
        </header>

        <EmbedCatalog
          client:load
          apiBase={apiBase}
          siteOrigin={site}
          defaultSlug={exampleSlug}
          defaultProvenance={provenance?.snippet ?? null}
        />

        <noscript>
          <p class:list={["mt-6", BODY, MEASURE]}>
            Without JavaScript the catalog stays pointed at {exampleSlug} and the
            copy buttons are inert. Every snippet is still printed in full, and a
            published embed never needs JavaScript.
          </p>
        </noscript>

        <section
          id="reference"
          aria-labelledby="reference-title"
          class="mt-16 scroll-mt-24 border-t border-border/60 pt-12"
        >
          <div class="flex items-end justify-between gap-6">
            <div class="min-w-0">
              <h2 id="reference-title" class={HEADING}>URL reference</h2>
              <p class:list={[CAPTION, "mt-1"]}>
                {QUERY_REFERENCE.length} parameters
              </p>
            </div>
            <figure aria-hidden="true" class="hidden shrink-0 sm:block">
              <div class="flex h-24 items-center overflow-hidden opacity-80">
                <ReportLayerGraphic client:visible kind="readme" />
              </div>
              <figcaption class:list={[CAPTION, "mt-1 text-right"]}>
                Illustrative — no repository values
              </figcaption>
            </figure>
          </div>

          <p class:list={["mt-6", BODY, MEASURE]}>
            Swap the owner and name in any URL; nothing else changes.
          </p>

          <div class="mt-6 overflow-x-auto">
            <table class="w-full min-w-[42rem] border-collapse text-left">
              <caption class="sr-only">
                Query parameters that change what an asset renders
              </caption>
              <thead>
                <tr class="border-b border-border/60">
                  <th scope="col" class:list={[EYEBROW, "py-2 pr-6"]}>
                    Parameter
                  </th>
                  <th scope="col" class:list={[EYEBROW, "py-2 pr-6"]}>
                    Applies to
                  </th>
                  <th scope="col" class:list={[EYEBROW, "py-2"]}>Effect</th>
                </tr>
              </thead>
              <tbody>
                {
                  QUERY_REFERENCE.map((row) => (
                    <tr class="border-b border-border/40">
                      <td class="py-3 pr-6 align-top font-mono text-[12px] text-foreground">
                        {row.param}
                      </td>
                      <td class:list={[CAPTION, "py-3 pr-6 align-top"]}>
                        {row.applies}
                      </td>
                      <td class:list={[BODY, "py-3 align-top"]}>
                        {segments(row.effect).map((part) =>
                          part.code ? (
                            <code class="font-mono text-foreground">{part.text}</code>
                          ) : (
                            part.text
                          ),
                        )}
                      </td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>

          <ul role="list" class="mt-8 grid gap-x-12 gap-y-8 sm:grid-cols-2">
            {
              PUBLISHED_RULES.map((rule) => (
                <li class:list={[BODY, MEASURE]}>
                  {segments(rule).map((part) =>
                    part.code ? (
                      <code class="font-mono text-foreground">{part.text}</code>
                    ) : (
                      part.text
                    ),
                  )}
                </li>
              ))
            }
          </ul>
        </section>

        <section
          id="agent"
          aria-labelledby="agent-title"
          class="mt-16 scroll-mt-24 border-t border-border/60 pt-12"
        >
          <div class={SECTION_HEADER}>
            <h2 id="agent-title" class={HEADING}>Let an agent do it</h2>
            <a href="/badges.md" class={SECTION_ACTION}>
              markdown for agents
              <span
                aria-hidden="true"
                class="transition-transform duration-150 group-hover:translate-x-0.5 motion-reduce:transition-none"
                >→</span
              >
            </a>
          </div>
          <p class:list={["mt-6", BODY, MEASURE]}>
            This prompt resolves your repository from its git remote, then adds
            the badge, the star-history chart, and the health charts that fit —
            replacing an existing star-history widget in place rather than
            stacking a second one under it.
          </p>
          <div class="mt-6">
            <AgentReadmePrompt
              client:visible
              apiBase={apiBase}
              siteOrigin={site}
              target={{ kind: "generic" }}
            />
          </div>
        </section>
      </main>

      <SiteFooter />
    </div>
  </body>
</html>
