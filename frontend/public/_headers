# same-origin-allow-popups: Google's preferred-source dialog is a popup that
# reports back to the page that opened it.
/*
  Content-Security-Policy: frame-ancestors 'none'
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Cross-Origin-Resource-Policy: same-site
  Permissions-Policy: camera=(), geolocation=(), microphone=(), payment=(), usb=()
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

# The X player card's page, and the only page anyone else may frame: X and
# Twitter frame it inside a post. Every other route keeps frame-ancestors
# 'none' and X-Frame-Options DENY from the rule above.
/in-tweet
  ! Content-Security-Policy
  ! X-Frame-Options
  ! Cross-Origin-Resource-Policy
  Content-Security-Policy: frame-ancestors 'self' https://x.com https://*.x.com https://twitter.com https://*.twitter.com
  X-Robots-Tag: noindex, follow

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/badges
  Cache-Control: public, max-age=0, must-revalidate

/report
  Cache-Control: public, max-age=0, must-revalidate
  X-Robots-Tag: noindex, follow

/profile
  Cache-Control: public, max-age=0, must-revalidate
  X-Robots-Tag: noindex, follow

/llms*.txt
  Cache-Control: public, max-age=3600, s-maxage=86400
  Content-Type: text/plain; charset=utf-8
