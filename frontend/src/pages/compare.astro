---
import "@/styles/globals.css";

import BaseHead from "@/components/BaseHead.astro";
import Seo from "@/components/Seo.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { CompareBuilder } from "@/components/CompareBuilder";
import { WarmRepos } from "@/components/WarmRepos";
import {
  BODY,
  EYEBROW,
  HEADING,
  ROW,
  ROW_BADGE,
  SECTION_ACTION,
  SECTION_HEADER,
  TITLE,
} from "@/components/style-tokens";
import { CATEGORIES, CATEGORY_GROUPS } from "@/data/categories";
import { staticApiBase } from "@/lib/static-api-base";

const POPULAR_PAIRS = [
  ["facebook/react", "vuejs/vue"],
  ["denoland/deno", "oven-sh/bun"],
  ["tailwindlabs/tailwindcss", "twbs/bootstrap"],
  ["django/django", "fastapi/fastapi"],
  ["gatsbyjs/gatsby", "vercel/next.js"],
  ["actix/actix-web", "tokio-rs/axum"],
  ["ollama/ollama", "vllm-project/vllm"],
  ["microsoft/vscode", "neovim/neovim"],
].map((repos) => ({
  repos: [...repos].sort(),
  label: repos.map((repo) => repo.split("/")[1]).join(" vs "),
}));

const apiBase = staticApiBase();
const site = (Astro.site ?? new URL("https://gitdebt.com")).href.replace(/\/$/, "");

const SLUG_RE = /^[a-z0-9._-]+\/[a-z0-9._-]+$/;
const rawRepos = Astro.url.searchParams.get("repos");
let repos: string[] = [];
if (rawRepos) {
  const parts = rawRepos
    .split(",")
    .map((slug) => slug.trim().toLowerCase())
    .filter(Boolean);
  if (parts.every((slug) => SLUG_RE.test(slug))) {
    repos = Array.from(new Set(parts)).sort().slice(0, 8);
  }
}
const hasSelection = repos.length >= 2;
const reposParam = repos.join(",");

const title = hasSelection
  ? `${repos.join(" vs ")} — star history · gitdebt`
  : "Compare GitHub star history · gitdebt";
const description = hasSelection
  ? `Compare ${repos.join(", ")} by animated star history, languages, codebase size, maintenance cadence, ownership concentration, and change pressure.`
  : "Compare up to eight GitHub repositories by animated star history, codebase scale, maintenance cadence, ownership concentration, and change pressure.";

const ogImage = hasSelection
  ? `${apiBase}/api/og.png?repos=${encodeURIComponent(reposParam)}`
  : `${apiBase}/api/og.png`;
const canonicalPath = !hasSelection
  ? "/compare"
  : repos.length === 2
    ? `/vs/${repos[0]}/${repos[1]}`
    : `/compare?repos=${encodeURIComponent(reposParam)}`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: hasSelection
    ? `Compare star history: ${repos.join(" vs ")}`
    : "Compare GitHub star history",
  url: `${site}${canonicalPath}`,
  description,
};

const suggestionRepos = Array.from(
  new Set([
    ...repos,
    ...POPULAR_PAIRS.flatMap((pair) => pair.repos),
    ...CATEGORIES.flatMap((category) => category.repos),
  ]),
);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead />
    <Seo
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      ogImage={ogImage}
      imageAlt={hasSelection
        ? `Star history comparison card for ${repos.join(" versus ")}`
        : undefined}
      jsonLd={jsonLd}
    />
  </head>
  <body>
    <div class="isolate flex min-h-dvh flex-col">
      <SiteHeader />

      <main id="main-content" class="mx-auto min-w-0 w-full max-w-6xl flex-1 px-6 py-12">
        <nav aria-label="Breadcrumb" class="font-mono text-[11px] text-muted-foreground">
          <a
            href="/"
            class="rounded outline-none transition-colors duration-150 hover:text-foreground focus-visible:ring-2 focus-visible:ring-accent/30"
            >gitdebt</a
          >
          <span class="px-1.5 text-border" aria-hidden="true">/</span>
          <span class="text-foreground">compare</span>
        </nav>

        <header class="mt-8">
          <h1 class={TITLE}>Compare star history across repositories</h1>
          <p class:list={["mt-3 max-w-[68ch] text-[15px]", BODY]}>
            Compare up to eight repos by calendar date or days since their
            first star, then inspect languages, codebase scale, maintenance
            cadence, ownership resilience, and debt signals. Use the builder
            for any combination, or open a curated field.
          </p>
        </header>

        <div class="mt-12">
          <CompareBuilder client:load apiBase={apiBase} initialRepos={repos} />
        </div>

        <section class="mt-16 scroll-mt-24 border-t border-border/60 pt-12">
          <div class={SECTION_HEADER}>
            <h2 class={HEADING}>Frequently compared pairs</h2>
            <a href="/leaderboard" class={SECTION_ACTION}>
              leaderboard
              <span
                aria-hidden="true"
                class="transition-transform duration-150 group-hover:translate-x-0.5 motion-reduce:transition-none"
                >→</span
              >
            </a>
          </div>
          <ul role="list" class="mt-6 grid gap-x-10 sm:grid-cols-2">
            {POPULAR_PAIRS.map((pair) => (
              <li>
                <a
                  href={`/vs/${pair.repos[0]}/${pair.repos[1]}`}
                  data-warm-repos={pair.repos.join(",")}
                  class={ROW}
                >
                  <span class="min-w-0 flex-1 truncate">{pair.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>

        <section
          id="categories"
          class="mt-16 scroll-mt-24 border-t border-border/60 pt-12"
        >
          <div class={SECTION_HEADER}>
            <h2 class={HEADING}>Curated categories of comparable tools</h2>
            <a href="/leaderboard" class={SECTION_ACTION}>
              fastest growing
              <span
                aria-hidden="true"
                class="transition-transform duration-150 group-hover:translate-x-0.5 motion-reduce:transition-none"
                >→</span
              >
            </a>
          </div>
          <p class:list={["mt-2 max-w-[68ch]", BODY]}>
            Each page has an editorial introduction, a shared star-history
            chart, recent growth, current ranking, and direct access to the
            maintenance signals behind every repository.
          </p>

          <div class="mt-10 grid gap-x-12 gap-y-12 lg:grid-cols-3">
            {CATEGORY_GROUPS.map((group) => (
              <section>
                <h3 class={EYEBROW}>{group.name}</h3>
                <p class:list={["mt-2 max-w-[42ch]", BODY]}>
                  {group.description}
                </p>
                <ul role="list" class="mt-4">
                  {group.categories.map((category) => (
                    <li>
                      <a
                        href={`/compare/${category.slug}`}
                        data-warm-repos={category.repos.join(",")}
                        class={ROW}
                      >
                        <span class="min-w-0 flex-1 py-2">
                          <span class="block truncate">{category.name}</span>
                          <span class="mt-0.5 block truncate text-[11px] text-muted-foreground/80 group-hover:text-muted-foreground">
                            {category.short}
                          </span>
                        </span>
                        <span class={ROW_BADGE}>{category.repos.length}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
        </section>

        <WarmRepos client:load apiBase={apiBase} repos={suggestionRepos} />
      </main>

      <SiteFooter />
    </div>
  </body>
</html>
