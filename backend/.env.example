# Required
GITHUB_TOKEN=
DATABASE_URL=postgres://gitdebt:gitdebt@localhost:5432/gitdebt

# Server
PORT=8787
BIND_LOCAL=1
RUST_LOG=info,gitdebt=debug
DB_POOL_MAX=60

# Background work
WORKER_COUNT=1
REPO_ANALYSIS_WORKERS=1
MAX_PENDING_ANALYSES=500
REPO_ANALYSIS_FRESH_HOURS=24
MAX_STARGAZER_PAGES=400
MAX_PENDING_FETCHES=5000

# GH Archive historical star acquisition (disabled by default).
# GH_ARCHIVE_BIGQUERY_PROJECT is the Google Cloud Project ID, not its
# display name, project number, or the service-account Unique ID.
GH_ARCHIVE_ENABLED=0
GH_ARCHIVE_BIGQUERY_PROJECT=
GH_ARCHIVE_BIGQUERY_LOCATION=US
# Optional project-owned partitioned table created by
# scripts/bigquery-star-index.sql. It makes per-repo backfills scan only the
# requested date partitions instead of the full public month resources.
GH_ARCHIVE_SOURCE_TABLE=
# In Dokploy, paste the complete service-account key JSON as one secret value.
# Never commit the real value. A mounted key file via
# GOOGLE_APPLICATION_CREDENTIALS is also supported.
GH_ARCHIVE_GOOGLE_CREDENTIALS_JSON=
GH_ARCHIVE_MAX_BYTES_BILLED=500000000000
GH_ARCHIVE_MAX_EVENTS=1000000
GH_ARCHIVE_BATCH_SIZE=5000
GH_ARCHIVE_CONCURRENCY=1
GH_ARCHIVE_HOURLY_LAG_MINUTES=15
GH_ARCHIVE_HOURLY_MAX_HOURS=24

# Bare-clone storage. Unset defaults to ~/.cache/gitdebt/repos.
# In production, set this to an absolute path on a persistent volume.
# REPOS_DIR=/var/lib/gitdebt/repos
REPOS_QUOTA_BYTES=85899345920
REPOS_HIGH_WATERMARK_PCT=80

# Comma-separated proxy CIDRs allowed to supply client-IP headers.
# Empty uses loopback, RFC1918, and Cloudflare's published ranges.
TRUSTED_PROXIES=

# Set in production to require `Authorization: Bearer ...` on /metrics.
METRICS_TOKEN=

# GitHub App OAuth. Leave GITHUB_APP_CLIENT_ID unset to disable auth.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8787/auth/github/callback
PUBLIC_FRONTEND_ORIGIN=http://localhost:14321
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
COOKIE_SECURE=0
