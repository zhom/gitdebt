---
import logoSource from "../../../assets/gitdebt-logo.svg?raw";
import { MARK_VIEWBOX, robotPath } from "@/lib/robot-path";

/**
 * The lockup: the robot drawn solid, beside the wordmark in the drawing's own
 * hand. The mark is placed by its ink bounds rather than its artboard, because
 * the artwork leaves ~40% of the square empty and a small mark should spend
 * every pixel on the glyph.
 */
const ROBOT_PATH = robotPath(logoSource);

interface Props {
  markClass?: string;
  wordmarkClass?: string;
  showWordmark?: boolean;
}

const {
  markClass = "h-6",
  wordmarkClass = "font-draft text-[1.0625rem] tracking-[0.02em] lowercase",
  showWordmark = true,
} = Astro.props;
---

<span class="inline-flex min-w-0 items-center gap-2.5">
  <svg
    class:list={[markClass, "block w-auto shrink-0 text-ink"]}
    viewBox={MARK_VIEWBOX}
    fill="currentColor"
    aria-hidden="true"
    focusable="false"
  >
    <path d={ROBOT_PATH}></path>
  </svg>
  {showWordmark && <span class={wordmarkClass}>gitdebt</span>}
</span>
