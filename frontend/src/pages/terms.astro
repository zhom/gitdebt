---
export const prerender = true;

import Sheet from "@/layouts/Sheet.astro";
import {
  BODY,
  BREADCRUMB,
  CAPTION,
  CRUMB,
  FIELD,
  HEADING,
  MEASURE,
  PROSE_LINK,
  TITLE,
} from "@/components/style-tokens";
import { staticApiBase } from "@/lib/static-api-base";

/**
 * The shortest sheet in the set, and it stays that way.
 *
 * There is nothing measured on this page — no series, no magnitude, no state —
 * so it carries no trace, no figure and no drafting red. What it does carry is
 * the drawing's structure: a title block at the head, the clauses ruled into
 * real cells, and a revision date. A legal page is a notes sheet, and a notes
 * sheet is still a sheet.
 */

const apiBase = staticApiBase();

const title = "Terms of use · gitdebt";
const description =
  "Terms for using gitdebt, including acceptable use, service availability, account access, limitations, and GitHub affiliation.";
const ogImage = `${apiBase}/api/og.png`;

const updated = "2026-07-19";

const terms = [
  {
    term: "Acceptable use",
    desc: "gitdebt charts public GitHub repository data. Use it lawfully and don't attempt to disrupt the service, scrape it at abusive volume, or circumvent its rate limits. We may throttle or block traffic that threatens availability for others.",
  },
  {
    term: "Optional account access",
    desc: "Public repository reports do not require an account. If you sign in with GitHub, you are responsible for activity under that session and should sign out on shared devices. Sign-in does not grant gitdebt access to private repositories and does not make public-data reports authoritative.",
  },
  {
    term: "Provided as-is",
    desc: "gitdebt is provided \"as is\" and \"as available\", without warranties of any kind, express or implied, including fitness for a particular purpose. Charts and repo-debt signals are computed from public data and may be incomplete, delayed, or inaccurate — treat them as informational, not authoritative.",
  },
  {
    term: "Limitation of liability",
    desc: "To the fullest extent permitted by law, gitdebt and its maintainers are not liable for any indirect, incidental, or consequential damages arising from your use of the service or reliance on its data.",
  },
  {
    term: "Not affiliated with GitHub",
    desc: "gitdebt is an independent project. It is not affiliated with, endorsed by, or sponsored by GitHub, Inc. \"GitHub\" and related marks belong to their respective owner. We access public data through GitHub's API in line with their terms.",
  },
  {
    term: "Changes",
    desc: "We may update these terms as the service evolves. Continued use after a change constitutes acceptance of the revised terms; the \"last updated\" date above reflects the current version.",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Terms of use",
  url: `${(Astro.site ?? new URL("https://gitdebt.com")).href.replace(/\/$/, "")}/terms`,
  description,
};
---

<Sheet
  title={title}
  description={description}
  canonicalPath="/terms"
  ogImage={ogImage}
  jsonLd={jsonLd}
>
  {/* ── The title block ──────────────────────────────────────────────────── */}
  <section class="registered border-b border-rule bg-paper">
    <div class="mx-auto w-full max-w-6xl px-6 pt-8 pb-14">
      <nav aria-label="Breadcrumb" class={BREADCRUMB}>
        <a href="/" class={CRUMB}>gitdebt</a>
        <span class="px-1.5 text-rule-strong" aria-hidden="true">/</span>
        <span class="text-ink">terms</span>
      </nav>

      <div
        class="mt-6 grid gap-x-12 gap-y-6 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end"
      >
        <h1 class={TITLE}>Terms of use</h1>
        <div class="lg:text-right">
          <p class={FIELD}>Revision</p>
          <p class="mt-2 font-mono text-[0.8125rem] tabular-nums text-ink">
            <time datetime={updated}>{updated}</time>
          </p>
        </div>
      </div>

      <p class:list={["mt-6", BODY, MEASURE]}>
        By using gitdebt you agree to these terms. If you don't agree, please
        don't use the service.
      </p>
    </div>
  </section>

  {/* ── The clauses ──────────────────────────────────────────────────────── */}
  <section class="border-b border-rule bg-table">
    <div class="mx-auto w-full max-w-6xl px-6 py-16">
      {/* 1px gaps showing the ground through, not `divide-*`: a divided grid
          drops its rules the moment it wraps, and every clause here needs a
          line on each side of it at every width. */}
      <dl
        class="grid grid-cols-1 gap-px border border-rule-strong bg-rule sm:grid-cols-2 lg:grid-cols-3"
      >
        {
          terms.map((item) => (
            <div class="bg-paper p-5">
              <dt class="min-h-[2.55rem] font-draft text-[1.0625rem] leading-[1.2] text-ink">
                {item.term}
              </dt>
              <dd class:list={["mt-2.5", CAPTION]}>{item.desc}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  {/* ── Contact ──────────────────────────────────────────────────────────── */}
  <section class="bg-paper">
    <div class="mx-auto w-full max-w-6xl px-6 py-16">
      <h2 class={HEADING}>Contact</h2>
      <p class:list={["mt-4", BODY, MEASURE]}>
        Questions about these terms? Open a <a
          href="https://github.com/zhom/gitdebt/issues"
          class={PROSE_LINK}>GitHub issue</a
        > without including private information.
      </p>
    </div>
  </section>
</Sheet>
