---
export const prerender = true;

import "@/styles/globals.css";

import BaseHead from "@/components/BaseHead.astro";
import { ButtonLink } from "@/components/ButtonLink";
import Seo from "@/components/Seo.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { ComparisonModeGraphic } from "@/components/ComparisonModeGraphic";
import { DitherField } from "@/components/DitherField";
import { LandingRepoLookup } from "@/components/LandingRepoLookup";
import { RepoHealthScorecard } from "@/components/RepoHealthScorecard";
import { ReportLayerGraphic } from "@/components/ReportLayerGraphic";
import { SeriesProvenance } from "@/components/SeriesProvenance";
import { SignalFlowGraphic } from "@/components/SignalFlowGraphic";
import { StatStrip } from "@/components/StatStrip";
import { ThemeEmbedPreview } from "@/components/ThemeEmbedPreview";
import { WarmRepos } from "@/components/WarmRepos";
import {
  BODY,
  CAPTION,
  EYEBROW,
  HEADING,
  LEAD,
  MEASURE,
  ROW,
  ROW_BADGE,
  SECTION_ACTION,
  SECTION_HEADER,
  TILE,
  TILE_DESC,
  TILE_TITLE,
} from "@/components/style-tokens";
import { CATEGORIES } from "@/data/categories";
import { repoEmbedAssets } from "@/lib/readme-embeds";
import { staticApiBase } from "@/lib/static-api-base";

const apiBase = staticApiBase();
const site = (Astro.site ?? new URL("https://gitdebt.com")).href.replace(/\/$/, "");

const title = "GitHub star history & repository health charts | gitdebt";
// Distinguishing clause first, and short enough that `Seo.astro`'s 160-character
// truncation never fires: the previous string was cut mid-enumeration.
const description =
  "Star history for any public GitHub repo, plus what its commit history says about maintenance, ownership, repair load, and debt — as README-ready charts.";
const ogImage = `${apiBase}/api/og.png`;

// Stable node identities. `badges.astro` already points its `isPartOf` at
// `{site}/#website`; without an `@id` here that reference dangles.
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "@id": `${site}/#app`,
    name: "gitdebt",
    url: `${site}/`,
    description,
    applicationCategory: "DeveloperApplication",
    operatingSystem: "Any",
    browserRequirements: "Requires JavaScript for live report updates",
    isAccessibleForFree: true,
    license: "https://opensource.org/license/mit",
    codeRepository: "https://github.com/zhom/gitdebt",
    isPartOf: { "@id": `${site}/#website` },
    author: {
      "@type": "Organization",
      name: "Internet Technology Services LLC",
    },
    offers: {
      "@type": "Offer",
      price: 0,
      priceCurrency: "USD",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${site}/#website`,
    name: "gitdebt",
    url: `${site}/`,
    description,
  },
];

/**
 * Build-time JSON with the same retry shape `leaderboard.astro` uses. Every
 * failure path returns `null`: the landing page states a count or it states
 * nothing, and it never fails the build over a catalogue figure.
 */
async function fetchJson<T>(url: string): Promise<T | null> {
  for (let attempt = 0; attempt < 3; attempt += 1) {
    try {
      const res = await fetch(url, {
        headers: { accept: "application/json" },
        signal: AbortSignal.timeout(20_000),
      });
      if (res.ok) return (await res.json()) as T;
      if (res.status < 500 && res.status !== 429) return null;
    } catch {}

    if (attempt < 2) {
      await new Promise((resolve) => setTimeout(resolve, 500 * 2 ** attempt));
    }
  }
  return null;
}

const analyzedRepos = await (async () => {
  const result = await fetchJson<{ total?: number }>(
    `${apiBase}/api/sitemap/repos?page=0&per=1`,
  );
  return typeof result?.total === "number" ? result.total : null;
})();

// Both counts are derived from the embed library that renders /badges and is
// byte-parity-locked to the Rust renderers, so neither can drift from what the
// product actually ships.
const embedAssets = repoEmbedAssets("facebook/react");
const healthChartCount = embedAssets.filter(
  (asset) => asset.group === "health",
).length;
const embedAssetCount = embedAssets.length;

const nf = new Intl.NumberFormat("en-US");

const heroStats = [
  ...(analyzedRepos !== null
    ? [
        {
          key: "repos",
          label: "Repos analyzed",
          value: nf.format(analyzedRepos),
        },
      ]
    : []),
  { key: "health", label: "Health charts", value: String(healthChartCount) },
  {
    key: "embeds",
    label: "Embeddable assets",
    value: String(embedAssetCount),
  },
];

const countsLine = [
  ...(analyzedRepos !== null
    ? [`${nf.format(analyzedRepos)} repositories analyzed`]
    : []),
  `${healthChartCount} health charts`,
  `${embedAssetCount} embeddable assets`,
].join(" · ");

const reportLayers = [
  {
    graphic: "stars" as const,
    title: "Star history",
    desc: "See when attention arrived. Compare launches by calendar date or from day zero in the comparison tool.",
    link: "/compare",
  },
  {
    graphic: "health" as const,
    title: "Repository health",
    desc: "Find file change frequency, fix-labelled changes, bus factor, contributor concentration, and recent TODO/FIXME movement.",
    link: "/facebook/react",
  },
  {
    graphic: "readme" as const,
    title: "README stats",
    desc: "Embed theme-aware SVG, PNG, WebP, and GIF charts that link back to the live report.",
    link: "/badges",
  },
];

// Fallback line-up for the health scorecard. Live platform activity
// replaces these client-side whenever it offers analyzed repositories, so
// this only has to be recognizable and reliably analyzed.
const healthShowcaseRepos = [
  "facebook/react",
  "vercel/next.js",
  "oven-sh/bun",
  "denoland/deno",
  "fastapi/fastapi",
];

const popularPairs = [
  ["facebook/react", "vuejs/vue"],
  ["denoland/deno", "oven-sh/bun"],
  ["django/django", "fastapi/fastapi"],
  ["gatsbyjs/gatsby", "vercel/next.js"],
].map((repos) => ({
  repos: [...repos].sort(),
  label: repos.map((repo) => repo.split("/")[1]).join(" vs "),
}));

const featuredCategorySlugs = [
  "frontend-frameworks",
  "build-tools",
  "ai-coding-tools",
  "sql-databases",
];
const featuredCategories = featuredCategorySlugs.flatMap((slug) => {
  const category = CATEGORIES.find((candidate) => candidate.slug === slug);
  return category ? [category] : [];
});
const landingWarmRepos = Array.from(
  new Set([
    ...healthShowcaseRepos,
    ...popularPairs.flatMap((pair) => pair.repos),
    ...featuredCategories.flatMap((category) => category.repos),
  ]),
);

/**
 * The activity board, in the MomentumBoard idiom: 30px rows, tabular numerals,
 * one grid template shared by the header and every row. The template lives here
 * rather than in the script so Tailwind sees it and so the two can never drift.
 * Mobile keeps repository, stars and +30d; the rest join at `sm`.
 */
const activityGrid =
  "grid grid-cols-[minmax(0,1fr)_4.5rem_4.5rem] sm:grid-cols-[minmax(0,1fr)_5rem_4rem_4.5rem_4rem_4.5rem_5rem]";
const activityHead =
  "px-2 py-1.5 font-mono text-[10px] tracking-[0.12em] text-muted-foreground/70 uppercase";
const activityRowClass = `${activityGrid} items-center border-b border-border/25 outline-none transition-colors duration-150 hover:bg-card/50 focus-visible:ring-2 focus-visible:ring-accent/30 focus-visible:ring-inset`;

/** The three cache states, quoted inline in the board's legend. */
const STATE_WORD = "text-foreground";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead />
    <Seo
      title={title}
      description={description}
      canonicalPath="/"
      ogImage={ogImage}
      jsonLd={jsonLd}
    />
  </head>
  <body>
    <div class="isolate flex min-h-dvh flex-col">
      <SiteHeader />

      <main id="main-content" class="flex-1 bg-background text-foreground">
        <section id="top" class="relative isolate overflow-hidden">
          <DitherField client:idle />
          <div class="mx-auto max-w-6xl px-6 py-14 sm:py-20 lg:py-24">
            <div class="grid gap-x-12 gap-y-10 lg:grid-cols-[minmax(0,1.08fr)_minmax(24rem,0.92fr)] lg:items-center">
              <div class="min-w-0">
                <p class="dither-chip reveal" style="--reveal-delay:0ms">
                  <span
                    class="size-1.5 shrink-0 rounded-full bg-[var(--swatch-green)]"
                    aria-hidden="true"></span>
                  Built from public GitHub data
                </p>
                <h1
                  class="reveal mt-6 max-w-[18ch] text-4xl tracking-tight text-balance sm:text-5xl lg:text-6xl"
                  style="--reveal-delay:90ms"
                >
                  Star history and repo health for any GitHub repo.
                </h1>
                <p
                  class:list={[
                    "reveal mt-5 leading-relaxed text-pretty text-muted-foreground",
                    LEAD,
                  ]}
                  style="--reveal-delay:180ms"
                >
                  One live report per repository: the star curve, where it was
                  read from, and what the commit history says about maintenance,
                  ownership, and repair load.
                </p>

                <div
                  id="lookup"
                  class="reveal mt-8 scroll-mt-24"
                  style="--reveal-delay:260ms"
                >
                  <LandingRepoLookup client:load />
                </div>

                <div class="reveal mt-8" style="--reveal-delay:300ms">
                  <StatStrip
                    items={heroStats}
                    aria-label="What gitdebt has analyzed"
                  />
                </div>
              </div>

              <SignalFlowGraphic client:load apiBase={apiBase} />
            </div>
          </div>
        </section>

        <div class="mx-auto max-w-6xl px-6">
          <section
            id="health"
            class="mt-16 scroll-mt-24 border-t border-border/60 pt-12"
          >
            <div class={SECTION_HEADER}>
              <h2 class={HEADING}>
                Stars say it’s popular. The commit history says if it’s healthy.
              </h2>
              <a href="#lookup" class={SECTION_ACTION}>
                score your repo
                <span
                  aria-hidden="true"
                  class="transition-transform duration-150 group-hover:translate-x-0.5 motion-reduce:transition-none"
                  >→</span
                >
              </a>
            </div>
            <p class:list={["mt-2", BODY, MEASURE]}>
              Four readings from a repository's own commit history: maintenance,
              ownership, repair load, and debt markers. Every number links back
              to the full report.
            </p>
            <div class="mt-6">
              <RepoHealthScorecard
                client:visible
                apiBase={apiBase}
                repos={healthShowcaseRepos}
              />
            </div>
          </section>

          <section
            id="live"
            class="mt-16 scroll-mt-24 border-t border-border/60 pt-12"
          >
            <div class={SECTION_HEADER}>
              <h2 class={HEADING}>What people are looking at right now</h2>
              <a href="/leaderboard" class={SECTION_ACTION}>
                leaderboard
                <span
                  aria-hidden="true"
                  class="transition-transform duration-150 group-hover:translate-x-0.5 motion-reduce:transition-none"
                  >→</span
                >
              </a>
            </div>
            <p class:list={["mt-2", BODY, MEASURE]}>
              The repositories opened most recently on gitdebt, with the star
              totals, growth, and history state it already has stored for each.
            </p>

            <div
              class="mt-8"
              data-activity
              data-api-base={apiBase}
              data-row-class={activityRowClass}
            >
              <div class:list={[activityGrid, "items-center border-b border-border"]}>
                <span class:list={[activityHead, "text-left"]}>Repository</span>
                <span class:list={[activityHead, "hidden text-right sm:block"]}>Viewed</span>
                <span class:list={[activityHead, "hidden text-right sm:block"]}>Views</span>
                <span class:list={[activityHead, "text-right"]}>Stars</span>
                <span class:list={[activityHead, "hidden text-right sm:block"]}>+7d</span>
                <span class:list={[activityHead, "text-right"]}>+30d</span>
                <span class:list={[activityHead, "hidden text-right sm:block"]}>State</span>
              </div>
              <ol data-activity-rows></ol>
              <p
                data-activity-status
                aria-live="polite"
                class:list={["px-2 py-4", CAPTION]}
              >
                Live activity needs JavaScript. The leaderboard is rendered
                statically.
              </p>
            </div>
            <p class:list={["mt-3 px-2", CAPTION, MEASURE]}>
              State reads gitdebt's own cache, never a judgement about the
              repository: <span class={STATE_WORD}>ready</span> means the star
              history and the health analysis are both stored,
              <span class={STATE_WORD}>analyzing</span> means health is still
              running, and <span class={STATE_WORD}>queued</span> means the star
              history is still being built.
            </p>
          </section>

          <section
            id="how-it-works"
            class="mt-16 scroll-mt-24 border-t border-border/60 pt-12"
          >
            <div class={SECTION_HEADER}>
              <h2 class={HEADING}>Popularity, momentum, and maintenance</h2>
              <a href="/facebook/react" class={SECTION_ACTION}>
                see a full report
                <span
                  aria-hidden="true"
                  class="transition-transform duration-150 group-hover:translate-x-0.5 motion-reduce:transition-none"
                  >→</span
                >
              </a>
            </div>

            <SeriesProvenance
              client:visible
              variant="explainer"
              className="mt-6"
            />

            <ul
              id="features"
              role="list"
              class="mt-8 grid scroll-mt-24 gap-x-12 gap-y-10 sm:grid-cols-3"
            >
              {reportLayers.map((layer) => (
                <li>
                  <a href={layer.link} class={TILE}>
                    <div
                      inert
                      class="flex h-24 items-center overflow-hidden opacity-80 transition-opacity duration-200 group-hover:opacity-100 motion-reduce:transition-none"
                    >
                      <ReportLayerGraphic client:visible kind={layer.graphic} />
                    </div>
                    <h3 class={TILE_TITLE}>{layer.title}</h3>
                    <p class={TILE_DESC}>{layer.desc}</p>
                  </a>
                </li>
              ))}
            </ul>
          </section>

          <section
            id="compare"
            class="mt-16 scroll-mt-24 border-t border-border/60 pt-12"
          >
            <div class={SECTION_HEADER}>
              <h2 class={HEADING}>Compare growth, not just totals</h2>
              <a href="/compare" class={SECTION_ACTION}>
                comparison builder
                <span
                  aria-hidden="true"
                  class="transition-transform duration-150 group-hover:translate-x-0.5 motion-reduce:transition-none"
                  >→</span
                >
              </a>
            </div>
            <p class:list={["mt-2", BODY, MEASURE]}>
              Put up to eight GitHub star histories on one chart. Switch
              between calendar time and equal-start growth.
            </p>

            <div class="mt-8 grid gap-x-12 gap-y-10 lg:grid-cols-[1.12fr_0.88fr] lg:items-start">
              <ComparisonModeGraphic client:idle />

              <div class="grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-1">
                <div>
                  <p class={EYEBROW}>Head to head</p>
                  <ul role="list" class="mt-3">
                    {popularPairs.map((pair) => (
                      <li>
                        <a
                          href={`/vs/${pair.repos[0]}/${pair.repos[1]}`}
                          data-warm-repos={pair.repos.join(",")}
                          class={ROW}
                        >
                          <span class="min-w-0 flex-1 truncate">{pair.label}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>

                <div>
                  <p class={EYEBROW}>Curated fields</p>
                  <ul role="list" class="mt-3">
                    {featuredCategories.map((category) => (
                      <li>
                        <a
                          href={`/compare/${category.slug}`}
                          data-warm-repos={category.repos.join(",")}
                          class={ROW}
                        >
                          <span class="min-w-0 flex-1 truncate">
                            {category.name}
                          </span>
                          <span class={ROW_BADGE}>{category.repos.length}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          </section>

          <section
            id="share"
            class="mt-16 scroll-mt-24 border-t border-border/60 pt-12"
          >
            <div class={SECTION_HEADER}>
              <h2 class={HEADING}>README stats, ready to paste</h2>
              <a href="/badges" class={SECTION_ACTION}>
                badge studio
                <span
                  aria-hidden="true"
                  class="transition-transform duration-150 group-hover:translate-x-0.5 motion-reduce:transition-none"
                  >→</span
                >
              </a>
            </div>
            <p class:list={["mt-2", BODY, MEASURE]}>
              Add star history, health cards, and badges to any GitHub README
              with a theme-aware <code class="font-mono text-[12px] text-foreground"
                >&lt;picture&gt;</code
              > snippet.
            </p>

            <div class="mt-8 grid gap-x-12 gap-y-10 lg:grid-cols-[1.08fr_0.92fr] lg:items-start">
              <ThemeEmbedPreview client:idle />

              <div>
                <p class={EYEBROW}>What you paste</p>
                <ul role="list" class:list={["mt-3 space-y-2", BODY]}>
                  <li>One snippet, light and dark variants behind it.</li>
                  <li>Cacheable image URLs; attribution stays on the link.</li>
                  <li>Static by default — animation is always explicit.</li>
                </ul>
              </div>
            </div>
          </section>
        </div>

        <section
          class="relative isolate mt-16 overflow-hidden border-t border-border/60"
        >
          <DitherField
            client:idle
            render="static"
            opacity={0.14}
            vignette={0.7}
            colors={["#12161f", "#1d2b45"]}
          />
          <div class="mx-auto flex max-w-6xl flex-col gap-6 px-6 py-10 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <h2 class={HEADING}>Look up any public repository</h2>
              <p class:list={["mt-2", BODY, MEASURE]}>{countsLine}</p>
            </div>
            <ButtonLink
              client:visible
              href="#lookup"
              variant="outline"
              size="lg"
              pulse
            >
              Analyze a repository
            </ButtonLink>
          </div>
        </section>

        <WarmRepos client:load apiBase={apiBase} repos={landingWarmRepos} />
      </main>

      <SiteFooter showExtensionLink={false} />
    </div>

    <script>
      type ActivityRepo = {
        repo: string;
        stars: number;
        views: number;
        viewed_at: string;
        history_ready: boolean;
        analysis_ready: boolean;
        gained_7d: number;
        gained_30d: number;
      };

      /** Matches MomentumBoard. A leaderboard's job is comparison, and
       *  comparison needs rows close enough to scan against one another. */
      const ROW_HEIGHT = 30;

      const NUMBER = new Intl.NumberFormat("en-US");
      const COMPACT = new Intl.NumberFormat("en", {
        notation: "compact",
        maximumFractionDigits: 1,
      });

      const NAME_CELL = "truncate px-2 text-[13px] text-foreground";
      const NUM_CELL =
        "px-2 text-right font-mono text-[11px] tabular-nums text-muted-foreground";
      const LEAD_CELL =
        "px-2 text-right font-mono text-[11px] tabular-nums text-foreground";
      const TEXT_CELL =
        "px-2 text-right font-mono text-[11px] text-muted-foreground";
      const AT_SM = "hidden sm:block";

      function ago(value: string): string {
        const stamp = new Date(value).getTime();
        if (!Number.isFinite(stamp)) return "—";
        const minutes = Math.max(0, Math.floor((Date.now() - stamp) / 60_000));
        if (minutes < 1) return "just now";
        if (minutes < 60) return `${minutes}m ago`;
        const hours = Math.floor(minutes / 60);
        if (hours < 24) return `${hours}h ago`;
        return `${Math.floor(hours / 24)}d ago`;
      }

      /** gitdebt's own cache state, never a judgement about the repository. */
      function stateOf(entry: ActivityRepo): string {
        if (!entry.history_ready) return "queued";
        return entry.analysis_ready ? "ready" : "analyzing";
      }

      function cell(text: string, className: string): HTMLSpanElement {
        const span = document.createElement("span");
        span.className = className;
        span.textContent = text;
        return span;
      }

      function rowFor(entry: ActivityRepo, rowClass: string): HTMLLIElement {
        const item = document.createElement("li");
        const link = document.createElement("a");
        link.href = `/${entry.repo}`;
        link.className = rowClass;
        link.style.height = `${ROW_HEIGHT}px`;
        // The visible row is a grid of columns whose headers are not associated
        // programmatically, so the link carries the whole reading itself.
        link.setAttribute(
          "aria-label",
          `${entry.repo}: viewed ${ago(entry.viewed_at)}, ` +
            `${NUMBER.format(entry.views)} report views, ` +
            `${NUMBER.format(entry.stars)} stars, ` +
            `${NUMBER.format(entry.gained_7d)} in the last 7 days, ` +
            `${NUMBER.format(entry.gained_30d)} in the last 30 days, ` +
            stateOf(entry),
        );
        link.append(
          cell(entry.repo, NAME_CELL),
          cell(ago(entry.viewed_at), `${AT_SM} ${NUM_CELL}`),
          cell(COMPACT.format(entry.views), `${AT_SM} ${NUM_CELL}`),
          cell(COMPACT.format(entry.stars), LEAD_CELL),
          cell(`+${COMPACT.format(entry.gained_7d)}`, `${AT_SM} ${NUM_CELL}`),
          cell(`+${COMPACT.format(entry.gained_30d)}`, NUM_CELL),
          cell(stateOf(entry), `${AT_SM} ${TEXT_CELL}`),
        );
        item.append(link);
        return item;
      }

      // One request for the whole board. The endpoint is Postgres-only and
      // caps itself at eight repositories, so the table is complete in a single
      // response and never needs a second round trip.
      function install(host: HTMLElement) {
        const list = host.querySelector<HTMLOListElement>(
          "[data-activity-rows]",
        );
        const status = host.querySelector<HTMLElement>("[data-activity-status]");
        if (!list || !status) return;
        const apiBase = host.dataset.apiBase ?? "";
        const rowClass = host.dataset.rowClass ?? "";
        status.textContent = "Loading recently viewed repositories…";

        fetch(`${apiBase}/api/activity.json`, {
          headers: { accept: "application/json" },
        })
          .then((response) => {
            if (!response.ok) throw new Error(`activity ${response.status}`);
            return response.json();
          })
          .then((body: { repos?: ActivityRepo[] } | null) => {
            const repos = Array.isArray(body?.repos) ? body.repos : [];
            if (repos.length === 0) {
              status.textContent =
                "No repository views recorded yet. Repos appear here when their reports are opened.";
              return;
            }
            const fragment = document.createDocumentFragment();
            for (const entry of repos) fragment.append(rowFor(entry, rowClass));
            list.replaceChildren(fragment);
            status.remove();
          })
          .catch(() => {
            status.textContent = "Live activity is temporarily unavailable.";
          });
      }

      for (const host of document.querySelectorAll<HTMLElement>(
        "[data-activity]",
      )) {
        install(host);
      }
    </script>
  </body>
</html>
