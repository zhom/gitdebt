{
  "extends": "astro/tsconfigs/strict",
  "contentMappers": [{ "package": "@astrojs/ts-content-mapper", "extensions": [".astro"] }],
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
