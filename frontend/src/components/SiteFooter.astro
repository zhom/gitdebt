---
import { CATEGORIES } from "@/data/categories";
import Brand from "@/components/Brand.astro";
import { FooterAsciiMark } from "@/components/FooterAsciiMark";
import PageInsightSection from "@/components/PageInsightSection.astro";
import logoSource from "../../../assets/gitdebt-logo.svg?raw";
import { pageInsightForPath } from "@/lib/signal-art";

interface Props {
  /** Optional page data makes the route-specific signal field quantitative. */
  signalValues?: number[];
  /** Landing pages may hide products that are not ready to publish. */
  showExtensionLink?: boolean;
}

const year = new Date().getFullYear();
const { signalValues, showExtensionLink = true } = Astro.props;
const routeInsight = pageInsightForPath(Astro.url.pathname);
const pageInsight = signalValues?.some(Number.isFinite)
  ? { ...routeInsight, values: signalValues }
  : routeInsight;

const robot = logoSource.match(/fill="url\(#gitdebt-dither\)"\s+d="([^"]+)"/);
if (!robot) {
  throw new Error("assets/gitdebt-logo.svg no longer exposes the robot path");
}
const ROBOT_PATH = robot[1];

const footerLinks = [
  { label: "How it works", href: "/#how-it-works" },
  { label: "Features", href: "/#features" },
  { label: "Compare repos", href: "/compare" },
  { label: "Repo leaderboard", href: "/leaderboard" },
  { label: "README badges", href: "/badges" },
  ...(showExtensionLink
    ? [{ label: "Browser extension", href: "/#extension" }]
    : []),
];

const categoryLinks = [
  ...CATEGORIES.slice(0, 6).map((c) => ({
    label: c.name,
    href: `/compare/${c.slug}`,
  })),
  { label: "All categories →", href: "/compare#categories" },
];

const legalLinks = [
  { label: "About", href: "/about" },
  { label: "Privacy", href: "/privacy" },
  { label: "Terms", href: "/terms" },
];
---

<footer class="relative isolate overflow-hidden border-t border-border/60">
  <div
    class="pointer-events-none absolute inset-0 -z-20 overflow-hidden bg-background"
    aria-hidden="true"
  >
    <div class="absolute inset-0 bg-linear-to-b from-background via-background to-card/55"></div>
    <div class="absolute -top-48 -left-40 size-96 rounded-full bg-[var(--swatch-blue)] opacity-[0.055] blur-3xl"></div>
    <div class="absolute -right-40 -bottom-56 size-[30rem] rounded-full bg-[var(--swatch-pink)] opacity-[0.045] blur-3xl"></div>
  </div>
  <FooterAsciiMark client:visible path={ROBOT_PATH} />
  <div class="relative mx-auto max-w-6xl px-4 pt-12 pb-14 sm:px-6 sm:pt-14 sm:pb-20">
    <div class="pb-12 sm:pb-14">
      <PageInsightSection insight={pageInsight} />
    </div>
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_auto] lg:gap-16">
      <div class="max-w-sm space-y-3">
        <a
          href="/"
          aria-label="gitdebt homepage"
          class="inline-flex min-h-10 items-center rounded-md outline-none focus-visible:ring-2 focus-visible:ring-accent/30 focus-visible:ring-offset-4 focus-visible:ring-offset-background"
        >
          <Brand markClass="size-7" />
        </a>
        <p class="text-[13px] leading-relaxed text-muted-foreground [text-wrap:pretty]">
          GitHub star history and repo-debt analytics. Chart any repo's star
          growth, overlay several at once, and embed it in your README.
        </p>
      </div>

      <div class="grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 sm:gap-x-12">
        <nav class="flex min-w-0 flex-col">
          <p class="mb-2 font-mono text-[10px] tracking-[0.25em] text-muted-foreground/70 uppercase">
            Explore
          </p>
          {
            footerLinks.map((link) => (
              <a
                href={link.href}
                class="-mx-2.5 flex min-h-10 items-center rounded-md px-2.5 text-[13px] text-muted-foreground outline-none transition-colors duration-150 hover:bg-card/60 hover:text-foreground focus-visible:ring-2 focus-visible:ring-accent/30"
              >
                {link.label}
              </a>
            ))
          }
        </nav>

        <nav class="flex min-w-0 flex-col">
          <p class="mb-2 font-mono text-[10px] tracking-[0.25em] text-muted-foreground/70 uppercase">
            Categories
          </p>
          {
            categoryLinks.map((link) => (
              <a
                href={link.href}
                class="-mx-2.5 flex min-h-10 items-center rounded-md px-2.5 text-[13px] text-muted-foreground outline-none transition-colors duration-150 hover:bg-card/60 hover:text-foreground focus-visible:ring-2 focus-visible:ring-accent/30"
              >
                {link.label}
              </a>
            ))
          }
        </nav>

        <nav class="col-span-2 flex min-w-0 flex-col sm:col-span-1">
          <p class="mb-2 font-mono text-[10px] tracking-[0.25em] text-muted-foreground/70 uppercase">
            Legal
          </p>
          {
            legalLinks.map((link) => (
              <a
                href={link.href}
                class="-mx-2.5 flex min-h-10 items-center rounded-md px-2.5 text-[13px] text-muted-foreground outline-none transition-colors duration-150 hover:bg-card/60 hover:text-foreground focus-visible:ring-2 focus-visible:ring-accent/30"
              >
                {link.label}
              </a>
            ))
          }
        </nav>
      </div>
    </div>

    <div
      class="mt-10 flex flex-col gap-2 border-t border-border/60 pt-6 font-mono text-[10px] tracking-[0.25em] text-muted-foreground/70 uppercase sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© <span class="tabular-nums">{year}</span> gitdebt</p>
      <p>Not affiliated with GitHub</p>
    </div>
  </div>
</footer>
