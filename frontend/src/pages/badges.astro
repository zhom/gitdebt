---
export const prerender = true;

import Sheet from "@/layouts/Sheet.astro";
import { AgentReadmePrompt } from "@/components/AgentReadmePrompt";
import { EmbedCatalog } from "@/components/BadgeStudio";
import { ReportLayerGraphic } from "@/components/ReportLayerGraphic";
import {
  BODY,
  BREADCRUMB,
  CAPTION,
  CRUMB,
  FIELD,
  HEADING,
  LEAD,
  MEASURE,
  SECTION_ACTION,
  SECTION_HEADER,
  TITLE,
} from "@/components/style-tokens";
import {
  loadBuildRepoSnapshot,
  type BuildAnalyzeResponse,
} from "@/lib/build-repo-snapshot";
import { provenanceReadmeBlock } from "@/lib/provenance-embed";
import {
  assetUrl,
  profileEmbedAssets,
  repoEmbedAssets,
  EMBED_RULES,
  QUERY_REFERENCE,
  type EmbedFormat,
} from "@/lib/readme-embeds";
import { staticApiBase } from "@/lib/static-api-base";

const apiBase = staticApiBase();

const site = (Astro.site ?? new URL("https://gitdebt.com")).href.replace(/\/$/, "");

/** The target every asset points at until a visitor types their own. */
const exampleSlug = "facebook/react";
const exampleLogin = exampleSlug.split("/")[0];

// One catalog, shared with the agent prompt and the Rust renderer behind
// `/api/md`. The page counts what it renders instead of asserting a number.
const repoAssets = repoEmbedAssets(exampleSlug);
const profileAssets = profileEmbedAssets(exampleLogin);
const allAssets = [...repoAssets, ...profileAssets];
const healthCount = repoAssets.filter((asset) => asset.group === "health").length;
const formatCount = new Set(allAssets.flatMap((asset) => asset.formats)).size;

// The provenance-stated README block is composed from a real analyze payload,
// so it can only be built for the default target. A failed or cold snapshot
// classifies as "source not established", which renders a disabled action —
// never a wrong claim, and never a failed build.
let exampleSnapshot: BuildAnalyzeResponse | null = null;
try {
  exampleSnapshot = (await loadBuildRepoSnapshot(exampleSlug)).data;
} catch {
  exampleSnapshot = null;
}
const provenance = provenanceReadmeBlock({
  apiBase,
  siteOrigin: site,
  slug: exampleSlug,
  snapshot: exampleSnapshot,
});

/** The two rules people get wrong, quoted from the shared list, not retyped. */
const PUBLISHED_RULES = EMBED_RULES.filter((rule) =>
  /^(?:Do not add cache-busting|Alt text is not optional)/.test(rule),
);

/**
 * The shared copy is written for a page and for a Markdown file, so it carries
 * backticks. Rendering them as `<code>` keeps one source of truth.
 */
function segments(text: string): { code: boolean; text: string }[] {
  return text
    .split(/(`[^`]+`)/g)
    .filter((part) => part.length > 0)
    .map((part) =>
      part.startsWith("`") && part.endsWith("`") && part.length > 2
        ? { code: true, text: part.slice(1, -1) }
        : { code: false, text: part },
    );
}

const MIME: Record<EmbedFormat, string> = {
  svg: "image/svg+xml",
  png: "image/png",
  webp: "image/webp",
  gif: "image/gif",
};

const title = "GitHub README badges and embeds · gitdebt";
const description = `Point ${allAssets.length} README embeds at your repository: metrics and signal badges, the star-history chart, repository and maintainer cards, and ${healthCount} health charts.`;
const ogImage = `${apiBase}/api/og.png`;

/** The sheet's own tally. Every figure is counted off the arrays it renders. */
const tally = [
  { field: "Assets", value: String(allAssets.length) },
  { field: "Health charts", value: String(healthCount) },
  { field: "Formats", value: String(formatCount) },
  { field: "Parameters", value: String(QUERY_REFERENCE.length) },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "@id": `${site}/badges#page`,
    name: "GitHub README badges and embeds",
    url: `${site}/badges`,
    description,
    isPartOf: {
      "@type": "WebSite",
      "@id": `${site}/#website`,
      name: "gitdebt",
      url: site,
    },
    // Generated from the same arrays that render the grids, so the markup
    // cannot describe an asset the page does not show.
    mainEntity: {
      "@type": "ItemList",
      "@id": `${site}/badges#embeds`,
      name: "gitdebt README embeds",
      numberOfItems: allAssets.length,
      itemListElement: allAssets.map((asset, index) => ({
        "@type": "ListItem",
        position: index + 1,
        item: {
          "@type": "ImageObject",
          name: asset.name,
          description: asset.purpose,
          contentUrl: assetUrl(apiBase, asset),
          encodingFormat: MIME[asset.formats[0]],
          isAccessibleForFree: true,
        },
      })),
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "@id": `${site}/badges#builder`,
    name: "gitdebt README badge builder",
    applicationCategory: "DeveloperApplication",
    operatingSystem: "Web",
    url: `${site}/badges`,
    isAccessibleForFree: true,
    offers: {
      "@type": "Offer",
      price: 0,
      priceCurrency: "USD",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "gitdebt",
        item: site,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "README badges",
        item: `${site}/badges`,
      },
    ],
  },
];
---

<Sheet
  title={title}
  description={description}
  canonicalPath="/badges"
  ogImage={ogImage}
  imageAlt="gitdebt GitHub README badge builder"
  jsonLd={jsonLd}
>
  {/* ── The title block, with the sheet's own tally beside it ────────────── */}
  <section class="registered border-b border-rule bg-paper">
    <div class="mx-auto w-full max-w-6xl px-6 pt-8 pb-14">
      <nav aria-label="Breadcrumb" class={BREADCRUMB}>
        <a href="/" class={CRUMB}>gitdebt</a>
        <span class="px-1.5 text-rule-strong" aria-hidden="true">/</span>
        <span class="text-ink">badges</span>
      </nav>

      <h1 class:list={["mt-6", TITLE]}>Everything you can embed in a README</h1>
      <p class:list={["mt-5", LEAD, MEASURE]}>
        Badges, the star-history chart, repository and maintainer cards, a
        social preview, and repository-health charts. Every asset is a plain
        image URL served from gitdebt's own database — no account, no token.
      </p>

      {/*
        The counts are the drawing's schedule of parts, so they are lettered as
        one: a field and its figure, each read off the array that renders it.
        The same four numbers used to run together in one mono sentence, where
        nothing said which figure belonged to which noun.
      */}
      <dl
        class="mt-10 grid grid-cols-2 gap-px border border-rule-strong bg-rule sm:grid-cols-4"
      >
        {
          tally.map((entry) => (
            <div class="bg-paper p-5">
              <dt class:list={[FIELD, "min-h-[1.5rem]"]}>{entry.field}</dt>
              <dd class="mt-2.5 font-draft text-[1.75rem] leading-none tabular-nums text-ink">
                {entry.value}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  {/* ── The catalog ──────────────────────────────────────────────────────── */}
  <section class="border-b border-rule bg-table">
    <div class="mx-auto w-full max-w-6xl px-6 py-16">
      <EmbedCatalog
        client:load
        apiBase={apiBase}
        siteOrigin={site}
        defaultSlug={exampleSlug}
        defaultProvenance={provenance?.snippet ?? null}
      />

      <noscript>
        <p class:list={["mt-6", BODY, MEASURE]}>
          Without JavaScript the catalog stays pointed at {exampleSlug} and the
          copy buttons are inert. Every snippet is still printed in full, and a
          published embed never needs JavaScript.
        </p>
      </noscript>
    </div>
  </section>

  {/* ── URL reference ────────────────────────────────────────────────────── */}
  <section
    id="reference"
    aria-labelledby="reference-title"
    class="scroll-mt-24 border-b border-rule bg-paper"
  >
    <div class="mx-auto w-full max-w-6xl px-6 py-16">
      <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-4">
        <div class="min-w-0">
          <h2 id="reference-title" class={HEADING}>URL reference</h2>
          <p class:list={["mt-3", BODY, MEASURE]}>
            Swap the owner and name in any URL; nothing else changes.
          </p>
        </div>
        <figure aria-hidden="true" class="hidden shrink-0 sm:block">
          <ReportLayerGraphic client:visible kind="readme" />
          <figcaption class:list={["mt-1.5 text-right", CAPTION]}>
            Illustrative — no repository values
          </figcaption>
        </figure>
      </div>

      <div class="mt-8 overflow-x-auto border border-rule-strong bg-paper">
        <table class="w-full min-w-[42rem] border-collapse text-left">
          <caption class="sr-only">
            Query parameters that change what an asset renders
          </caption>
          <thead>
            <tr class="border-b border-rule-strong">
              <th scope="col" class:list={[FIELD, "px-4 py-3"]}>Parameter</th>
              <th scope="col" class:list={[FIELD, "px-4 py-3"]}>Applies to</th>
              <th scope="col" class:list={[FIELD, "px-4 py-3"]}>Effect</th>
            </tr>
          </thead>
          <tbody>
            {
              QUERY_REFERENCE.map((row) => (
                <tr class="border-b border-rule last:border-0">
                  <td class="px-4 py-3 align-top font-mono text-[0.75rem] text-ink">
                    {row.param}
                  </td>
                  <td class:list={[CAPTION, "px-4 py-3 align-top"]}>
                    {row.applies}
                  </td>
                  <td class:list={[BODY, "px-4 py-3 align-top"]}>
                    {segments(row.effect).map((part) =>
                      part.code ? (
                        <code class="font-mono text-[0.8125rem] text-ink">
                          {part.text}
                        </code>
                      ) : (
                        part.text
                      ),
                    )}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <ul role="list" class="mt-8 grid gap-x-12 gap-y-4 sm:grid-cols-2">
        {
          PUBLISHED_RULES.map((rule) => (
            <li class:list={[BODY, MEASURE]}>
              {segments(rule).map((part) =>
                part.code ? (
                  <code class="font-mono text-[0.8125rem] text-ink">
                    {part.text}
                  </code>
                ) : (
                  part.text
                ),
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ── Let an agent do it ───────────────────────────────────────────────── */}
  <section id="agent" aria-labelledby="agent-title" class="scroll-mt-24 bg-table">
    <div class="mx-auto w-full max-w-6xl px-6 py-16">
      <div class={SECTION_HEADER}>
        <h2 id="agent-title" class={HEADING}>Let an agent do it</h2>
        <a href="/badges.md" class={SECTION_ACTION}>markdown for agents</a>
      </div>
      <p class:list={["mt-4", BODY, MEASURE]}>
        This prompt resolves your repository from its git remote, then adds the
        badge, the star-history chart, and the health charts that fit —
        replacing an existing star-history widget in place rather than stacking
        a second one under it.
      </p>
      <div class="mt-8">
        <AgentReadmePrompt
          client:visible
          apiBase={apiBase}
          siteOrigin={site}
          target={{ kind: "generic" }}
        />
      </div>
    </div>
  </section>
</Sheet>
