---
export const prerender = true;

import "@/styles/globals.css";
import BaseHead from "@/components/BaseHead.astro";
import Seo from "@/components/Seo.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { LiveRepoReport } from "@/components/LiveRepoReport";
import { staticApiBase } from "@/lib/static-api-base";

const apiBase = staticApiBase();

const title = "Page not found · gitdebt";
const description =
  "We couldn't find that repo or page. Search any GitHub owner/repo to chart its star history on gitdebt.";
const ogImage = `${apiBase}/api/og.png`;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead />
    <Seo
      title={title}
      description={description}
      canonicalPath="/404"
      ogImage={ogImage}
      noindex={true}
    />
    <meta name="gitdebt-route-fallback" content="missing-repo" />
  </head>
  <body>
    <div class="isolate flex min-h-dvh flex-col">
      <SiteHeader />

      <main id="main-content" class="mx-auto w-full max-w-7xl flex-1 px-6 py-12 sm:py-16 lg:px-10">
        <LiveRepoReport client:only="react" apiBase={apiBase} />
        <noscript>
          <div class="border-y border-border py-12 text-center">
            JavaScript is required to open a repository that has not been included in the static catalog yet.
          </div>
        </noscript>
      </main>

      <SiteFooter />
    </div>
  </body>
</html>
