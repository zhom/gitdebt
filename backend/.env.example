# Local development only. Copy to backend/.env; `scripts/db.sh up` starts
# the Postgres + Redis containers these defaults point at.

# Required
DATABASE_URL=postgres://gitdebt:gitdebt@localhost:5432/gitdebt
GITHUB_TOKEN=

# Redis: distributed HTTP rate limiting + cache invalidation for
# gitdebt-api. Debug builds fall back to in-process limiting when unset;
# release builds of gitdebt-api refuse to start without it.
REDIS_URL=redis://localhost:6390

# gitdebt-api's own public origin, scheme + host, no path. It is baked into
# the README embed URLs the Markdown surfaces (`/api/md/{path}` and the
# `/api/repos/{owner}/{repo}/report.md` alias) hand to coding agents, and
# those get pasted permanently into third-party repositories — a wrong value
# points somebody else's README at somebody else's API. Debug builds default
# to http://localhost:8787; release builds of gitdebt-api refuse to start
# without it rather than guess. Set it in the service environment before
# rolling out, or the api will not boot.
PUBLIC_API_BASE=http://localhost:8787

# Server. gitdebt-api serves HTTP on PORT (default 8787); gitdebt-worker
# serves only /health + /ready on PORT (default 8788).
BIND_LOCAL=1
RUST_LOG=info,gitdebt=debug

# Bare-clone storage (default ~/.cache/gitdebt/repos). The worker writes
# clones here; the api only reads package manifests from it and degrades
# gracefully when the path is missing or mounted read-only.
# REPOS_DIR=

# Optional knobs (defaults apply when unset). One API + one worker use 48
# Postgres pool slots at DB_POOL_MAX=24, leaving headroom for leader sessions
# under PostgreSQL's common 100-connection default:
#   DB_POOL_MAX, PORT, TRUSTED_PROXIES, METRICS_TOKEN
#   WORKER_COUNT, REPO_ANALYSIS_WORKERS, MAX_PENDING_ANALYSES,
#   MAX_PENDING_FETCHES, MAX_STARGAZER_PAGES, REPO_ANALYSIS_COMMIT_LIMIT,
#   REPO_ANALYSIS_FRESH_HOURS, REPO_LINE_COUNT_MAX_FILES,
#   REPO_LINE_COUNT_TIMEOUT_SECONDS, REPOS_QUOTA_BYTES,
#   REPOS_HIGH_WATERMARK_PCT
#
# GH Archive star acquisition (worker; optional in debug builds):
#   GH_ARCHIVE_ENABLED, GH_ARCHIVE_BIGQUERY_PROJECT,
#   GH_ARCHIVE_BIGQUERY_LOCATION, GH_ARCHIVE_SOURCE_TABLE,
#   GH_ARCHIVE_GOOGLE_CREDENTIALS_JSON, GH_ARCHIVE_MAX_BYTES_BILLED,
#   GH_ARCHIVE_BATCH_SIZE, GH_ARCHIVE_CONCURRENCY,
#   GH_ARCHIVE_HOURLY_LAG_MINUTES, GH_ARCHIVE_HOURLY_MAX_HOURS
#
# For fast first-deploy backfills, point GH_ARCHIVE_SOURCE_TABLE at a
# DATE(created_at)-partitioned, (github_repo_id, lower_repository)-clustered
# star-event mirror. Indexed sources default GH_ARCHIVE_MAX_RANGE_DAYS to
# 6000; direct public month tables remain calendar-month aligned.
#
# GitHub App OAuth (api; leave GITHUB_APP_CLIENT_ID unset to disable auth):
#   GITHUB_APP_CLIENT_ID, GITHUB_APP_CLIENT_SECRET, GITHUB_WEBHOOK_SECRET,
#   OAUTH_REDIRECT_URI, PUBLIC_FRONTEND_ORIGIN, SESSION_SECRET,
#   TOKEN_ENCRYPTION_KEY, COOKIE_SECURE
