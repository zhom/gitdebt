---
export const prerender = true;

import "@/styles/globals.css";
import BaseHead from "@/components/BaseHead.astro";
import Seo from "@/components/Seo.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { DitherField } from "@/components/DitherField";
import { LiveRepoReport } from "@/components/LiveRepoReport";
import { SeriesProvenance } from "@/components/SeriesProvenance";
import { BODY, MEASURE, PANEL_PADDED } from "@/components/style-tokens";
import { staticApiBase } from "@/lib/static-api-base";

const apiBase = staticApiBase();

// The Markdown representation an agent that landed here can always reach. The
// site prerenders none, so this route answers for any public repository —
// including the one whose missing static page brought the agent here.
const agentMarkdown = `${apiBase}/api/md/{owner}/{repo}`;

const title = "Page not found · gitdebt";
const description =
  "We couldn't find that repo or page. Search any GitHub owner/repo to chart its star history on gitdebt.";
const ogImage = `${apiBase}/api/og.png`;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead />
    <Seo
      title={title}
      description={description}
      canonicalPath="/404"
      ogImage={ogImage}
      noindex={true}
    />
    <meta name="gitdebt-route-fallback" content="missing-repo" />
    <meta name="gitdebt-agent-markdown" content={agentMarkdown} />
  </head>
  <body>
    <div class="isolate flex min-h-dvh flex-col">
      <SiteHeader />

      {
        /*
         * The same host treatment as /report, deliberately: both routes mount
         * the same island and must not drift. `main` keeps real layout height
         * and owns the field's box — `DitherField` measures its own canvas,
         * which is stretched to `inset-0` here.
         */
      }
      <main id="main-content" class="relative isolate flex-1 overflow-hidden">
        <DitherField
          client:idle
          opacity={0.12}
          vignette={0.7}
          colors={["#12161f", "#1d2b45"]}
        />
        <div class="mx-auto w-full max-w-6xl px-6 py-12">
          <LiveRepoReport client:only="react" apiBase={apiBase} />
          <noscript>
            <div class:list={[PANEL_PADDED, BODY, MEASURE]}>
              JavaScript is required to open a repository that has not been
              included in the static catalog yet. Without it, {agentMarkdown} returns
              the report as Markdown for any public repository, and queues the analysis
              when there is none yet.
            </div>
          </noscript>
          {
            /*
             * This route's most common real state is not "page missing" but "a
             * public repository that is not in the static catalog", where the
             * island renders the full report. The explainer covers the state
             * that is genuinely empty, and says what gitdebt reads without
             * claiming anything about a repository it has not read.
             */
          }
          <SeriesProvenance
            client:visible
            variant="explainer"
            className="mt-16 scroll-mt-24 border-t border-border/60 pt-12"
          />
        </div>
      </main>

      <SiteFooter />
    </div>
  </body>
</html>
